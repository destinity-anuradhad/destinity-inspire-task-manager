@model List<TaskTracker.Models.Team>
@using TaskTracker.Services
@{
    ViewData["Title"] = "Teams";
    var stats = ViewBag.Stats as List<TeamIndexStat> ?? [];
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Teams</h1>
            <p class="text-sm text-gray-500 mt-0.5">Manage teams and track performance</p>
        </div>
        <button onclick="document.getElementById('createModal').classList.remove('hidden')"
                class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white"
                style="background:#094f70;">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Team
        </button>
    </div>

    <!-- Summary cards -->
    @{
        var activeStats = stats.Where(s => s.Team.IsActive).ToList();
        var totalDone   = activeStats.Sum(s => s.Done);
        var totalTasks  = activeStats.Sum(s => s.Total);
        var overallPct  = totalTasks > 0 ? (int)Math.Round((double)totalDone / totalTasks * 100) : 0;
    }
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900">@stats.Count(s => s.Team.IsActive)</p>
            <p class="text-xs text-gray-500 mt-0.5">Active Teams</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900">@activeStats.Sum(s => s.MemberCount)</p>
            <p class="text-xs text-gray-500 mt-0.5">Total Members</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900">@totalTasks</p>
            <p class="text-xs text-gray-500 mt-0.5">Total Tasks</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
            <p class="text-2xl font-bold" style="color:#094f70;">@overallPct%</p>
            <p class="text-xs text-gray-500 mt-0.5">Overall Done</p>
        </div>
    </div>

    <!-- Team cards -->
    @if (!stats.Any())
    {
        <div class="text-center py-20 text-gray-400">
            <p class="text-sm">No teams yet. Create the first one.</p>
        </div>
    }
    else
    {
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var s in stats.OrderByDescending(s => s.Team.IsActive).ThenBy(s => s.Team.Name))
            {
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow @(!s.Team.IsActive ? "opacity-60" : "")">
                    <div class="h-1.5" style="background:@s.Team.Color;"></div>
                    <div class="p-5">

                        <!-- Name + status -->
                        <div class="flex items-start justify-between mb-1">
                            <h3 class="font-semibold text-gray-900">@s.Team.Name</h3>
                            @if (!s.Team.IsActive)
                            {
                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 flex-shrink-0">Inactive</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(s.Team.Description))
                        {
                            <p class="text-xs text-gray-400 mb-3 line-clamp-1">@s.Team.Description</p>
                        }

                        <!-- Member count -->
                        <p class="text-xs text-gray-400 flex items-center gap-1 mb-4">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            @s.MemberCount member@(s.MemberCount == 1 ? "" : "s")
                        </p>

                        <!-- Progress bar -->
                        <div class="mb-4">
                            <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                                <span>Completion</span>
                                <span class="font-semibold text-gray-700">@s.CompletePct%</span>
                            </div>
                            <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full rounded-full transition-all"
                                     style="width:@s.CompletePct%;background:@s.Team.Color;"></div>
                            </div>
                        </div>

                        <!-- Stats row -->
                        <div class="grid grid-cols-4 gap-1 mb-4 bg-gray-50 rounded-xl p-2.5">
                            <div class="text-center">
                                <p class="text-sm font-bold text-gray-900">@s.Total</p>
                                <p class="text-[10px] text-gray-400">Total</p>
                            </div>
                            <div class="text-center">
                                <p class="text-sm font-bold text-emerald-600">@s.Done</p>
                                <p class="text-[10px] text-gray-400">Done</p>
                            </div>
                            <div class="text-center">
                                <p class="text-sm font-bold text-blue-600">@s.Active</p>
                                <p class="text-[10px] text-gray-400">Active</p>
                            </div>
                            <div class="text-center">
                                <p class="text-sm font-bold @(s.Overdue > 0 ? "text-red-500" : "text-gray-400")">@s.Overdue</p>
                                <p class="text-[10px] text-gray-400">Overdue</p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex gap-2">
                            <a href="/Teams/Manage/@s.Team.Id"
                               class="flex-1 text-center py-2 rounded-lg text-xs font-semibold text-white transition-colors"
                               style="background:#094f70;">
                                Manage
                            </a>
                            <form method="post" action="/Teams/Switch" class="flex-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="teamId" value="@s.Team.Id"/>
                                <button type="submit"
                                        class="w-full py-2 rounded-lg text-xs font-semibold border border-gray-200 hover:border-[#094f70]/40 text-gray-600 hover:text-[#094f70] transition-colors">
                                    Switch To
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- Create Team Modal -->
<div id="createModal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900">New Team</h3>
            <button onclick="document.getElementById('createModal').classList.add('hidden')"
                    class="text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form method="post" action="/Teams/Create" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Team Name <span class="text-red-500">*</span></label>
                <input name="name" required placeholder="e.g. Backend Team"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Description</label>
                <input name="description" placeholder="Optional description"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Team Color</label>
                <div class="flex items-center gap-3">
                    <input type="color" name="color" value="#094f70"
                           class="w-10 h-10 rounded-lg border border-gray-200 cursor-pointer p-0.5"/>
                    <span class="text-xs text-gray-400">Choose a brand color for this team</span>
                </div>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="document.getElementById('createModal').classList.add('hidden')"
                        class="flex-1 py-2.5 rounded-lg text-sm font-medium border border-gray-200 text-gray-600 hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-2.5 rounded-lg text-sm font-semibold text-white"
                        style="background:#094f70;">
                    Create Team
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('createModal').classList.add('hidden');
});
</script>
