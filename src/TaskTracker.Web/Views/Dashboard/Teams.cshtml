@using TaskTracker.Services
@{
    ViewData["Title"] = "All Teams";
    var stats = ViewBag.TeamStats as List<TeamStat> ?? [];
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-xl font-bold text-gray-900">All Teams</h1>
        <p class="text-sm text-gray-500 mt-0.5">Performance overview across all active teams</p>
    </div>
    <a href="/Teams" class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white"
       style="background:#094f70;">
        Manage Teams
    </a>
</div>

<!-- Summary cards -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-gray-900">@stats.Count</p>
        <p class="text-xs text-gray-500 mt-0.5">Active Teams</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-gray-900">@stats.Sum(s => s.MemberCount)</p>
        <p class="text-xs text-gray-500 mt-0.5">Total Members</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-gray-900">@stats.Sum(s => s.Total)</p>
        <p class="text-xs text-gray-500 mt-0.5">Total Tasks</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-[#094f70]">@(stats.Sum(s => s.Total) > 0 ? (int)Math.Round((double)stats.Sum(s => s.Done) / stats.Sum(s => s.Total) * 100) : 0)%</p>
        <p class="text-xs text-gray-500 mt-0.5">Overall Done</p>
    </div>
</div>

<!-- Team cards grid -->
@if (!stats.Any())
{
    <div class="text-center py-20 text-gray-400 text-sm">No active teams found.</div>
}
else
{
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var s in stats)
        {
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                <div class="h-1.5" style="background:@s.Team.Color;"></div>
                <div class="p-5">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl flex-shrink-0" style="background:@s.Team.Color;opacity:0.15;"></div>
                            <div class="absolute">
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:@s.Team.Color;">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="ml-13 pl-13">
                                <h3 class="font-semibold text-gray-900 text-sm">@s.Team.Name</h3>
                                <p class="text-xs text-gray-400">@s.MemberCount member@(s.MemberCount == 1 ? "" : "s")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Progress bar -->
                    <div class="mb-4">
                        <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                            <span>Completion</span>
                            <span class="font-semibold text-gray-700">@s.CompletePct%</span>
                        </div>
                        <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all"
                                 style="width:@s.CompletePct%;background:@s.Team.Color;"></div>
                        </div>
                    </div>

                    <!-- Stats row -->
                    <div class="grid grid-cols-4 gap-2 mb-4">
                        <div class="text-center">
                            <p class="text-base font-bold text-gray-900">@s.Total</p>
                            <p class="text-[10px] text-gray-400 leading-tight">Total</p>
                        </div>
                        <div class="text-center">
                            <p class="text-base font-bold text-emerald-600">@s.Done</p>
                            <p class="text-[10px] text-gray-400 leading-tight">Done</p>
                        </div>
                        <div class="text-center">
                            <p class="text-base font-bold text-blue-600">@s.Active</p>
                            <p class="text-[10px] text-gray-400 leading-tight">Active</p>
                        </div>
                        <div class="text-center">
                            <p class="text-base font-bold @(s.Overdue > 0 ? "text-red-500" : "text-gray-400")">@s.Overdue</p>
                            <p class="text-[10px] text-gray-400 leading-tight">Overdue</p>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-2">
                        <form method="post" action="/Teams/Switch" class="flex-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="teamId" value="@s.Team.Id"/>
                            <button type="submit"
                                    class="w-full py-2 rounded-lg text-xs font-semibold text-white transition-colors"
                                    style="background:@s.Team.Color;">
                                Switch To
                            </button>
                        </form>
                        <a href="/Teams/Manage/@s.Team.Id"
                           class="flex-1 text-center py-2 rounded-lg text-xs font-semibold border border-gray-200 text-gray-600 hover:border-gray-300 hover:bg-gray-50 transition-colors">
                            Manage
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
