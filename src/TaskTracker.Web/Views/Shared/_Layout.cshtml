<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " – " : "")Team Destinity Inspire</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/destinity-inspire.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,400&display=swap"
          onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,400&display=swap" />
    </noscript>
    <environment include="Development">
        <script src="https://cdn.tailwindcss.com"></script>
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    </environment>
    <link rel="stylesheet" href="/css/brand.css" />
    <script src="/js/tt-select.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"
            integrity="sha384-YB/DdIkloKoRpclWB8bNcYXWakt57USgtQPDzvnIDHYU0lasD5eWlXVo1S4ODukY"
            crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha384-mU1xC5yC2LldSW74Rj1Ax8wPiLw/28V5eh51uKJMlBbRVsOtUYd4xyzNsgIAJARB"
            crossorigin="anonymous"></script>
    <style>
        /* SweetAlert2 brand overrides */
        .swal2-popup { font-family: 'Inter', sans-serif !important; border-radius: 1rem !important; }
        .swal2-title  { font-size: 1.05rem !important; font-weight: 700 !important; color: #0f172a !important; }
        .swal2-html-container { font-size: .875rem !important; color: #475569 !important; }
        .swal2-toast  { border-radius: .875rem !important; font-family: 'Inter', sans-serif !important; }
        .swal2-toast .swal2-title { font-size: .875rem !important; font-weight: 500 !important; color: #0f172a !important; }
        .swal2-toast.swal2-popup { padding: .6rem 1rem !important; }
        .swal2-confirm { font-family: 'Inter', sans-serif !important; font-weight: 600 !important; border-radius: .5rem !important; }
        .swal2-cancel  { font-family: 'Inter', sans-serif !important; font-weight: 500 !important; border-radius: .5rem !important; }
    </style>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- ── Top Navigation ─────────────────────────────────────────── -->
    <nav class="nav-brand shadow-md sticky top-0 z-40">
        <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- Brand -->
                <a href="/Dashboard" class="flex items-center gap-3 flex-shrink-0">
                    <img src="/assets/img/destinity-inspire.svg" alt="Destinity Inspire"
                         class="h-9 w-auto" onerror="this.style.display='none'" />
                    <div class="hidden sm:block">
                        <span class="font-bold text-white text-sm leading-none tracking-tight">Team Destinity Inspire</span>
                        <span class="text-white/45 text-[10px] block leading-none mt-0.5 font-medium tracking-wide uppercase">Task Tracker</span>
                    </div>
                </a>

                <!-- Nav Links -->
                @{
                    var activeNav      = ViewData["ActiveNav"] as string ?? "";
                    var displayName    = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
                    var imgPath        = User.FindFirst("ProfileImagePath")?.Value ?? "";
                    var navInitials    = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
                    var navColor       = User.FindFirst("AvatarColor")?.Value ?? "#3b82f6";
                    var activeTeamName = User.FindFirst("ActiveTeamName")?.Value ?? "";
                    var activeTeamClr  = User.FindFirst("ActiveTeamColor")?.Value ?? "#094f70";
                    var teamRole       = User.FindFirst("TeamRole")?.Value ?? "";
                    var isTeamLead     = teamRole is "TeamAdmin" or "TeamLead" || User.IsInRole("Admin");
                    var isTeamAdmin    = teamRole == "TeamAdmin" || User.IsInRole("Admin");
                }
                <!-- Team switcher dropdown (nav-style) -->
                @if (!string.IsNullOrEmpty(activeTeamName) || User.IsInRole("Admin"))
                {
                    var activeTeamIdStr = User.FindFirst("ActiveTeamId")?.Value ?? "";
                    var isGlobal        = string.IsNullOrEmpty(activeTeamName);
                    <div class="relative" id="teamSwitchWrap">
                        <button onclick="toggleTeamMenu()" id="teamSwitchBtn"
                                aria-haspopup="true" aria-expanded="false"
                                class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all nav-link-idle">
                            @if (isGlobal)
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>Global View</span>
                            }
                            else
                            {
                                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:@activeTeamClr;"></span>
                                <span class="truncate max-w-[110px]">@activeTeamName</span>
                            }
                            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="teamSwitchDropdown"
                             class="hidden absolute left-0 top-full mt-2 w-52 bg-white rounded-xl shadow-2xl border border-gray-100 z-50 py-1 overflow-hidden">
                            <div id="teamSwitchList" class="flex flex-col">
                                <div class="px-4 py-3 text-xs text-gray-400 text-center">Loading…</div>
                            </div>
                            @if (isTeamAdmin && !string.IsNullOrEmpty(activeTeamIdStr))
                            {
                                <div class="border-t border-gray-100 mt-1 pt-1">
                                    <a href="/Teams/Manage/@activeTeamIdStr"
                                       class="flex items-center gap-2.5 px-4 py-2 text-xs text-gray-500 hover:bg-gray-50 transition-colors">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </svg>
                                        Team Settings
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="flex items-center gap-0.5">
                    <div class="relative" id="dashMenuWrap">
                        <button onclick="toggleDashMenu()"
                                aria-haspopup="true" aria-expanded="false" id="dashMenuBtn"
                                class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav is "Dashboard" or "Team" ? "nav-link-active" : "nav-link-idle")">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            Dashboard
                            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="dashMenuDropdown"
                             class="hidden absolute left-0 top-full mt-2 w-44 bg-white rounded-xl shadow-2xl border border-gray-100 z-50 py-1 overflow-hidden">
                            <a href="/Dashboard"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Dashboard" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                </svg>
                                My Dashboard
                            </a>
                            <a href="/Dashboard/Team"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Team" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                                </svg>
                                Team Dashboard
                            </a>
                        </div>
                    </div>
                    <a href="/Tasks"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Tasks" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        Tasks
                    </a>
                    <a href="/Projects"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Projects" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h5l2 2h11v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                        </svg>
                        Projects
                    </a>
                    <a href="/Templates"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Templates" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
                        Templates
                    </a>
                    <a href="/Recurrence"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Recurrence" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Recurring
                    </a>
                    @if (User.IsInRole("Admin") || isTeamLead)
                    {
                    <a href="/Sprints"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Sprints" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                        Sprints
                    </a>
                    }
                    @if (User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value == "TeamAdmin")
                    {
                    <div class="relative" id="adminMenuWrap">
                        <button onclick="toggleAdminMenu()"
                                aria-haspopup="true" aria-expanded="false" id="adminMenuBtn"
                                class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav is "Teams" or "Master" ? "nav-link-active" : "nav-link-idle")">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            Admin
                            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="adminMenuDropdown"
                             class="hidden absolute left-0 top-full mt-2 w-44 bg-white rounded-xl shadow-2xl border border-gray-100 z-50 py-1 overflow-hidden">
                            @if (User.IsInRole("Admin"))
                            {
                            <a href="/Teams"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Teams" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                Teams
                            </a>
                            <a href="/Master"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Master" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                Master Files
                            </a>
                            }
                            <a href="/ApiClients"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "ApiKeys" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                                </svg>
                                API Keys
                            </a>
                            <a href="/Webhooks"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Webhooks" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M14 10l-2 2m0 0l-2 2m2-2l2 2m-2-2l-2-2m9 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Webhooks
                            </a>
                            <a href="/Import"
                               class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors @(activeNav == "Import" ? "font-semibold text-[#094f70]" : "")">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                </svg>
                                Import
                            </a>
                        </div>
                    </div>
                    }
                    <a href="/Charts"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Charts" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Charts
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                    <a href="/Activity"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Activity" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Activity
                    </a>
                    }
                    <a href="/Queries"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Queries" ? "nav-link-active" : "nav-link-idle")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                        </svg>
                        Queries
                    </a>
                    @if (User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value == "TeamAdmin")
                    {
                    <a href="/Tasks/RecycleBin"
                       class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(activeNav == "Recycle" ? "nav-link-active" : "nav-link-idle")"
                       title="Recycle Bin">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Bin
                    </a>
