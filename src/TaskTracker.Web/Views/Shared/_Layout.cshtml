                            <span class="text-sm font-medium text-white/90 hidden sm:block">@displayName</span>
                            <svg class="w-3.5 h-3.5 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="userMenuDropdown"
                             class="hidden absolute right-0 top-full mt-2 w-48 bg-white rounded-xl shadow-2xl border border-gray-100 z-50 py-1 overflow-hidden">
                            <div class="px-4 py-3 border-b border-gray-100">
                                <p class="text-xs font-semibold text-gray-900 truncate">@displayName</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">@(User.IsInRole("Admin") ? "Administrator" : "Member")</p>
                            </div>
                            <a href="/Profile/Index"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                My Profile
                            </a>
                            <div class="border-t border-gray-100 my-1"></div>
                            <form method="post" action="/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="w-full flex items-center gap-2 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                    </svg>
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </nav>

    <!-- ── Main Content ──────────────────────────────────────────── -->
    <main class="flex-1 max-w-screen-2xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
        @RenderBody()
    </main>

    <!-- ── Footer ────────────────────────────────────────────────── -->
    <footer class="mt-auto border-t border-white/60" style="background:rgba(255,255,255,0.7);backdrop-filter:blur(8px)">
        <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <img src="/assets/img/destinity-inspire.svg" alt="" class="h-4 w-auto opacity-40"
                     onerror="this.style.display='none'" />
                <p class="text-[11px] text-gray-400 font-medium">Team Destinity Inspire &copy; 2026</p>
            </div>
            <p class="text-[10px] text-gray-300 font-medium tracking-wide uppercase">Scienter PMS</p>
        </div>
    </footer>

    @{
        var _tMsgs = new System.Collections.Generic.List<(string Msg, string Type)>();
        string? _tv;
        _tv = TempData["ProfileSuccess"]  as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"success"));
        _tv = TempData["PasswordSuccess"] as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"success"));
        _tv = TempData["NotifSuccess"]    as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"success"));
        _tv = TempData["WorkPrefSuccess"] as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"success"));
        _tv = TempData["ProfileError"]    as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"error"));
        _tv = TempData["PasswordError"]   as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"error"));
        _tv = TempData["Error"]           as string; if (!string.IsNullOrEmpty(_tv)) _tMsgs.Add((_tv,"error"));
        var _tdJs = new System.Text.StringBuilder();
        foreach (var _tm in _tMsgs)
            _tdJs.Append($"showToast({System.Text.Json.JsonSerializer.Serialize(_tm.Msg)},'{_tm.Type}');");
    }

    @* ── SweetAlert2 Toast + Confirm helpers (defined BEFORE @RenderSectionAsync) ── *@
    <script>
    // ── showToast — wraps Swal toast; errors are persistent (no auto-dismiss) ──
    function showToast(msg, type, dur) {
        if (!msg) return;
        type = type || 'info';
        const isError = type === 'error';
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            title: msg,
            showConfirmButton: isError,
            confirmButtonText: 'Dismiss',
            timer: isError ? undefined : (dur || 4000),
            timerProgressBar: !isError,
            showCloseButton: true,
            customClass: { popup: 'swal2-toast' },
        });
    }

    // ── CSRF helpers ───────────────────────────────────────────────────────────
    function getCsrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
    function csrfBody(extra) {
        const params = new URLSearchParams({ __RequestVerificationToken: getCsrfToken() });
        if (extra) Object.entries(extra).forEach(([k,v]) => params.append(k, v));
        return params.toString();
    }

    // ── swalDelete — confirm before a form-POST delete ────────────────────────
    function swalDelete(form, name) {
        Swal.fire({
            title: 'Delete ' + (name ? '“' + name + '”' : 'this item') + '?',
            text: 'This action cannot be undone.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#94a3b8',
            confirmButtonText: 'Yes, delete',
            cancelButtonText: 'Cancel',
            reverseButtons: true,
            focusCancel: true,
        }).then(function(r) { if (r.isConfirmed) form.submit(); });
    }

    // ── TempData + sessionStorage toasts — deferred until Swal is ready ────────
    // SweetAlert2 loads with `defer`, so it isn't available during inline script
    // execution. DOMContentLoaded fires after all deferred scripts have run.
    document.addEventListener('DOMContentLoaded', function() {
        @Html.Raw(_tdJs.ToString())
        try {
            var pt = sessionStorage.getItem('__toast');
            if (pt) {
                sessionStorage.removeItem('__toast');
                var d = JSON.parse(pt);
                showToast(d.msg, d.type || 'info', d.dur || 4000);
            }
        } catch(e) {}
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
    // ── Notification bell ──────────────────────────────────
    let notifOpen = false;
    async function toggleNotif() {
        notifOpen = !notifOpen;
        document.getElementById('notifDropdown').classList.toggle('hidden', !notifOpen);
        document.getElementById('notifBtn').setAttribute('aria-expanded', notifOpen ? 'true' : 'false');
        if (notifOpen) {
            const r = await fetch('/Account/NotificationList');
            document.getElementById('notifList').innerHTML = await r.text();
            loadNotifCount();
        }
    }
    async function markOneRead(id, e) {
        await fetch('/Account/MarkRead?id=' + id, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: csrfBody()
        });
        loadNotifCount();
    }
    async function markAllRead() {
        await fetch('/Account/MarkAllRead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: csrfBody()
        });
        document.getElementById('notifBadge').classList.add('hidden');
        const r = await fetch('/Account/NotificationList');
        document.getElementById('notifList').innerHTML = await r.text();
    }
    async function loadNotifCount() {
        try {
            const r = await fetch('/Account/NotificationCount');
            const j = await r.json();
            const b = document.getElementById('notifBadge');
            if (j.count > 0) {
                b.textContent = j.count > 99 ? '99+' : j.count;
                b.classList.remove('hidden');
            } else {
                b.classList.add('hidden');
            }
        } catch {}
    }
    loadNotifCount();
    setInterval(loadNotifCount, 300000); // 5-min fallback; SignalR NewNotification updates badge instantly

    // ── User menu ──────────────────────────────────────────
    function toggleUserMenu() {
        document.getElementById('userMenuDropdown').classList.toggle('hidden');
    }
    // ── Admin menu ─────────────────────────────────────────
    function toggleAdminMenu() {
        const dd = document.getElementById('adminMenuDropdown');
        if (dd) dd.classList.toggle('hidden');
    }
    // ── Dashboard menu ─────────────────────────────────────
    function toggleDashMenu() {
        const dd = document.getElementById('dashMenuDropdown');
        if (dd) dd.classList.toggle('hidden');
    }
    // ── Team switcher ───────────────────────────────────────
    let _teamMenuLoaded = false;
    async function toggleTeamMenu() {
        const dd = document.getElementById('teamSwitchDropdown');
        if (!dd) return;
        const opening = dd.classList.toggle('hidden');
        if (!opening && !_teamMenuLoaded) {
            _teamMenuLoaded = true;
            try {
                const res  = await fetch('/Teams/MyTeamsJson');
                const data = await res.json();
                const returnUrl = encodeURIComponent(location.pathname + location.search);
                const csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                let html = '';
                if (data.isSysAdmin) {
                    html += `<form method="post" action="/Teams/SwitchGlobal?returnUrl=${returnUrl}">
                        <input type="hidden" name="__RequestVerificationToken" value="${csrf}">
                        <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors text-left">
                            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Global View
                        </button></form>`;
                    if (data.teams.length) html += '<div class="border-t border-gray-100 my-1"></div>';
                }
                html += data.teams.map(t =>
                    `<form method="post" action="/Teams/Switch?returnUrl=${returnUrl}">
                        <input type="hidden" name="__RequestVerificationToken" value="${csrf}">
                        <input type="hidden" name="teamId" value="${t.id}">
                        <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors text-left">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background:${t.color}"></span>
                            <span class="truncate">${t.name}</span>
                        </button></form>`
                ).join('');
                if (!html) html = '<div class="px-4 py-3 text-xs text-gray-400">No teams available</div>';
                document.getElementById('teamSwitchList').innerHTML = html;
            } catch { document.getElementById('teamSwitchList').innerHTML = '<div class="px-4 py-3 text-xs text-red-500">Failed to load</div>'; }
        }
    }
    document.addEventListener('click', e => {
        if (!e.target.closest('#notifWrap')) {
            document.getElementById('notifDropdown').classList.add('hidden');
            notifOpen = false;
        }
        if (!e.target.closest('#userMenuWrap')) {
            document.getElementById('userMenuDropdown').classList.add('hidden');
        }
        const adminDd = document.getElementById('adminMenuDropdown');
        if (adminDd && !e.target.closest('#adminMenuWrap')) adminDd.classList.add('hidden');
        const dashDd = document.getElementById('dashMenuDropdown');
        if (dashDd && !e.target.closest('#dashMenuWrap')) dashDd.classList.add('hidden');
        const teamDd = document.getElementById('teamSwitchDropdown');
        if (teamDd && !e.target.closest('#teamSwitchWrap')) teamDd.classList.add('hidden');
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.getElementById('notifDropdown').classList.add('hidden');
            document.getElementById('userMenuDropdown').classList.add('hidden');
            const adminDd = document.getElementById('adminMenuDropdown');
            if (adminDd) adminDd.classList.add('hidden');
            const dashDd = document.getElementById('dashMenuDropdown');
            if (dashDd) dashDd.classList.add('hidden');
            const teamDd = document.getElementById('teamSwitchDropdown');
            if (teamDd) teamDd.classList.add('hidden');
            notifOpen = false;
        }
    });
    </script>

    <script>
    // ── SignalR connection ─────────────────────────────────────────────────────
    const _srConn = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/tasks')
        .withAutomaticReconnect()
        .configureLogging(signalR.LogLevel.Warning)
        .build();

    // Global handlers — views can override window.onTaskUpdated / onCommentAdded / onLinkUpdated
    _srConn.on('NewNotification', () => loadNotifCount());
    _srConn.on('TaskUpdated', data => {
        if (typeof window.onTaskUpdated === 'function') window.onTaskUpdated(data);
        // Toast only if someone else changed it
        if (data.updatedBy && data.updatedBy !== (typeof CV_ME !== 'undefined' ? CV_ME : ''))
            showToast(`#${data.id} updated by ${data.updatedBy}`, 'info');
    });
    _srConn.on('CommentAdded', taskId => {
        if (typeof window.onCommentAdded === 'function') window.onCommentAdded(taskId);
    });
    _srConn.on('LinkUpdated', taskId => {
        if (typeof window.onLinkUpdated === 'function') window.onLinkUpdated(taskId);
    });

    async function srJoinTask(taskId) {
        if (_srConn.state === signalR.HubConnectionState.Connected)
            await _srConn.invoke('JoinTask', String(taskId));
    }
    async function srLeaveTask(taskId) {
        if (_srConn.state === signalR.HubConnectionState.Connected)
            await _srConn.invoke('LeaveTask', String(taskId));
    }

    _srConn.start().catch(e => console.warn('SignalR:', e));
    // ──────────────────────────────────────────────────────────────────────────
    </script>
</body>
</html>
