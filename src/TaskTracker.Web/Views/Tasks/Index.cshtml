    </div>

    <!-- ── Filter Toggle ── -->
    <div class="flex items-center">
        <button id="filter-toggle-btn" onclick="toggleFilterBar()"
                class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-blue-600 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/></svg>
            <span id="filter-toggle-label">Show filters</span>
        </button>
    </div>

    <!-- ── Filter Bar ── -->
    <div id="filter-bar-wrap" class="hidden">
    <form method="get" action="/Tasks" class="bg-white border border-gray-200 rounded-xl p-3 flex flex-wrap gap-2 items-end">
        <input type="hidden" name="view"     value="@Model.ViewMode" />
        <input type="hidden" name="sort"     value="@Model.Sort" />
        <input type="hidden" name="sortDir"  value="@Model.SortDir" />
        <input type="hidden" name="calYear"  value="@Model.CalYear" />
        <input type="hidden" name="calMonth" value="@Model.CalMonth" />
        <div class="min-w-52">
            <label for="filter-search" class="block text-xs font-medium text-gray-500 mb-1">Search</label>
            <div class="relative">
                <svg class="w-4 h-4 text-gray-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
                <input id="filter-search" type="text" name="search" value="@Model.Search" placeholder="Title, client, module, label…"
                       class="w-full border border-gray-200 rounded-lg pl-8 pr-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>
        <div class="min-w-36">
            <label for="filter-project" class="block text-xs font-medium text-gray-500 mb-1">Module</label>
            <select id="filter-project" name="project" data-searchable
                    onchange="onFilterModuleChange(this)"
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">— Loading… —</option>
            </select>
        </div>
        <div class="min-w-36">
            <label for="filter-property" class="block text-xs font-medium text-gray-500 mb-1">Client</label>
            <select id="filter-property" name="property" data-searchable
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">— Loading… —</option>
            </select>
        </div>
        @* Marker so the controller can tell "form submitted with no assignee (everyone)" from a fresh view (my tasks). *@
        <input type="hidden" name="ownerFilterSet" value="1" />
        <div class="min-w-36">
            <label for="filter-owner" class="block text-xs font-medium text-gray-500 mb-1">Assignee</label>
            <select id="filter-owner" name="owner" multiple data-searchable data-placeholder="All assignees"
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                @foreach (var o in Model.Owners)
                {
                    <option value="@o.Name" selected="@(ownerSel.Contains(o.Name) ? "selected" : null)">@o.Name</option>
                }
            </select>
        </div>
        <div class="min-w-32">
            <label class="block text-xs font-medium text-gray-500 mb-1">Status</label>
            <select name="status" multiple data-searchable data-placeholder="All Status"
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                @foreach (var ws in Model.WorkStates)
                {
                    <option value="@ws.Name" selected="@(statusSel.Contains(ws.Name) ? "selected" : null)">@ws.Name</option>
                }
            </select>
        </div>
        <div class="min-w-28">
            <label class="block text-xs font-medium text-gray-500 mb-1">Priority</label>
            <select name="priority" multiple data-searchable data-placeholder="All Priority"
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                @foreach (var p in TaskTracker.Models.ViewModels.TaskListViewModel.AllPriorities)
                {
                    <option value="@p" selected="@(prioSel.Contains(p) ? "selected" : null)">@p</option>
                }
            </select>
        </div>
        <div class="min-w-40">
            <label for="filter-sprint" class="block text-xs font-medium text-gray-500 mb-1">Sprint</label>
            <select id="filter-sprint" name="sprint" data-searchable
                    class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sprint) ? "selected" : null)">All sprints</option>
                <option value="__none__" selected="@(Model.Sprint == "__none__" ? "selected" : null)">Backlog (no sprint)</option>
                @foreach (var sp in (ViewBag.AllSprints as List<Sprint> ?? new List<Sprint>()))
                {
                    <option value="@sp.Id" selected="@(Model.Sprint == sp.Id.ToString() ? "selected" : null)">@sp.Name@(sp.IsActive ? " (active)" : "")</option>
                }
            </select>
        </div>
        <div class="min-w-36">
            <label class="block text-xs font-medium text-gray-500 mb-1">Due Date From</label>
            <input type="date" name="dateFrom" value="@Model.DateFrom"
                   class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="min-w-36">
            <label class="block text-xs font-medium text-gray-500 mb-1">Due Date To</label>
            <input type="date" name="dateTo" value="@Model.DateTo"
                   class="w-full border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="flex gap-2">
            <button type="submit" class="btn-primary text-sm font-medium px-4 py-1.5 rounded-lg">Filter</button>
            <a href="@resetUrl"
               class="inline-flex items-center gap-1.5 border border-gray-200 bg-white hover:bg-gray-50 text-gray-600 text-sm font-medium px-3 py-1.5 rounded-lg transition-colors"
               title="Clear all filters">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Reset
            </a>
            <a href="@Url.Action("Index", new { owner=myDisplayName, search=Model.Search, project=Model.Project, property=Model.Property, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint, dateFrom=Model.DateFrom, dateTo=Model.DateTo, pageSize=Model.PageSize, view=Model.ViewMode, calYear=Model.CalYear, calMonth=Model.CalMonth })"
               class="@(Model.Owner == myDisplayName ? "bg-blue-50 text-blue-700 border border-blue-200" : "bg-gray-100 hover:bg-gray-200 text-gray-700") text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">My Tasks</a>
            <a href="@Url.Action("Index", new { owner="__all__", search=Model.Search, project=Model.Project, property=Model.Property, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint, dateFrom=Model.DateFrom, dateTo=Model.DateTo, pageSize=Model.PageSize, view=Model.ViewMode, calYear=Model.CalYear, calMonth=Model.CalMonth })"
               class="@(string.IsNullOrEmpty(Model.Owner) ? "bg-blue-50 text-blue-700 border border-blue-200" : "bg-gray-100 hover:bg-gray-200 text-gray-700") text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">All Tasks</a>
            <button type="button" onclick="saveCurrentQuery()"
                    class="inline-flex items-center gap-1.5 border border-gray-200 bg-white hover:bg-gray-50 text-gray-600 text-sm font-medium px-3 py-1.5 rounded-lg transition-colors"
                    title="Save current filters as a named query">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
                Save as Query
            </button>
        </div>
    </form>
    </div>

    <script>
    function quickFilterClient(name, e) {
        if (e) e.stopPropagation();
        const p = new URLSearchParams(location.search);
        p.set('property', name); p.set('page', '1');
        location.href = '/Tasks?' + p.toString();
    }
    function quickFilterModule(name, e) {
        if (e) e.stopPropagation();
        const p = new URLSearchParams(location.search);
        p.set('project', name); p.set('page', '1');
        location.href = '/Tasks?' + p.toString();
    }

    // ── Filter bar: HIM-driven Module & Client dropdowns ────────────────
    let _modulesCache = null;  // shared with canvas JS below
    const _FB_MODULE = '@Html.Raw(Model.Project?.Replace("'", "\\'") ?? "")';
    const _FB_CLIENT = '@Html.Raw(Model.Property?.Replace("'", "\\'") ?? "")';

    async function _filterLoadModules() {
        const sel = document.getElementById('filter-project');
        try {
            if (!_modulesCache || _modulesCache.length === 0) {
                const r = await fetch('/Tasks/GetModules');
                if (!r.ok) throw new Error('HTTP ' + r.status);
                _modulesCache = await r.json();
            }
            sel.innerHTML = '<option value="">All Modules</option>';
            _modulesCache.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.name;
                opt.dataset.mid = m.id;
                opt.textContent = m.name;
                if (m.name === _FB_MODULE) opt.selected = true;
                sel.appendChild(opt);
            });
        } catch(e) {
            sel.innerHTML = '<option value="">All Modules</option>';
            console.warn('Filter GetModules failed:', e);
        }
        const picked = sel.options[sel.selectedIndex];
        const mid = picked ? (parseInt(picked.dataset.mid) || 0) : 0;
        await _filterLoadClients(mid, _FB_CLIENT);
    }

    async function _filterLoadClients(moduleId, restoreClientName) {
        const sel = document.getElementById('filter-property');
        sel.innerHTML = '<option value="">— Loading… —</option>';
        try {
            const r = await fetch('/Tasks/GetClients?moduleId=' + moduleId);
            const clients = await r.json();
            sel.innerHTML = '<option value="">All Clients</option>';
            clients.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.name;
                opt.textContent = c.name + (c.fromCompany ? ' ★' : '');
                if (c.name === restoreClientName) opt.selected = true;
                sel.appendChild(opt);
            });
        } catch(e) {
            sel.innerHTML = '<option value="">All Clients</option>';
            console.warn('Filter GetClients failed:', e);
        }
    }

    async function onFilterModuleChange(selectEl) {
        const opt = selectEl.options[selectEl.selectedIndex];
        const mid = opt ? (parseInt(opt.dataset.mid) || 0) : 0;
        await _filterLoadClients(mid, '');
    }

    // Initialise filter dropdowns as soon as the page loads
    _filterLoadModules();

    function toggleFilterBar() {
        const wrap  = document.getElementById('filter-bar-wrap');
        const label = document.getElementById('filter-toggle-label');
        const hidden = wrap.classList.toggle('hidden');
        label.textContent = hidden ? 'Show filters' : 'Hide filters';
    }
    // Auto-open if any filter is active in the URL
    (function() {
        const p = new URLSearchParams(location.search);
        if (['search','project','property','owner','status','priority','dateFrom','dateTo'].some(k => p.get(k))) {
            document.getElementById('filter-bar-wrap').classList.remove('hidden');
            document.getElementById('filter-toggle-label').textContent = 'Hide filters';
        }
    })();

    async function saveCurrentQuery() {
        const { value: val } = await Swal.fire({
            title: 'Save as Query',
            html: `<input id="sq-name" class="swal2-input" placeholder="Query name e.g. My Open P0 Tasks" style="margin-bottom:8px">
                   <input id="sq-desc" class="swal2-input" placeholder="Description (optional)" style="margin-bottom:8px">
                   <label style="display:flex;align-items:center;gap:8px;font-size:.875rem;color:#374151;padding:4px 16px 0;cursor:pointer">
                       <input type="checkbox" id="sq-shared" style="width:16px;height:16px;cursor:pointer"> Share with team
                   </label>`,
            showCancelButton: true,
            confirmButtonText: 'Save',
            focusConfirm: false,
            preConfirm: () => {
                const n = (document.getElementById('sq-name').value || '').trim();
                if (!n) { Swal.showValidationMessage('Query name is required'); return false; }
                return { name: n, description: (document.getElementById('sq-desc').value||'').trim(), isShared: document.getElementById('sq-shared').checked };
            }
        });
        if (!val) return;

        const p = new URLSearchParams(location.search);
        const filters = JSON.stringify({
            search:   p.get('search')   || '',
            project:  p.get('project')  || '',
            property: p.get('property') || '',
            owner:    p.get('owner')    || '',
            status:   p.get('status')   || '',
            priority: p.get('priority') || '',
            dateFrom: p.get('dateFrom') || '',
            dateTo:   p.get('dateTo')   || '',
            view:     p.get('view')     || 'table',
            sort:     p.get('sort')     || '',
            sortDir:  p.get('sortDir')  || 'desc'
        });

        const fd = new FormData();
        fd.append('name',        val.name);
        fd.append('description', val.description);
        fd.append('isShared',    val.isShared);
        fd.append('filters',     filters);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        const r = await fetch('/Queries/Save', { method: 'POST', body: fd });
        const d = await r.json();
        if (d.success) {
            Swal.fire({
                icon: 'success',
                title: 'Query saved!',
                html: `<a href="/Queries" style="color:#3b82f6;font-weight:500;">View all saved queries →</a>`,
                timer: 3000,
                showConfirmButton: false
            });
        } else {
            Swal.fire({ icon: 'error', text: d.error || 'Could not save query.' });
        }
    }
    </script>

    @* ════════════════════ TABLE VIEW ════════════════════ *@
    @if (Model.ViewMode == "table")
    {
        string curDisplay = User.FindFirst("DisplayName")?.Value ?? "";
        string PageUrl(int p) => Url.Action("Index", new {
            search=Model.Search, project=Model.Project, property=Model.Property,
            owner=ownerParam, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint,
            dateFrom=Model.DateFrom, dateTo=Model.DateTo,
            page=p, pageSize=Model.PageSize, sort=Model.Sort, sortDir=Model.SortDir
        }) ?? "#";
        int sp2 = Math.Max(1, Model.Page - 2);
        int ep2 = Math.Min(Model.TotalPages, Model.Page + 2);

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <!-- Table title bar: filtered-set totals (all pages, updates with filters) -->
            <div class="flex items-center justify-between gap-3 flex-wrap px-4 py-2.5 border-b border-gray-100 bg-gray-50/70">
                <h2 class="text-sm font-semibold text-gray-700">
                    Tasks <span class="text-gray-400 font-normal">· @Model.TotalCount</span>
                </h2>
                <div class="flex items-center gap-2 text-xs">
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-cyan-50 text-cyan-700 border border-cyan-200 font-medium"
                          title="Total estimate hours across all filtered tasks">
                        Est: @Model.TotalEstimateHours.ToString("0.##")h
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium"
                          title="Total actual hours logged across all filtered tasks">
                        Actual: @Model.TotalActualHours.ToString("0.##")h
                    </span>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm border-collapse">
                    <thead>
                        <tr class="bg-[#0f2a3f] text-white text-xs">
                            <th class="px-3 py-2.5 w-8">
                                <input type="checkbox" id="bl-select-all" class="w-4 h-4 rounded cursor-pointer" onchange="bulkSelectAll(this)">
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap w-20">Type</th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap w-28">
                                <a href="@SortUrl("status")" class="flex items-center gap-1 hover:text-blue-300 group">Status <span class="text-xs opacity-60">@SortIcon("status")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">
                                <a href="@SortUrl("property")" class="flex items-center gap-1 hover:text-blue-300 group">Client <span class="text-xs opacity-60">@SortIcon("property")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">
                                <a href="@SortUrl("project")" class="flex items-center gap-1 hover:text-blue-300 group">Project <span class="text-xs opacity-60">@SortIcon("project")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">Sprint</th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide">
                                <a href="@SortUrl("goal")" class="flex items-center gap-1 hover:text-blue-300 group">Title <span class="text-xs opacity-60">@SortIcon("goal")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">
                                <a href="@SortUrl("priority")" class="flex items-center gap-1 hover:text-blue-300 group">Priority <span class="text-xs opacity-60">@SortIcon("priority")</span></a>
                            </th>
                            <th class="text-right px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap w-16">
                                <a href="@SortUrl("weight")" class="flex items-center justify-end gap-1 hover:text-blue-300 group">Est. <span class="text-xs opacity-60">@SortIcon("weight")</span></a>
                            </th>
                            <th class="text-right px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap w-16">
                                <a href="@SortUrl("actual")" class="flex items-center justify-end gap-1 hover:text-blue-300 group">Actual <span class="text-xs opacity-60">@SortIcon("actual")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">
                                <a href="@SortUrl("owner")" class="flex items-center gap-1 hover:text-blue-300 group">Assignee <span class="text-xs opacity-60">@SortIcon("owner")</span></a>
                            </th>
                            <th class="text-left px-3 py-2.5 font-semibold tracking-wide whitespace-nowrap">
                                <a href="@SortUrl("created")" class="flex items-center gap-1 hover:text-blue-300 group">Created <span class="text-xs opacity-60">@SortIcon("created")</span></a>
                            </th>
                            <th class="px-3 py-2.5 w-24 text-center font-semibold tracking-wide whitespace-nowrap">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Tasks.Any())
                        {
                            <tr>
                                <td colspan="13" class="text-center py-20 text-gray-400">
                                    <svg class="w-12 h-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                    <p class="font-medium">No tasks found</p>
                                    <button onclick="openCanvas(null)" class="text-xs text-blue-600 hover:underline mt-1">Create a task</button>
                                </td>
                            </tr>
                        }
                        @foreach (var task in Model.Tasks)
                        {
                            var taskJson     = TaskDataJson(task);
                            var overdue      = IsOverdue(task.EndDate, task.Status);
                            var taskOwners   = SplitOwners(task.Owner ?? "").ToList();
                            var tCanEdit     = User.IsInRole("Admin") || taskOwners.Count == 0 || taskOwners.Contains(curDisplay)
                                               || task.Reporter == curDisplay || task.CreatedBy == curDisplay;
                            string typeCls   = task.ItemType switch {
                                "Epic"    => "bg-purple-100 text-purple-700",
                                "Feature" => "bg-indigo-100 text-indigo-700",
                                "Story"   => "bg-sky-100 text-sky-700",
                                "Bug"     => "bg-red-100 text-red-700",
                                _         => "bg-emerald-100 text-emerald-700"
                            };
                            <tr class="tbl-row border-b border-gray-100 hover:bg-blue-50/40 cursor-pointer transition-colors @(overdue ? "bg-red-50/30" : "")"
                                data-task="@taskJson" data-task-id="@task.Id"
                                onclick="openCanvas(JSON.parse(this.dataset.task))">

                                <td class="px-3 py-2" onclick="event.stopPropagation()">
                                    <input type="checkbox" class="bl-row-check w-4 h-4 rounded accent-blue-600 cursor-pointer"
                                           data-id="@task.Id" data-item-type="@(task.ItemType ?? "Task")" data-status="@task.Status"
                                           onchange="bulkCheckChange(event)">
                                </td>

                                <td class="px-3 py-2 whitespace-nowrap">
                                    <span class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded w-fit @typeCls">@(task.ItemType ?? "Task")</span>
                                </td>
                                <td class="px-3 py-2 whitespace-nowrap" onclick="event.stopPropagation()">
                                    <button type="button"
                                            data-task-id="@task.Id" data-cur-status="@task.Status" data-item-type="@task.ItemType"
                                            data-owner="@task.Owner" data-reporter="@task.Reporter" data-created-by="@task.CreatedBy"
                                            onclick="toggleStatusMenu(this)"
                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold cursor-pointer hover:opacity-80 transition-opacity @StatusBadge(task.Status)">
                                        @task.Status
                                        <svg class="w-2 h-2 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                </td>

                                <td class="px-3 py-2 text-xs text-gray-600 whitespace-nowrap max-w-[130px] truncate" title="@task.Property">@task.Property</td>
                                <td class="px-3 py-2 text-xs text-gray-600 whitespace-nowrap max-w-[130px] truncate" title="@task.Project">@task.Project</td>
                                <td class="px-3 py-2 whitespace-nowrap">
                                    @{ var tSprint = SprintNameFor(task.SprintId); }
                                    @if (!string.IsNullOrEmpty(tSprint))
                                    {
                                        <span class="inline-flex items-center gap-0.5 text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 max-w-[120px] truncate" title="Sprint: @tSprint">⚡ @tSprint</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-gray-300">—</span>
                                    }
                                </td>

                                <td class="px-3 py-2">
                                    <span class="text-sm text-gray-900 line-clamp-1">@task.Goal</span>
                                    @if (!string.IsNullOrEmpty(task.Labels))
                                    {
                                        <div class="flex gap-1 mt-0.5 flex-wrap">
                                            @foreach (var lbl in task.Labels.Split(',').Select(l=>l.Trim()).Where(l=>l.Length>0).Take(3))
                                            { <span class="text-[9px] px-1 py-px rounded bg-violet-50 text-violet-600 font-medium border border-violet-100">@lbl</span> }
                                        </div>
                                    }
                                </td>

                                <td class="px-3 py-2 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(task.Priority))
                                    { <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold @PriorityBadge(task.Priority)">@task.Priority</span> }
                                </td>

                                <td class="px-3 py-2 text-right whitespace-nowrap">
                                    @if (task.Weight is > 0)
                                    { <span class="text-xs font-medium text-cyan-600">@($"{task.Weight:0.##}")h</span> }
                                    else { <span class="text-gray-200 text-xs">—</span> }
                                </td>

                                <td class="px-3 py-2 text-right whitespace-nowrap">
                                    @if (task.ActualHours is > 0)
                                    {
                                        var over = task.Weight is > 0 && task.ActualHours > task.Weight;
                                        <span class="text-xs font-medium @(over ? "text-red-500" : "text-emerald-600")">@($"{task.ActualHours:0.##}")h</span>
                                    }
                                    else { <span class="text-gray-200 text-xs">—</span> }
                                </td>

                                <td class="px-3 py-2 whitespace-nowrap">
                                    @if (taskOwners.Count == 0)
                                    { <span class="text-gray-300 text-xs">—</span> }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <div class="flex -space-x-1">
                                                @foreach (var ow in taskOwners.Take(3))
                                                {
                                                    var owClr = ownerColorMap.GetValueOrDefault(ow, "#64748b");
                                                    <span class="w-6 h-6 rounded-full border-2 border-white flex items-center justify-center text-[10px] font-bold text-white"
                                                          style="background:@owClr" title="@ow">@(ow.Length > 0 ? ow[0].ToString().ToUpper() : "?")</span>
                                                }
                                            </div>
                                            @if (taskOwners.Count == 1)
                                            { <span class="text-xs text-gray-600 truncate max-w-[80px]">@taskOwners[0]</span> }
                                            else if (taskOwners.Count > 3)
                                            { <span class="text-xs text-gray-400">+@(taskOwners.Count-3)</span> }
                                        </div>
                                    }
                                </td>

                                <td class="px-3 py-2 text-xs whitespace-nowrap text-gray-400">
                                    @task.CreatedAt.ToString("dd MMM yy")
                                </td>

                                <td class="px-3 py-2" onclick="event.stopPropagation()">
                                    <div class="flex items-center justify-center gap-1">
                                        <button data-task="@taskJson" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                                class="p-1.5 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                                title="@(tCanEdit ? "Edit" : "View")">
                                            @if (tCanEdit)
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            }
                                        </button>
                                        @if (tCanEdit)
                                        {
                                            <form method="post" action="/Tasks/Delete/@task.Id" id="del-@task.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="button" onclick="swalDelete(document.getElementById('del-@task.Id'), null)"
                                                        class="p-1.5 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Delete">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Pagination *@
        @if (Model.TotalPages > 1 || Model.Tasks.Any())
        {
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span>Rows per page:</span>
                    <form method="get" action="/Tasks">
                        <input type="hidden" name="search"   value="@Model.Search"/>
                        <input type="hidden" name="project"  value="@Model.Project"/>
                        <input type="hidden" name="property" value="@Model.Property"/>
                        <input type="hidden" name="owner"    value="@Model.Owner"/>
                        <input type="hidden" name="status"   value="@Model.Status"/>
                        <input type="hidden" name="priority" value="@Model.Priority"/>
                        <input type="hidden" name="dateFrom" value="@Model.DateFrom"/>
                        <input type="hidden" name="dateTo"   value="@Model.DateTo"/>
                        <input type="hidden" name="sort"     value="@Model.Sort"/>
                        <input type="hidden" name="sortDir"  value="@Model.SortDir"/>
                        <input type="hidden" name="page"     value="1"/>
                        <select name="pageSize" onchange="this.form.submit()"
                                asp-items="@(new SelectList(new[]{10,20,50,100}.Select(n=>new SelectListItem(n.ToString(),n.ToString())),"Value","Text",Model.PageSize.ToString()))"
                                class="border border-gray-200 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </select>
                    </form>
                    <span>Showing @((Model.Page-1)*Model.PageSize+1)–@(Math.Min(Model.Page*Model.PageSize,Model.TotalCount)) of @Model.TotalCount</span>
                </div>
                <div class="flex items-center gap-1">
                    <a href="@PageUrl(1)"               class="px-2 py-1.5 rounded-lg text-sm @(Model.Page<=1?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">«</a>
                    <a href="@PageUrl(Model.Page-1)"    class="px-2 py-1.5 rounded-lg text-sm @(Model.Page<=1?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">‹</a>
                    @for (int pg = sp2; pg <= ep2; pg++)
                    { <a href="@PageUrl(pg)" class="px-3 py-1.5 rounded-lg text-sm font-medium @(pg==Model.Page?"bg-blue-600 text-white":"text-gray-600 hover:bg-gray-100")">@pg</a> }
                    <a href="@PageUrl(Model.Page+1)"    class="px-2 py-1.5 rounded-lg text-sm @(Model.Page>=Model.TotalPages?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">›</a>
                    <a href="@PageUrl(Model.TotalPages)" class="px-2 py-1.5 rounded-lg text-sm @(Model.Page>=Model.TotalPages?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">»</a>
                </div>
            </div>
        }
    }

    @* Bulk action bar (fixed bottom, table view only) *@
    @{
        var allSprints = ViewBag.AllSprints as List<Sprint> ?? new List<Sprint>();
    }
    <form id="tbl-aft" style="display:none">@Html.AntiForgeryToken()</form>
    <div id="bulk-bar" class="hidden fixed bottom-0 left-0 right-0 z-50 flex items-center gap-3 bg-[#0f2a3f] text-white px-6 py-3 shadow-2xl border-t border-white/10">
        <span id="bulk-count" class="text-sm font-semibold shrink-0">0 selected</span>
        <div class="flex items-center gap-2 flex-wrap">
            <button onclick="bulkDelete()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-xs font-medium transition-colors shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Move to Bin
            </button>
            <select id="bulk-status-sel" onchange="bulkChangeStatus(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 text-xs font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="" disabled selected>Set Status…</option>
                @foreach (var ws in Model.WorkStates)
                {
                    <option value="@ws.Name">@ws.Name</option>
                }
            </select>
            <select id="bulk-owner-sel" onchange="bulkChangeOwner(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 text-xs font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="" disabled selected>Set Assignee…</option>
                @foreach (var ow in Model.Owners)
                {
                    <option value="@ow.Name">@ow.Name</option>
                }
            </select>
            @if (allSprints.Any())
            {
                <select id="bulk-sprint-sel" onchange="bulkAssignSprint(this.value === '' ? null : parseInt(this.value))"
                        class="px-2 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 text-xs font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="" disabled selected>Set Sprint…</option>
                    <option value="">Backlog</option>
                    @foreach (var sp in allSprints)
                    {
                        <option value="@sp.Id">@sp.Name</option>
                    }
                </select>
            }
            <select id="bulk-priority-sel" onchange="bulkChangePriority(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 text-xs font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="" disabled selected>Set Priority…</option>
                <option value="Critical">Critical</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>
        <button onclick="bulkClearSelection()" class="ml-auto p-1.5 rounded-lg hover:bg-white/10 text-white/50 hover:text-white transition-colors shrink-0" title="Clear selection">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
    </div>

    @* ════════════════════ KANBAN VIEW ════════════════════ *@
    @if (Model.ViewMode == "kanban")
    {
        bool kIsAdmin    = User.IsInRole("Admin");
        string kCurDisplay = User.FindFirst("DisplayName")?.Value ?? "";
        <div class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1" style="height:calc(100vh - 260px);min-height:400px">
            @for (int ci = 0; ci < Model.WorkStates.Count; ci++)
            {
                var colWs     = Model.WorkStates[ci];
                var colSt     = colWs.Name;
                var colClr    = colWs.Color;
                var colTs     = Model.Tasks.Where(t => t.Status == colSt).ToList();
                var expTs     = colTs.Where(t => t.Swimlane == "Expedite").ToList();
                var defTs     = colTs.Where(t => (t.Swimlane ?? "") != "Expedite").ToList();
                var colStJs   = colSt.Replace("'", "\\'");
                var wipLimit  = colWs.WipLimit;
                var wipOver   = wipLimit.HasValue && colTs.Count >= wipLimit.Value;
                var wipNear   = wipLimit.HasValue && !wipOver && colTs.Count >= (int)Math.Ceiling(wipLimit.Value * 0.8);
                var wipBadge  = wipOver  ? "bg-red-100 text-red-700"
                               : wipNear ? "bg-amber-100 text-amber-700"
                                         : "bg-gray-100 text-gray-500";
                var wipText   = wipLimit.HasValue ? $"{colTs.Count} / {wipLimit}" : colTs.Count.ToString();
                var wipTitle  = wipLimit.HasValue ? (wipOver ? "WIP limit exceeded!" : $"WIP: {colTs.Count} / {wipLimit}") : "";
                <div data-kanban-col data-col-name="@colSt" data-wip-limit="@(wipLimit?.ToString() ?? "")"
                     class="kanban-col flex-shrink-0 w-72 bg-gray-50 rounded-xl border @(wipOver ? "border-red-300" : "border-gray-200") overflow-hidden flex flex-col h-full transition-all duration-200">
                    <div class="kanban-col-header flex items-center justify-between px-4 py-3 border-b @(wipOver ? "border-red-200 bg-red-50/30" : "border-gray-200 bg-white") min-w-0">
