                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Story Points
                            </span>
                        </th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">Due Date</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide w-10" title="Comments">
                            <svg class="w-3.5 h-3.5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                        </th>
                        <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide w-20">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tasks.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center py-16 text-gray-400">
                                <svg class="w-12 h-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                <p class="font-medium">No tasks found</p>
                                <p class="text-xs mt-1">Try adjusting filters or <button onclick="openCanvas(null)" class="text-blue-600 hover:underline">create a new task</button></p>
                            </td>
                        </tr>
                    }
                    @{
                        int rowNum = (Model.Page - 1) * Model.PageSize + 1;
                        bool isAdmin = User.IsInRole("Admin");
                        string curDisplay = User.FindFirst("DisplayName")?.Value ?? "";
                        string curUser    = User.Identity?.Name ?? "";
                    }
                    @foreach (var task in Model.Tasks)
                    {
                        var detailId  = $"detail-{task.Id}";
                        var taskJson  = JsonSerializer.Serialize(task, jsonOpts);
                        var overdue   = IsOverdue(task.EndDate, task.Status);
                        var rowCls    = overdue ? "bg-red-50/40 hover:bg-red-50/60" : "hover:bg-gray-50";
                        var tOwners    = (task.Owner ?? "").Split(',').Select(o => o.Trim()).Where(o => o.Length > 0).ToList();
                        var tCanEdit   = User.IsInRole("Admin") || tOwners.Count == 0 || tOwners.Contains(curDisplay)
                                         || task.Reporter == curDisplay || task.CreatedBy == curDisplay;
                        var tCanDelete = tCanEdit;
                        <tr class="border-b border-gray-50 cursor-pointer transition-colors @rowCls"
                            data-overdue="@overdue.ToString().ToLower()"
                            data-task="@taskJson"
                            onclick="openCanvas(JSON.parse(this.dataset.task))">
                            <td class="px-4 py-3" onclick="event.stopPropagation()">
                                <input type="checkbox" class="bl-row-check w-4 h-4 rounded accent-blue-600 cursor-pointer"
                                       data-id="@task.Id" onchange="bulkCheckChange(event)">
                            </td>
                            <td class="px-4 py-3 text-gray-400 text-xs">@rowNum</td>
                            <td class="px-4 py-3 max-w-xs">
                                <span class="font-medium text-gray-900 line-clamp-2">@task.Goal</span>
                                @if (!string.IsNullOrEmpty(task.Labels))
                                {
                                    <div class="flex flex-wrap gap-1 mt-1">
                                        @foreach (var lbl in task.Labels.Split(',').Select(l => l.Trim()).Where(l => l.Length > 0).Take(4))
                                        { <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-violet-50 text-violet-600 font-medium">@lbl</span> }
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-600 text-xs whitespace-nowrap">@task.Project</td>
                            <td class="px-4 py-3 text-gray-600 text-xs whitespace-nowrap">@task.Property</td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(task.Priority))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold @PriorityBadge(task.Priority)">@task.Priority</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-wrap gap-1">
                                    @if (string.IsNullOrEmpty(task.Owner))
                                    {
                                        <span class="text-gray-300 text-xs">—</span>
                                    }
                                    else
                                    {
                                        @foreach (var ow in SplitOwners(task.Owner))
                                        {
                                            var owClr = ownerColorMap.GetValueOrDefault(ow, "#64748b");
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium text-white" style="background:@owClr">@ow</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3" onclick="event.stopPropagation()">
                                <button type="button"
                                        data-task-id="@task.Id"
                                        data-cur-status="@task.Status"
                                        onclick="toggleStatusMenu(this)"
                                        class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium border cursor-pointer hover:opacity-80 transition-opacity @StatusBadge(task.Status)">
                                    @task.Status
                                    <svg class="w-2.5 h-2.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </button>
                            </td>
                            <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">
                                @task.CreatedAt.ToString("yyyy-MM-dd")
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                @if (!string.IsNullOrEmpty(WeightLabel(task.Weight)))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-cyan-50 text-cyan-700 border border-cyan-200">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        @WeightLabel(task.Weight)
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">@task.EndDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-center">
                                @{ var cmtCount = Model.CommentCounts.GetValueOrDefault(task.Id, 0); }
                                @if (cmtCount > 0)
                                {
                                    <span class="inline-flex items-center gap-1 text-gray-400 text-xs" title="@cmtCount comment@(cmtCount!=1?"s":"")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                                        @cmtCount
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
                                <div class="flex items-center justify-end gap-1">
                                    <button data-task="@taskJson" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                            class="p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg"
                                            title="@(tCanEdit ? "Edit" : "View / Comment")">
                                        @if (tCanEdit)
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        }
                                    </button>
                                    @if (tCanDelete)
                                    {
                                        <form method="post" action="/Tasks/Delete/@task.Id" id="del-task-@task.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" onclick="swalDelete(document.getElementById('del-task-@task.Id'), null)" class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg" title="Delete">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr id="@detailId" class="hidden bg-blue-50/30">
                            <td colspan="13" class="px-6 py-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    @if (!string.IsNullOrEmpty(task.Notes))
                                    {
                                        <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Description</p><p class="text-sm text-gray-700 whitespace-pre-wrap">@task.Notes</p></div>
                                    }
                                    @if (string.IsNullOrEmpty(task.Notes))
                                    {
                                        <p class="text-sm text-gray-400 col-span-2">No description.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1 || Model.Tasks.Any())
        {
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span>Rows per page:</span>
                    <form method="get" action="/Tasks">
                        <input type="hidden" name="search"   value="@Model.Search" />
                        <input type="hidden" name="project"  value="@Model.Project" />
                        <input type="hidden" name="property" value="@Model.Property" />
                        <input type="hidden" name="owner"    value="@Model.Owner" />
                        <input type="hidden" name="status"   value="@Model.Status" />
                        <input type="hidden" name="priority" value="@Model.Priority" />
                        <input type="hidden" name="dateFrom" value="@Model.DateFrom" />
                        <input type="hidden" name="dateTo"   value="@Model.DateTo" />
                        <input type="hidden" name="sort"     value="@Model.Sort" />
                        <input type="hidden" name="sortDir"  value="@Model.SortDir" />
                        <input type="hidden" name="page"     value="1" />
                        <select name="pageSize" onchange="this.form.submit()"
                                asp-items="@(new SelectList(new[]{10,20,50,100}.Select(n=>new SelectListItem(n.ToString(),n.ToString())),"Value","Text",Model.PageSize.ToString()))"
                                class="border border-gray-200 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </select>
                    </form>
                    <span>Showing @((Model.Page-1)*Model.PageSize+1)–@(Math.Min(Model.Page*Model.PageSize,Model.TotalCount)) of @Model.TotalCount</span>
                </div>
                <div class="flex items-center gap-1">
                    @{
                        string PageUrl(int p) => Url.Action("Index", new {
                            search=Model.Search, project=Model.Project, property=Model.Property,
                            owner=Model.Owner, status=Model.Status, priority=Model.Priority,
                            dateFrom=Model.DateFrom, dateTo=Model.DateTo,
                            page=p, pageSize=Model.PageSize, sort=Model.Sort, sortDir=Model.SortDir
                        }) ?? "#";
                        int sp2 = Math.Max(1, Model.Page-2);
                        int ep2 = Math.Min(Model.TotalPages, Model.Page+2);
                    }
                    <a href="@PageUrl(1)"              class="px-2 py-1.5 rounded-lg text-sm @(Model.Page<=1?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">«</a>
                    <a href="@PageUrl(Model.Page-1)"   class="px-2 py-1.5 rounded-lg text-sm @(Model.Page<=1?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">‹</a>
                    @for (int pg = sp2; pg <= ep2; pg++)
                    {
                        <a href="@PageUrl(pg)" class="px-3 py-1.5 rounded-lg text-sm font-medium @(pg==Model.Page?"bg-blue-600 text-white":"text-gray-600 hover:bg-gray-100")">@pg</a>
                    }
                    <a href="@PageUrl(Model.Page+1)"    class="px-2 py-1.5 rounded-lg text-sm @(Model.Page>=Model.TotalPages?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">›</a>
                    <a href="@PageUrl(Model.TotalPages)" class="px-2 py-1.5 rounded-lg text-sm @(Model.Page>=Model.TotalPages?"text-gray-300 pointer-events-none":"text-gray-600 hover:bg-gray-100")">»</a>
                </div>
            </div>
        }
    }

    @* Bulk action bar (fixed bottom, table view only) *@
    @{
        var allSprints = ViewBag.AllSprints as List<Sprint> ?? new List<Sprint>();
    }
    <form id="tbl-aft" style="display:none">@Html.AntiForgeryToken()</form>
    <div id="bulk-bar" class="hidden fixed bottom-0 left-0 right-0 z-50 flex items-center gap-3 bg-[#0f2a3f] text-white px-6 py-3 shadow-2xl border-t border-white/10">
        <span id="bulk-count" class="text-sm font-semibold shrink-0">0 selected</span>
        <div class="flex items-center gap-2 flex-wrap">
            <button onclick="bulkDelete()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-xs font-medium transition-colors shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Move to Bin
            </button>
            <select id="bulk-status-sel" onchange="bulkChangeStatus(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white/10 border border-white/20 text-white text-xs font-medium cursor-pointer focus:outline-none">
                <option value="" disabled selected>Set Status…</option>
                @foreach (var ws in Model.WorkStates)
                {
                    <option value="@ws.Name">@ws.Name</option>
                }
            </select>
            <select id="bulk-owner-sel" onchange="bulkChangeOwner(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white/10 border border-white/20 text-white text-xs font-medium cursor-pointer focus:outline-none">
                <option value="" disabled selected>Set Assignee…</option>
                @foreach (var ow in Model.Owners)
                {
                    <option value="@ow.Name">@ow.Name</option>
                }
            </select>
            @if (allSprints.Any())
            {
                <select id="bulk-sprint-sel" onchange="bulkAssignSprint(this.value === '' ? null : parseInt(this.value))"
                        class="px-2 py-1.5 rounded-lg bg-white/10 border border-white/20 text-white text-xs font-medium cursor-pointer focus:outline-none">
                    <option value="" disabled selected>Set Sprint…</option>
                    <option value="">Backlog</option>
                    @foreach (var sp in allSprints)
                    {
                        <option value="@sp.Id">@sp.Name</option>
                    }
                </select>
            }
            <select id="bulk-priority-sel" onchange="bulkChangePriority(this.value)"
                    class="px-2 py-1.5 rounded-lg bg-white/10 border border-white/20 text-white text-xs font-medium cursor-pointer focus:outline-none">
                <option value="" disabled selected>Set Priority…</option>
                <option value="Critical">Critical</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>
        <button onclick="bulkClearSelection()" class="ml-auto p-1.5 rounded-lg hover:bg-white/10 text-white/50 hover:text-white transition-colors shrink-0" title="Clear selection">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
    </div>

    @* ════════════════════ KANBAN VIEW ════════════════════ *@
    @if (Model.ViewMode == "kanban")
    {
        bool kIsAdmin    = User.IsInRole("Admin");
        string kCurDisplay = User.FindFirst("DisplayName")?.Value ?? "";
        <div class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1" style="height:calc(100vh - 260px);min-height:400px">
            @for (int ci = 0; ci < Model.WorkStates.Count; ci++)
            {
                var colWs     = Model.WorkStates[ci];
                var colSt     = colWs.Name;
                var colClr    = colWs.Color;
                var colTs     = Model.Tasks.Where(t => t.Status == colSt).ToList();
                var expTs     = colTs.Where(t => t.Swimlane == "Expedite").ToList();
                var defTs     = colTs.Where(t => (t.Swimlane ?? "") != "Expedite").ToList();
                var colStJs   = colSt.Replace("'", "\\'");
                var wipLimit  = colWs.WipLimit;
                var wipOver   = wipLimit.HasValue && colTs.Count >= wipLimit.Value;
                var wipNear   = wipLimit.HasValue && !wipOver && colTs.Count >= (int)Math.Ceiling(wipLimit.Value * 0.8);
                var wipBadge  = wipOver  ? "bg-red-100 text-red-700"
                               : wipNear ? "bg-amber-100 text-amber-700"
                                         : "bg-gray-100 text-gray-500";
                var wipText   = wipLimit.HasValue ? $"{colTs.Count} / {wipLimit}" : colTs.Count.ToString();
                var wipTitle  = wipLimit.HasValue ? (wipOver ? "WIP limit exceeded!" : $"WIP: {colTs.Count} / {wipLimit}") : "";
                <div data-kanban-col data-col-name="@colSt" data-wip-limit="@(wipLimit?.ToString() ?? "")"
                     class="kanban-col flex-shrink-0 w-72 bg-gray-50 rounded-xl border @(wipOver ? "border-red-300" : "border-gray-200") overflow-hidden flex flex-col h-full transition-all duration-200">
                    <div class="kanban-col-header flex items-center justify-between px-4 py-3 border-b @(wipOver ? "border-red-200 bg-red-50/30" : "border-gray-200 bg-white") min-w-0">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:@colClr"></div>
                            <span class="kanban-col-title text-sm font-semibold text-gray-800 truncate">@colSt</span>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <span class="kanban-count text-xs font-bold rounded-full px-2 py-0.5 @wipBadge" title="@wipTitle">@wipText</span>
                            <button onclick="toggleKanbanCol(this)" title="Collapse column"
                                    class="p-1 text-gray-300 hover:text-gray-500 rounded transition-colors">
                                <svg class="w-3.5 h-3.5 kanban-collapse-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <!-- Collapsed state: vertical rotated label -->
                    <div class="kanban-col-collapsed hidden flex-1 flex items-center justify-center cursor-pointer" onclick="toggleKanbanCol(this.previousElementSibling.querySelector('button'))">
                        <span class="text-xs font-semibold text-gray-500 tracking-wide" style="writing-mode:vertical-rl;transform:rotate(180deg)">@colSt</span>
                    </div>
                    <!-- Column body: two swimlane zones -->
                    <div class="kanban-col-body overflow-y-auto flex-1 rounded-b-xl transition-all duration-150">
                        <!-- ⚡ Expedite swimlane -->
                        <div class="px-2 pt-2 pb-1">
                            <div class="flex items-center gap-1 mb-1 select-none">
                                <svg class="w-3 h-3 text-orange-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                <span class="text-[10px] font-bold text-orange-500 uppercase tracking-wide">Expedite</span>
                                <span class="swimlane-exp-count ml-auto text-[10px] font-semibold bg-orange-100 text-orange-600 rounded-full px-1.5">@expTs.Count</span>
                            </div>
                            <div class="swimlane-drop min-h-7 space-y-2 rounded-lg border-l-2 border-orange-200 pl-1.5 pb-1"
                                 data-col-status="@colSt" data-swimlane="Expedite"
                                 ondragover="event.preventDefault();this.classList.add('ring-2','ring-inset','ring-orange-300','bg-orange-50/30')"
                                 ondragleave="if(!this.contains(event.relatedTarget))this.classList.remove('ring-2','ring-inset','ring-orange-300','bg-orange-50/30')"
                                 ondrop="handleKanbanDrop(event,this,'@Html.Raw(colStJs)','Expedite')">
                                <div class="kanban-empty text-center py-1.5 text-gray-300 text-[10px] @(expTs.Any() ? "hidden" : "")">Drop here</div>
                                @foreach (var kt in expTs)
                                {
                                    var kj  = JsonSerializer.Serialize(kt, jsonOpts);
                                    var kov = IsOverdue(kt.EndDate, kt.Status);
                                    var kCanEdit = kIsAdmin || string.IsNullOrWhiteSpace(kt.Owner)
                                                   || SplitOwners(kt.Owner).Any(o => string.Equals(o, kCurDisplay, StringComparison.OrdinalIgnoreCase))
                                                   || string.Equals(kt.Reporter, kCurDisplay, StringComparison.OrdinalIgnoreCase)
                                                   || string.Equals(kt.CreatedBy, kCurDisplay, StringComparison.OrdinalIgnoreCase);
                                    <div draggable="true" data-task-id="@kt.Id" data-swimlane="Expedite"
                                         ondragstart="handleKanbanDragStart(event)" ondragend="handleKanbanDragEnd(event)"
                                         data-task="@kj" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                         class="kanban-card bg-white rounded-lg border @(kov ? "border-red-200 bg-red-50/20" : "border-gray-200") p-3 hover:border-blue-300 hover:shadow-sm transition-all @(kCanEdit ? "cursor-grab" : "cursor-pointer") select-none">
                                        <div class="flex items-start justify-between gap-1 mb-1.5">
                                            @if (!string.IsNullOrEmpty(kt.Priority)) { <span class="text-xs font-bold px-1.5 py-0.5 rounded @PriorityBadge(kt.Priority)">@kt.Priority</span> }
                                            @if (kov) { <span class="text-xs text-red-500 ml-auto" title="Overdue">⚠</span> }
                                        </div>
                                        <p class="text-sm text-gray-900 font-medium line-clamp-2 mb-1.5 leading-snug pointer-events-none">@kt.Goal</p>
                                        @if (!string.IsNullOrEmpty(kt.Labels))
                                        {
                                            <div class="flex flex-wrap gap-1 mb-1.5 pointer-events-none">
                                                @foreach (var lbl in kt.Labels.Split(',').Select(l => l.Trim()).Where(l => l.Length > 0).Take(3))
                                                { <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-violet-50 text-violet-600 font-medium">@lbl</span> }
                                            </div>
                                        }
                                        <div class="flex flex-wrap gap-1 mb-2 pointer-events-none">
                                            @if (!string.IsNullOrEmpty(kt.Project))  { <span class="text-xs bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded">@kt.Project</span> }
                                            @if (!string.IsNullOrEmpty(kt.Property)) { <span class="text-xs bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">@kt.Property</span> }
                                        </div>
                                        <div class="flex items-center justify-between text-xs pointer-events-none">
                                            <div class="flex flex-wrap gap-1">
                                                @{ var kOwners = SplitOwners(kt.Owner).ToList(); }
