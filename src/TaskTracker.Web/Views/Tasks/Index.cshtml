@model TaskTracker.Models.ViewModels.TaskListViewModel
@using System.Text.Json
@using TaskTracker.Models
@{
    ViewData["Title"] = "Tasks";
    var jsonOpts     = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var today        = DateTime.Today;
    // Project only the fields the canvas needs; excludes DB internals (IsDeleted, BacklogOrder, TeamId, etc.)
    // and formats DateTime? as "yyyy-MM-dd" strings for HTML date inputs.
    Func<TaskItem, string> TaskDataJson = t => JsonSerializer.Serialize(new {
        t.Id, t.Goal, t.Project, t.ProjectId, t.Property, t.Priority,
        t.Owner, t.Status, t.ItemType,
        targetDate      = t.TargetDate?.ToString("yyyy-MM-dd"),
        startDate       = t.StartDate?.ToString("yyyy-MM-dd"),
        endDate         = t.EndDate?.ToString("yyyy-MM-dd"),
        actualStartDate = t.ActualStartDate?.ToString("yyyy-MM-dd"),
        actualEndDate   = t.ActualEndDate?.ToString("yyyy-MM-dd"),
        t.Weight, t.EstimateUnit, t.ActualHours, t.RemainingWorkHours, t.Notes, t.Labels, t.AcceptanceCriteria,
        t.RelatedFiles, t.Reporter, t.CreatedBy,
        createdAt       = t.CreatedAt.ToString("yyyy-MM-dd HH:mm"),
        t.ParentId, t.SprintId, t.ModuleId, t.ClientId, t.Swimlane
    }, jsonOpts);
    var ownerColorMap = Model.Owners.ToDictionary(
        o => o.Name, o => o.Color ?? "#094f70", StringComparer.OrdinalIgnoreCase);
    var ownerImageMap = Model.Owners
        .Where(o => !string.IsNullOrEmpty(o.ImagePath))
        .ToDictionary(o => o.Name, o => o.ImagePath!, StringComparer.OrdinalIgnoreCase);
    var myDisplayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var myImgPath     = User.FindFirst("ProfileImagePath")?.Value ?? "";
    var governedProjects = ViewBag.GovernedProjects as List<ProjectItem> ?? [];
    var taskTemplates = ViewBag.TaskTemplates as List<TaskTemplate> ?? [];
    // Sprint id → name, so server-rendered views (table, kanban, timeline) can label a task's sprint.
    var sprintNames = (ViewBag.AllSprints as List<Sprint>)?
        .Where(s => s.Id != 0)
        .ToDictionary(s => s.Id, s => s.Name) ?? new Dictionary<int, string>();
    Func<int?, string?> SprintNameFor = id => id.HasValue && sprintNames.TryGetValue(id.Value, out var n) ? n : null;
}

@functions {
    static string PriorityBadge(string? p) => p switch
    {
        "P0" => "bg-red-100 text-red-700 border border-red-200",
        "P1" => "bg-orange-100 text-orange-700 border border-orange-200",
        "P2" => "bg-yellow-100 text-yellow-700 border border-yellow-200",
        "P3" => "bg-gray-100 text-gray-600 border border-gray-200",
        _    => "bg-gray-100 text-gray-500 border border-gray-200"
    };

    static string StatusBadge(string? s) => s switch
    {
        "Done"        => "bg-green-100 text-green-700 border border-green-200",
        "On track"    => "bg-blue-100 text-blue-700 border border-blue-200",
        "Delayed"     => "bg-red-100 text-red-700 border border-red-200",
        "On hold"     => "bg-gray-100 text-gray-600 border border-gray-200",
        "Testing"     => "bg-amber-100 text-amber-700 border border-amber-200",
        "Not Started" => "bg-purple-100 text-purple-700 border border-purple-200",
        _             => "bg-gray-100 text-gray-500 border border-gray-200"
    };

    static bool IsOverdue(DateTime? expectedEnd, string? status)
    {
        if (status is "Done" or "On hold") return false;
        return expectedEnd.HasValue && expectedEnd.Value.Date < DateTime.Today;
    }

    static IEnumerable<string> SplitOwners(string? owner) =>
        (owner ?? "").Split(',').Select(o => o.Trim()).Where(o => o.Length > 0);

    static string AvatarEl(
        string name,
        System.Collections.Generic.Dictionary<string, string> colorMap,
        System.Collections.Generic.Dictionary<string, string> imageMap,
        string szCls = "w-5 h-5", string txCls = "text-[9px]")
    {
        var enc = System.Net.WebUtility.HtmlEncode(name);
        if (imageMap.TryGetValue(name, out var img) && !string.IsNullOrEmpty(img))
            return $"""<img src="{img}" alt="{enc}" class="{szCls} rounded-full object-cover border border-white flex-shrink-0" title="{enc}" />""";
        var clr     = colorMap.GetValueOrDefault(name, "#64748b");
        var initial = name.Length > 0 ? name[0].ToString().ToUpper() : "?";
        return $"""<span class="inline-flex items-center justify-center {szCls} rounded-full {txCls} font-bold border border-white text-white flex-shrink-0" style="background:{clr}" title="{enc}">{initial}</span>""";
    }

    static string WeightLabel(decimal? w) => w switch {
        null or 0 => "",
        _         => $"{w:0.##}h"
    };
}

@{
    var workStatesJson = JsonSerializer.Serialize(
        Model.WorkStates.Select(ws => new { name = ws.Name, color = ws.Color, itemTypes = ws.ItemTypes }),
        jsonOpts);
}

@{
    // Empty Model.Owner means "everyone"; Url.Action drops empty query values, so carry the explicit
    // "__all__" sentinel in links that go back to Index (the controller maps it back to "all").
    var ownerParam = string.IsNullOrEmpty(Model.Owner) ? "__all__" : Model.Owner;

    // Multi-select filters are stored as comma-separated values; split into sets for the option markup.
    var splitOpts = StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries;
    var ownerSel  = (Model.Owner    ?? "").Split(',', splitOpts).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var statusSel = (Model.Status   ?? "").Split(',', splitOpts).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var prioSel   = (Model.Priority ?? "").Split(',', splitOpts).ToHashSet(StringComparer.OrdinalIgnoreCase);

    string SortUrl(string col)
    {
        var dir = Model.Sort == col && Model.SortDir == "asc" ? "desc" : "asc";
        return Url.Action("Index", new {
            search=Model.Search, project=Model.Project, property=Model.Property,
            owner=ownerParam, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint,
            dateFrom=Model.DateFrom, dateTo=Model.DateTo,
            page=1, pageSize=Model.PageSize, sort=col, sortDir=dir,
            view=Model.ViewMode, calYear=Model.CalYear, calMonth=Model.CalMonth
        }) ?? "#";
    }
    string SortIcon(string col) => Model.Sort != col ? "⇅" : Model.SortDir == "asc" ? "↑" : "↓";

    string ViewUrl(string v) => Url.Action("Index", new {
        search=Model.Search, project=Model.Project, property=Model.Property,
        owner=ownerParam, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint,
        dateFrom=Model.DateFrom, dateTo=Model.DateTo,
        pageSize=Model.PageSize, view=v, calYear=Model.CalYear, calMonth=Model.CalMonth
    }) ?? "#";

    // Resets every filter but keeps the current view (owner falls back to "my tasks" default).
    string resetUrl = Url.Action("Index", new { view=Model.ViewMode }) ?? "/Tasks";

    string exportUrl = Url.Action("Export", new {
        search=Model.Search, project=Model.Project, property=Model.Property,
        owner=Model.Owner, status=Model.Status, priority=Model.Priority, sprint=Model.Sprint,
        dateFrom=Model.DateFrom, dateTo=Model.DateTo
    }) ?? "#";
}

<div class="space-y-4">

    <!-- ── Header ── -->
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Tasks</h1>
            <p>@Model.TotalCount task@(Model.TotalCount != 1 ? "s" : "") total</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <div class="flex rounded-lg border border-gray-200 bg-white overflow-hidden text-sm">
                <a href="@ViewUrl("table")"
                   class="flex items-center gap-1.5 px-3 py-1.5 transition-colors @(Model.ViewMode=="table"?"bg-blue-600 text-white":"text-gray-600 hover:bg-gray-50")">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 6h18M3 14h18M3 18h18"/></svg>
                    Table
                </a>
                <a href="@ViewUrl("kanban")"
