function _esc(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function claimTask(id) {
    const fd = new FormData();
    fd.append('id', id);
    fd.append('__RequestVerificationToken', document.querySelector('[name=__RequestVerificationToken]').value);
    try {
        const r = await fetch('/Tasks/ClaimTask', { method: 'POST', body: fd });
        const j = await r.json();
        if (!j.success) { showToast(j.error || 'Could not claim task.', 'error'); return; }
        showToast('Task claimed — you are now an owner.', 'success');
        const tr = await fetch(`/Tasks/GetTask?id=${id}`);
        if (tr.ok) {
            const opts = { };
            const updated = await tr.json();
            _selectedTask = updated;
            const content = document.getElementById('detail-content');
            if (content && !content.classList.contains('hidden'))
                content.innerHTML = _buildDetailHtml(updated);
        }
    } catch { showToast('Network error.', 'error'); }
}
