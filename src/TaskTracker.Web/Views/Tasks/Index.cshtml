function _buildDetailHtml(t) {
    if (!t) return '';
    const typeCls = { Epic:'bg-purple-100 text-purple-700', Feature:'bg-indigo-100 text-indigo-700', Story:'bg-sky-100 text-sky-700', Bug:'bg-red-100 text-red-700' };
    const tc  = typeCls[t.itemType] || 'bg-emerald-100 text-emerald-700';
    const ws  = (_wsData || []).find(w => w.name === t.status);
    const stClr = ws ? ws.color : '#94a3b8';

    const ownerNames = (t.owner || '').split(',').map(s => s.trim()).filter(Boolean);
    const ownersHtml = ownerNames.length === 0
        ? '<span class="text-gray-400 text-xs">Unassigned</span>'
        : ownerNames.map(n => {
            const clr = (CV_USER_COLORS && CV_USER_COLORS[n]) || '#094f70';
            return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium text-white" style="background:${clr}">${n}</span>`;
          }).join('');

    const labels = (t.labels || '').split(',').map(s => s.trim()).filter(Boolean);
    const labelsHtml = labels.length === 0 ? '' : `
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1.5">Labels</p>
            <div class="flex flex-wrap gap-1.5">${labels.map(l => `<span class="text-xs px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200 font-medium">${l}</span>`).join('')}</div>
        </div>`;

    const fmt = d => d ? new Date(d).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) : '—';
    const pts  = t.weight ? (t.weight >= 8 ? 'XL' : t.weight >= 5 ? 'L' : t.weight >= 3 ? 'M' : 'S') + ` (${t.weight} pts)` : '—';
    const cmtCnt = (typeof t.commentCount !== 'undefined') ? t.commentCount : '';

    const metaRows = [
        ['Status',     `<span class="inline-flex items-center gap-1.5 text-xs font-medium"><span class="w-2 h-2 rounded-full" style="background:${stClr}"></span>${t.status || '—'}</span>`],
        ['Priority',   t.priority || '—'],
        ['Type',       `<span class="text-xs font-bold px-1.5 py-0.5 rounded ${tc}">${t.itemType || 'Task'}</span>`],
        ['Project',    t.project || '—'],
        ['Client',     t.property || '—'],
        ['Owners',     ownersHtml],
        ['Reporter',   t.reporter || '—'],
        ['Story Pts',  pts],
        ['Actual Hrs', t.actualHours ? t.actualHours + 'h' : null],
        ['Due Date',    fmt(t.endDate)],
        ['Target Date', fmt(t.targetDate)],
        ['Start Date',  fmt(t.startDate)],
        ['Actual End',  fmt(t.actualEndDate)],
    ].filter(([, v]) => v && v !== '—');

    const currentUser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.FindFirst("DisplayName")?.Value ?? "", jsonOpts));
    const canEdit = CV_TEAM_ADMIN
        || !t.owner
        || ownerNames.includes(currentUser);
    const showClaim = !ownerNames.includes(currentUser)
        && t.status !== 'Done' && t.status !== 'Closed' && t.status !== 'Resolved';

    return `
    <div class="p-6 space-y-5">
        <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[11px] font-bold px-2 py-0.5 rounded ${tc}">${t.itemType || 'Task'}</span>
