    @* ════════════════════ TIMELINE VIEW ════════════════════ *@
    @if (Model.ViewMode == "calendar")
    {
        var cy   = Model.CalYear;
        var cm   = Model.CalMonth;
        var fd   = new DateTime(cy, cm, 1);
        var dim  = DateTime.DaysInMonth(cy, cm);
        var sdow = (int)fd.DayOfWeek;
        var ld   = new DateTime(cy, cm, dim);

        var prevM = fd.AddMonths(-1);
        var nextM = fd.AddMonths(1);
        string TlNav(DateTime m) => Url.Action("Index", new {
            search=Model.Search, project=Model.Project, property=Model.Property,
            owner=Model.Owner, status=Model.Status, priority=Model.Priority,
            dateFrom=Model.DateFrom, dateTo=Model.DateTo,
            pageSize=Model.PageSize, view="calendar", calYear=m.Year, calMonth=m.Month
        }) ?? "#";

        const int colW = 36;
        var tlEntries   = new List<(TaskItem T, int S, int E)>();
        var noDateItems = new List<TaskItem>();

        foreach (var t in Model.Tasks)
        {
            DateTime? ts = t.StartDate;
            DateTime? te = t.EndDate ?? t.TargetDate;
            if (ts == null) ts = te;
            if (te == null) te = ts;

            if (ts != null && te != null && ts.Value <= ld && te.Value >= fd)
            {
                int bs = ts.Value < fd ? 1 : ts.Value.Day;
                int be = te.Value > ld ? dim : te.Value.Day;
                if (be < bs) be = bs;
                tlEntries.Add((t, bs, be));
            }
            else
            {
                noDateItems.Add(t);
            }
        }

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">

            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                <a href="@TlNav(prevM)" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </a>
                <div class="text-center">
                    <h2 class="text-lg font-semibold text-gray-900">@fd.ToString("MMMM yyyy")</h2>
                    <p class="text-xs text-gray-400">@tlEntries.Count task@(tlEntries.Count != 1 ? "s" : "") in timeline · @noDateItems.Count without dates</p>
                </div>
                <a href="@TlNav(nextM)" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>

            <div class="overflow-x-auto">
                <div style="min-width:@(260 + dim * colW)px">

                    <div class="flex border-b border-gray-200 bg-gray-50">
                        <div class="shrink-0 border-r border-gray-200 px-4 py-2.5" style="width:260px">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Task</span>
                        </div>
                        @for (int d = 1; d <= dim; d++)
                        {
                            bool dWe  = ((sdow + d - 1) % 7) is 0 or 6;
                            bool dTod = cy == today.Year && cm == today.Month && d == today.Day;
                            <div class="shrink-0 flex items-center justify-center text-xs border-r border-gray-100 @(dWe ? "bg-gray-100 text-gray-400" : dTod ? "bg-blue-50 text-blue-600 font-bold" : "text-gray-400")"
                                 style="width:@(colW)px;height:36px">@d</div>
                        }
                    </div>

                    @{
                        bool tlIsAdmin    = User.IsInRole("Admin");
                        string tlCurDisp  = User.FindFirst("DisplayName")?.Value ?? "";
                    }
                    @if (!tlEntries.Any())
                    {
                        <div class="text-center py-16 text-gray-400 text-sm">
                            No tasks with dates in @fd.ToString("MMMM yyyy")<br>
                            <span class="text-xs text-gray-300">Tasks need both a Start Date and End Date to appear on the timeline.</span>
                        </div>
                    }
                    @foreach (var (tlT, tlS, tlE) in tlEntries)
                    {
                        var tlJ       = TaskDataJson(tlT);
                        var barPx     = (tlS - 1) * colW;
                        var barW      = Math.Max(1, tlE - tlS + 1) * colW;
                        var tlCanEdit = tlIsAdmin || SplitOwners(tlT.Owner).Any(o => string.Equals(o, tlCurDisp, StringComparison.OrdinalIgnoreCase));
                        var barClr    = tlT.Status switch {
                            "Done"        => "#16a34a",
                            "On track"    => "#2563eb",
                            "Delayed"     => "#dc2626",
                            "On hold"     => "#6b7280",
                            "Testing"     => "#d97706",
                            "Not Started" => "#7c3aed",
                            _             => "#094f70"
                        };
                        var tlOw  = SplitOwners(tlT.Owner).FirstOrDefault() ?? "";
                        var tlOwC = ownerColorMap.GetValueOrDefault(tlOw, "#64748b");
                        // Module (Project) · Client (Property) · Sprint — shown as a sub-line + folded into tooltips
                        var tlSprint = SprintNameFor(tlT.SprintId);
                        var tlMeta = string.Join(" · ", new[] { tlT.Project, tlT.Property, string.IsNullOrEmpty(tlSprint) ? null : "⚡ " + tlSprint }.Where(s => !string.IsNullOrEmpty(s)));

                        <div class="flex border-b border-gray-50 hover:bg-blue-50/20" style="height:40px">
                            <div class="shrink-0 border-r border-gray-100 flex items-center gap-2 px-3" style="width:260px">
                                @if (!string.IsNullOrEmpty(tlT.Priority))
                                {
                                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 @PriorityBadge(tlT.Priority)">@tlT.Priority</span>
                                }
                                <div class="flex-1 min-w-0">
                                    <button type="button" data-task="@tlJ" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                            class="block w-full text-xs font-medium text-gray-800 hover:text-blue-600 text-left truncate leading-tight"
                                            title="@(tlT.Goal)@(string.IsNullOrEmpty(tlMeta) ? "" : " — " + tlMeta)">
                                        @tlT.Goal
                                    </button>
                                    @if (!string.IsNullOrEmpty(tlMeta))
                                    {
                                        <div class="text-[10px] text-gray-400 truncate leading-tight" title="@tlMeta">@tlMeta</div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(tlOw))
                                {
                                    @Html.Raw(AvatarEl(tlOw, ownerColorMap, ownerImageMap))
                                }
                            </div>
                            <div class="relative flex items-center" style="width:@(dim * colW)px;background:repeating-linear-gradient(90deg,transparent,transparent @(colW-1)px,#f3f4f6 @(colW-1)px,#f3f4f6 @(colW)px)">
                                @if (cy == today.Year && cm == today.Month)
                                {
                                    var tdX = (today.Day - 1) * colW + colW / 2;
                                    <div class="absolute top-0 bottom-0 w-px bg-blue-400/50 pointer-events-none" style="left:@(tdX)px"></div>
                                }
                                @{ var tlBarTitle = tlT.Goal
                                       + (string.IsNullOrEmpty(tlMeta) ? "" : " — " + tlMeta)
                                       + (tlT.EndDate.HasValue ? " · due " + tlT.EndDate.Value.ToString("yyyy-MM-dd") : ""); }
                                <button type="button" data-task="@tlJ" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                        class="absolute h-6 rounded text-white text-[10px] font-medium truncate px-1.5 flex items-center shadow-sm hover:opacity-80 transition-opacity"
                                        style="left:@(barPx)px;width:@(barW)px;background:@barClr"
                                        title="@tlBarTitle">
                                    @if (barW >= colW * 2) { @tlT.Goal }
                                </button>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="px-4 py-3 border-t border-gray-100 bg-gray-50/50 flex flex-wrap items-center gap-3">
                @foreach (var ws2 in Model.WorkStates)
                {
                    <span class="inline-flex items-center gap-1.5 text-xs text-gray-500">
                        <span class="w-3 h-3 rounded-sm inline-block" style="background:@ws2.Color"></span>@ws2.Name
                    </span>
                }
                <span class="text-xs text-gray-400 ml-auto">Click bars or task names to edit</span>
            </div>

        </div>

        @if (noDateItems.Any())
        {
            <div class="bg-white border border-gray-200 rounded-xl p-4">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">@noDateItems.Count task@(noDateItems.Count != 1 ? "s" : "") without dates</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var nd in noDateItems)
                    {
                        var ndJ      = TaskDataJson(nd);
                        <button type="button" data-task="@ndJ" onclick="openCanvas(JSON.parse(this.dataset.task))"
                                class="text-xs border border-gray-200 rounded-lg px-3 py-1.5 hover:bg-blue-50 hover:border-blue-200 text-gray-700 text-left max-w-xs truncate transition-colors">
                            @nd.Goal
                        </button>
                    }
                </div>
            </div>
        }
    }

    @* ── Team Timeline view ───────────────────────────────────────────── *@
    @if (Model.ViewMode == "team")
    {
        string tlFromStr = ViewBag.TlFrom as string ?? "";
        string tlToStr   = ViewBag.TlTo   as string ?? "";
        string tlModeStr = ViewBag.TlMode as string ?? "week";
        <style>
        .tl2-wrap{min-width:600px;font-family:inherit}
        .tl2-hd{display:flex;border-bottom:2px solid #e5e7eb;position:sticky;top:0;background:#f9fafb;z-index:8}
        .tl2-name-hd{width:170px;min-width:170px;padding:8px 12px;font-size:10px;font-weight:700;color:#9ca3af;letter-spacing:.06em;border-right:1px solid #e5e7eb;flex-shrink:0}
        .tl2-days-hd{display:flex;flex:1}
        .tl2-col-hd{flex:1;text-align:center;padding:4px 2px;font-size:10.5px;color:#6b7280;border-right:1px solid #e5e7eb;line-height:1.35}
        .tl2-col-now-hd{background:#eff6ff;color:#1d4ed8;font-weight:700}
        .tl2-row{display:flex;border-bottom:1px solid #f1f5f9;min-height:40px}
        .tl2-row:hover{background:#fafbfd}
        .tl2-name-cell{width:170px;min-width:170px;padding:8px 10px;display:flex;align-items:center;gap:8px;border-right:1px solid #e5e7eb;flex-shrink:0}
        .tl2-days-cell{flex:1;position:relative;overflow:hidden}
        .tl2-col-div{position:absolute;top:0;bottom:0;border-right:1px solid #f0f0f0}
        .tl2-col-div-today{background:rgba(219,234,254,.25)}
        .tl2-col-div-hr{border-right:1px solid #d1d5db!important}
        .tl2-bar{position:absolute;border-radius:7px;background:#fff;box-shadow:0 1px 5px rgba(0,0,0,.1);display:flex;flex-direction:column;justify-content:center;padding:0 9px;cursor:pointer;overflow:hidden;transition:box-shadow .12s,transform .12s;border:1px solid rgba(0,0,0,.07)}
        .tl2-bar:hover{box-shadow:0 4px 12px rgba(0,0,0,.18);transform:translateY(-1px);z-index:5}
        .tl2-bar-strip{position:absolute;top:0;left:0;right:0;height:4px;border-radius:7px 7px 0 0}
        .tl2-bar-txt{color:#1e293b;font-size:11.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;margin-top:4px}
        .tl2-bar-pills{display:flex;gap:4px;margin-top:4px;overflow:hidden}
        .tl2-pill{display:inline-flex;align-items:center;padding:0 7px;height:16px;border-radius:99px;font-size:9.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100px;flex-shrink:0}

        .tl2-av{width:28px;height:28px;border-radius:50%;background:#094f70;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;object-fit:cover}
        .tl2-nm{font-size:12px;font-weight:600;color:#374151;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .tl2-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:11px;color:#d1d5db;font-style:italic}
        .tl2-now-line{position:absolute;top:0;bottom:0;width:2px;background:#ef4444;z-index:6;pointer-events:none}
        .tl2-filter input[type=date]{border:1px solid #d1d5db;border-radius:8px;padding:4px 10px;font-size:12px;height:32px;color:#374151}
        .tl2-filter input[type=date]:focus{outline:none;border-color:#094f70}
        .tl2-btn{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;height:32px;border:1px solid transparent;text-decoration:none;transition:all .15s}
        .tl2-btn-apply{background:#094f70;color:#fff}.tl2-btn-apply:hover{background:#063a54}
        .tl2-btn-week{background:#fff;border-color:#094f70;color:#094f70}.tl2-btn-week:hover{background:#eff8ff}
        .tl2-btn-active{background:#eff6ff;border-color:#1d4ed8;color:#1d4ed8}
        .tl2-btn-today{background:#f1f5f9;border-color:#e2e8f0;color:#374151}.tl2-btn-today:hover{background:#e2e8f0}
        </style>

        <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
            <div class="tl2-filter flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-gray-700 flex items-center gap-2 mr-1">
                    <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Team Timeline
                </span>
                <input type="date" id="tl2-from" value="@(tlModeStr != "today" ? tlFromStr : "")" />
                <span class="text-gray-400 text-sm">to</span>
                <input type="date" id="tl2-to" value="@(tlModeStr != "today" ? tlToStr : "")" />
                <button class="tl2-btn tl2-btn-apply" onclick="tl2Apply()">Apply</button>
                @{
                    var weekUrl = Url.Action("Index", new { view="team", search=Model.Search, project=Model.Project, property=Model.Property, owner=ownerParam, status=Model.Status, priority=Model.Priority, pageSize=Model.PageSize }) ?? "/Tasks?view=team";
                    string dateBadge;
                    if (tlModeStr == "today") { dateBadge = DateTime.Today.ToString("dddd, d MMMM yyyy"); }
                    else if (DateTime.TryParse(tlFromStr, out var tfd2) && DateTime.TryParse(tlToStr, out var ttd2)) {
                        bool isFullMonth = tfd2.Day == 1 && ttd2 == tfd2.AddMonths(1).AddDays(-1);
                        dateBadge = isFullMonth ? tfd2.ToString("MMMM yyyy") : tfd2.ToString("d MMM") + " – " + ttd2.ToString("d MMM yyyy");
                    } else { dateBadge = tlFromStr + " – " + tlToStr; }
                }
                <a href="@weekUrl" class="tl2-btn @(tlModeStr=="week"?"tl2-btn-active":"tl2-btn-week")">This Week</a>
                <a href="/Tasks?view=team&tlmode=today" class="tl2-btn @(tlModeStr=="today"?"tl2-btn-active":"tl2-btn-today")">
                    <svg style="width:13px;height:13px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Today
                </a>
                <span class="ml-2 text-xs font-medium px-2 py-0.5 rounded-full @(tlModeStr=="today"?"bg-amber-100 text-amber-700":"bg-blue-50 text-blue-700")">
                    @dateBadge
                </span>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <div class="flex items-center gap-4 flex-wrap px-4 py-2 border-b border-gray-100">
                @foreach (var (lbl2, clr2) in new[]{("New","#8b5cf6"),("To Do","#64748b"),("Active","#0ea5e9"),("In Progress","#094f70"),("Resolved","#f59e0b"),("Done","#22c55e"),("Closed","#94a3b8")})
                {
                    <span style="display:flex;align-items:center;gap:5px;font-size:11px;color:#6b7280">
                        <span style="width:10px;height:10px;border-radius:3px;background:@clr2;flex-shrink:0"></span>@lbl2
                    </span>
                }
                @if (tlModeStr == "today")
                {
                    <span style="display:flex;align-items:center;gap:5px;font-size:11px;color:#6b7280;margin-left:auto">
                        <span style="width:2px;height:12px;background:#ef4444;border-radius:1px;flex-shrink:0"></span>Now
                    </span>
                }
            </div>
            <div style="overflow-x:auto;padding-bottom:8px">
                <div id="tl2-scroll" style="min-height:160px"></div>
            </div>
        </div>

        <script>
        (function () {
            var TL2_TASKS         = @Html.Raw(ViewBag.TlTasks          as string ?? "[]");
            var TL2_OWNERS        = @Html.Raw(ViewBag.TlOwners         as string ?? "[]");
            // Default to just the logged-in user's row(s); "All assignees" (Model.Owner empty) shows everyone.
            // Model.Owner is a comma-separated multi-select, so match any of the chosen assignees.
            var TL2_ME_SET = (@Html.Raw(JsonSerializer.Serialize(Model.Owner ?? "")) || '')
                .split(',').map(function(s){ return s.trim().toLowerCase(); }).filter(Boolean);
            if (TL2_ME_SET.length) TL2_OWNERS = TL2_OWNERS.filter(function(o){ return TL2_ME_SET.indexOf((o||'').toLowerCase()) !== -1; });
            var TL2_PROJ_COLORS   = @Html.Raw(ViewBag.TlProjectColors  as string ?? "{}");
            var TL2_PROP_COLORS   = @Html.Raw(ViewBag.TlPropertyColors as string ?? "{}");
            var TL2_SPRINTS       = @Html.Raw(JsonSerializer.Serialize(sprintNames));
            var TL2_FROM = '@(tlFromStr)';
            var TL2_TO   = '@(tlToStr)';
            var TL2_MODE = '@(tlModeStr)';
            var SC = {'New':'#8b5cf6','To Do':'#64748b','Active':'#0ea5e9','In Progress':'#094f70','Development Done':'#6366f1','In QA':'#a855f7','Resolved':'#f59e0b','Done':'#22c55e','Closed':'#94a3b8'};
            var DONE = {'Done':1,'Resolved':1,'Closed':1};
            function hex2rgba(hex,a){var r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);return 'rgba('+r+','+g+','+b+','+a+')';}
            function pd(s){if(!s)return null;var m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(!m)return null;return new Date(parseInt(m[1],10),parseInt(m[2],10)-1,parseInt(m[3],10));}
            function sameDay(a,b){return a&&b&&a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();}
            function fmtDay(d){var dn=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],mo=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return '<strong>'+dn[d.getDay()]+'<\/strong><br>'+d.getDate()+' '+mo[d.getMonth()];}
            function fmtTime(tot){var h=Math.floor(tot/60),mn=tot%60,ap=h<12?'AM':'PM',hh=h%12||12;return hh+':'+(mn<10?'0':'')+mn+' '+ap;}
            function ownerMatch(to,o){var p=(to||'').split(',');for(var i=0;i<p.length;i++){if(p[i].trim().toLowerCase()===o.toLowerCase())return true;}return false;}
            function assignLanes(bars){var ends=[];for(var i=0;i<bars.length;i++){var b=bars[i],pl=false;for(var j=0;j<ends.length;j++){if(b.lf>=ends[j]+0.004){b._lane=j;ends[j]=b.rt;pl=true;break;}}if(!pl){b._lane=ends.length;ends.push(b.rt);}}return ends.length||0;}
            function buildRows(fn){return TL2_OWNERS.map(function(owner){var bars=fn(owner).filter(function(x){return x!=null;});bars.sort(function(a,b){return a.lf-b.lf;});var nl=bars.length?assignLanes(bars):0;return{owner:owner,bars:bars,rowH:Math.max(64,nl*62+8)};});}
            function renderGrid(cols,getCI,rows){
                var n=cols.length,today=new Date();today.setHours(0,0,0,0);
                var html='<div class="tl2-wrap"><div class="tl2-hd"><div class="tl2-name-hd">DEVELOPER<\/div><div class="tl2-days-hd">';
                for(var i=0;i<n;i++){var ci=getCI(cols[i],today);html+='<div class="tl2-col-hd'+(ci.isNow?' tl2-col-now-hd':'')+'">'+ ci.label+'<\/div>';}
                html+='<\/div><\/div>';
                for(var r=0;r<rows.length;r++){
                    var row=rows[r];
                    var owImg = (typeof CV_IMAGES !== 'undefined') && CV_IMAGES && CV_IMAGES[row.owner];
                    var avEl = owImg
                        ? '<img src="'+owImg.replace(/"/g,'&quot;')+'" class="tl2-av" style="object-fit:cover;border-radius:50%;" />'
                        : (function(){ var ini=(row.owner.split(/\s+/).map(function(w){return w.charAt(0)||'';}).join('').substring(0,2).toUpperCase())||'?'; return '<div class="tl2-av">'+ini+'<\/div>'; })();
                    html+='<div class="tl2-row" style="height:'+row.rowH+'px">';
                    html+='<div class="tl2-name-cell">'+avEl+'<span class="tl2-nm">'+row.owner+'<\/span><\/div>';
                    html+='<div class="tl2-days-cell">';
                    for(var c=0;c<n;c++){var ci2=getCI(cols[c],today);html+='<div class="tl2-col-div'+(ci2.isNow?' tl2-col-div-today':'')+(ci2.isHour?' tl2-col-div-hr':'')+'" style="left:'+(c/n*100)+'%;width:'+(1/n*100)+'%"><\/div>';}
                    if(row.bars.length===0)html+='<div class="tl2-empty">no tasks<\/div>';
                    for(var bi=0;bi<row.bars.length;bi++){
                        var bar=row.bars[bi];
                        var sclr=SC[bar.task.status]||'#094f70';
                        var top=4+bar._lane*62;
                        var w=Math.max(bar.rt-bar.lf,0.012)*100;
                        var _spN=(bar.task.sprintId&&TL2_SPRINTS[bar.task.sprintId])?TL2_SPRINTS[bar.task.sprintId]:'';
                        var tip=bar.task.goal+(bar.tchip?' | '+bar.tchip:'')+(bar.task.property?' | '+bar.task.property:'')+(bar.task.project?' | '+bar.task.project:'')+(_spN?' | ⚡ '+_spN:'');
                        var taskJson2=JSON.stringify(bar.task).replace(/"/g,'&quot;');
                        html+='<div class="tl2-bar" style="left:'+(bar.lf*100)+'%;width:'+w+'%;top:'+top+'px;height:56px;" title="'+tip.replace(/"/g,'&quot;')+'" data-task="'+taskJson2+'" onclick="openCanvas(JSON.parse(this.dataset.task))">';
                        html+='<div class="tl2-bar-strip" style="background:'+sclr+'"><\/div>';
                        html+='<span class="tl2-bar-txt">'+(bar.seq?bar.seq+'. ':'')+bar.task.goal+'<\/span>';
                        var ph='';
                        if(bar.tchip)ph+='<span class="tl2-pill" style="background:'+hex2rgba(sclr,0.13)+';color:'+sclr+';max-width:160px">'+bar.tchip+'<\/span>';
                        if(bar.task.property){var pc=TL2_PROP_COLORS[bar.task.property]||'#6b7280';ph+='<span class="tl2-pill" style="background:'+hex2rgba(pc,0.12)+';color:'+pc+'">'+bar.task.property+'<\/span>';}
                        if(bar.task.project){var jc=TL2_PROJ_COLORS[bar.task.project]||'#6b7280';ph+='<span class="tl2-pill" style="background:'+hex2rgba(jc,0.12)+';color:'+jc+'">'+bar.task.project+'<\/span>';}
                        if(_spN){ph+='<span class="tl2-pill" style="background:'+hex2rgba('#f59e0b',0.14)+';color:#b45309">⚡ '+_spN+'<\/span>';}
                        if(ph)html+='<div class="tl2-bar-pills">'+ph+'<\/div>';
                        html+='<\/div>';
                    }
                    html+='<\/div><\/div>';
                }
                html+='<\/div>';
                document.getElementById('tl2-scroll').innerHTML=html;
            }
            // Week mode: tasks WITH dates are placed on their dates (original behavior).
            // Open tasks WITHOUT dates are scheduled back-to-back in assignment order,
            // 9 working hours per day, starting from today's column (or the range start).
            function renderWeek(){
                var from=pd(TL2_FROM),to=pd(TL2_TO);if(!from||!to)return;
                var days=[],d=new Date(from.getTime());while(d<=to){days.push(new Date(d.getTime()));d.setDate(d.getDate()+1);}
                var totalMs=to.getTime()+86400000-from.getTime();
                var DAYH=9,nDays=days.length,cap=nDays*DAYH;
                var today=new Date();today.setHours(0,0,0,0);
                var startCum=0;
                for(var di=0;di<nDays;di++){if(sameDay(days[di],today)){startCum=di*DAYH;break;}}
                var rows=buildRows(function(owner){
                    var bars=TL2_TASKS.filter(function(t){return ownerMatch(t.owner,owner)&&(t.startDate||t.endDate);}).map(function(t){var ts=pd(t.startDate)||pd(t.endDate),te=pd(t.endDate)||pd(t.startDate);if(!ts||!te)return null;var bs=Math.max(ts.getTime(),from.getTime()),be=Math.min(te.getTime()+86400000,to.getTime()+86400000);if(bs>=be)return null;return{lf:(bs-from.getTime())/totalMs,rt:(be-from.getTime())/totalMs,task:t};}).filter(function(x){return x!=null;});
                    var open=TL2_TASKS.filter(function(t){return ownerMatch(t.owner,owner)&&!DONE[t.status]&&!t.startDate&&!t.endDate;});
                    open.sort(function(a,b){return a.id-b.id;});
                    var cum=startCum;
                    for(var i=0;i<open.length;i++){
                        var t=open[i];
                        if(cum>=cap-0.001)cum=startCum;   // out of week — wrap; assignLanes stacks overlaps
                        var h=t.weight||1;if(h<0.5)h=0.5;
                        var end=Math.min(cum+h,cap);
                        bars.push({lf:cum/cap,rt:end/cap,task:t,seq:i+1,
                                   tchip:(t.weight?(Math.round(t.weight*100)/100)+'h':'~1h')+(cum+h>cap?' · continues next week':'')});
                        cum+=h;
                    }
                    return bars;
                });
                renderGrid(days,function(day,tod){return{label:fmtDay(day),isNow:sameDay(day,tod),isHour:false};},rows);
            }
            // Today mode: each developer's OPEN tasks scheduled back-to-back in assignment
            // order (task id), each block as long as its hour estimate (default 1h, min 30m).
            // Work that doesn't fit in the day wraps to a second lane ("overflow").
            function renderDay(){
                var START=510,END=1050,SLOT=30,TOTAL=540;
                var slots=[],m=START;while(m<END){slots.push(m);m+=SLOT;}
                var now=new Date(),nowMin=now.getHours()*60+now.getMinutes();
                var rows=TL2_OWNERS.map(function(owner){
                    var open=TL2_TASKS.filter(function(t){return ownerMatch(t.owner,owner)&&!DONE[t.status];});
                    open.sort(function(a,b){return a.id-b.id;});
                    var bars=[],cur=START,lane=0;
                    for(var i=0;i<open.length;i++){
                        var t=open[i];
                        var mins=Math.round((t.weight||1)*60);if(mins<30)mins=30;
                        if(cur+mins>END&&cur>START){lane++;cur=START;}
                        var em=Math.min(cur+mins,END);
                        bars.push({lf:(cur-START)/TOTAL,rt:(em-START)/TOTAL,_lane:lane,seq:i+1,task:t,
                                   tchip:fmtTime(cur)+' – '+fmtTime(Math.min(cur+mins,END))+' · '+(t.weight?((Math.round(t.weight*100)/100)+'h'):'~1h')});
                        cur+=mins;
                    }
                    return{owner:owner,bars:bars,rowH:Math.max(64,(lane+1)*62+8)};
                });
                renderGrid(slots,function(slotMin){return{label:fmtTime(slotMin),isNow:(nowMin>=slotMin&&nowMin<slotMin+SLOT),isHour:(slotMin%60===0)};},rows);
                if(nowMin>=START&&nowMin<=END){var pct=(nowMin-START)/TOTAL*100;var cells=document.querySelectorAll('.tl2-days-cell');for(var ti=0;ti<cells.length;ti++){var ln=document.createElement('div');ln.className='tl2-now-line';ln.style.left=pct+'%';cells[ti].appendChild(ln);}}
            }
            window.tl2Apply=function(){var f=document.getElementById('tl2-from').value,t=document.getElementById('tl2-to').value;if(f&&t)window.location='/Tasks?view=team&tlfrom='+f+'&tlto='+t;};
            if(TL2_MODE==='today')renderDay();else renderWeek();
        })();
        </script>
    }

    @* ════════════════════ BACKLOG VIEW ════════════════════ *@
    @if (Model.ViewMode == "backlog")
    {
        <div class="space-y-3">
            <!-- Header row: sprint tabs + type filter + Plan Sprint button -->
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-semibold text-gray-700">Backlog</span>
                    <span id="bl-count" class="text-xs bg-gray-100 text-gray-500 font-semibold px-2 py-0.5 rounded-full"></span>
                    <span class="hidden sm:inline text-[11px] text-gray-400">unassigned work only · sprint items live on the Sprint Board</span>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-medium text-gray-500 mr-1">Type:</span>
                    @foreach (var (type, label, cls) in new[]{
                        ("","All","bg-gray-800 text-white"),
                        ("Epic","🟦 Epic","bg-blue-100 text-blue-700"),
                        ("Feature","🟩 Feature","bg-emerald-100 text-emerald-700"),
                        ("Story","📋 Story","bg-violet-100 text-violet-700"),
                        ("Task","✅ Task","bg-gray-100 text-gray-600"),
                        ("Bug","🐛 Bug","bg-red-100 text-red-600")})
                    {
                        <button class="bl-type-btn text-xs px-3 py-1 rounded-full font-medium transition-all @cls"
                                data-type="@type" onclick="_blSetType('@type')">@label</button>
                    }
                    <button id="bl-done-toggle" onclick="_blToggleDone()" title="Show or hide completed work"
                            class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg font-medium border border-gray-200 bg-white text-gray-500 hover:bg-gray-50 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span id="bl-done-toggle-label">Show completed</span>
                    </button>
                    <button id="bl-plan-btn" onclick="_blTogglePlan()"
                            class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg font-medium border border-gray-200 bg-white text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                        Plan Sprint
                    </button>
                </div>
            </div>

            <!-- Two-panel layout: backlog tree + optional sprint planning panel -->
            <div class="flex gap-3 items-start">
                <!-- Backlog tree (left, flex) -->
                <div class="flex-1 min-w-0">
                    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                        <div id="backlog-tree" class="divide-y divide-gray-50 min-h-[200px]"
                             ondragover="event.preventDefault()" ondrop="_blTreeDrop(event)">
                            <div class="flex items-center justify-center py-16 text-gray-400 text-sm gap-2">
                                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                                </svg>
                                Loading backlog…
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sprint planning panel (right, hidden by default) -->
                <div id="bl-plan-panel" class="w-72 hidden flex-shrink-0 sticky top-4">
                    <!-- rendered by _blRenderPlanPanel() -->
                </div>
            </div>
        </div>

        <style>
            .bl-drop-before { box-shadow: inset 0 2px 0 0 #3b82f6; }
            .bl-drop-after  { box-shadow: inset 0 -2px 0 0 #3b82f6; }
            .bl-plan-drop-active { border-color: #3b82f6 !important; background-color: #eff6ff !important; color: #2563eb !important; }
        </style>

        <script>
        // ── State ────────────────────────────────────────────────────────────
        let _blAllTasks    = [];   // all tasks (sprintFilter=all)
        let _blTasks       = [];   // filtered by current sprint tab
        let _blSprints     = [];
        let _blSprint      = 'all';
        let _blType        = '';
        let _blShowDone    = false;   // standard backlog hides completed work by default

        // Mirrors TaskStatusRules.IsDone — a task's completion state per item type.
        function _blIsDone(t) {
            switch (t.itemType) {
                case 'Task':    return t.status === 'Done';
                case 'Bug':
                case 'Story':
                case 'Feature': return t.status === 'Resolved' || t.status === 'Closed';
                case 'Epic':    return t.status === 'Closed';
                default:        return t.status === 'Done' || t.status === 'Resolved' || t.status === 'Closed';
            }
        }
        let _blExpanded    = new Set();
        let _blPlanOpen    = false;
        let _blPlanSprintId = null;
        let _blDragId      = null;
        let _blDragDepth   = -1;
        let _blDropTarget  = null;
        let _blDropBefore  = true;

        const _blTypeCfg = {
            Epic:    { cls:'bg-blue-100 text-blue-700',       lbl:'Epic'  },
            Feature: { cls:'bg-emerald-100 text-emerald-700', lbl:'Feat'  },
            Story:   { cls:'bg-violet-100 text-violet-700',   lbl:'Story' },
            Task:    { cls:'bg-gray-100 text-gray-600',       lbl:'Task'  },
            Bug:     { cls:'bg-red-100 text-red-600',         lbl:'Bug'   },
        };
        const _blChildType = { Epic:'Feature', Feature:'Story', Story:'Task' };

        // ── Load (always fetches all; client-side sprint filter) ──────────────
        async function _blLoad() {
            try {
                const r = await fetch('/Tasks/GetBacklog?sprintFilter=all');
                const d = await r.json();
                _blAllTasks = d.tasks;
                _blSprints  = d.sprints;
                _blFilterTasks();
                _blRenderSprintTabs();
                _blRender();
            } catch(e) {
                document.getElementById('backlog-tree').innerHTML =
                    `<div class="text-center py-12 text-red-400 text-sm">Error loading backlog — ${e.message}</div>`;
            }
        }

        function _blFilterTasks() {
            // Backlog shows ONLY tasks not assigned to any sprint. Anything already in a sprint
            // lives on the Sprint Board, never here.
            _blTasks = _blAllTasks.filter(t => !t.sprintId);
        }

        // ── Backlog count (unassigned items, respecting the "show completed" toggle) ──────────
        function _blRenderSprintTabs() {
            const el = document.getElementById('bl-count');
            if (!el) return;
            const visible = t => _blShowDone || !_blIsDone(t);
            el.textContent = _blAllTasks.filter(t => !t.sprintId && visible(t)).length;
        }

        function _blToggleDone() {
            _blShowDone = !_blShowDone;
            const btn = document.getElementById('bl-done-toggle');
            document.getElementById('bl-done-toggle-label').textContent = _blShowDone ? 'Hide completed' : 'Show completed';
            btn.classList.toggle('bg-blue-50', _blShowDone);
            btn.classList.toggle('text-blue-600', _blShowDone);
            btn.classList.toggle('border-blue-200', _blShowDone);
            btn.classList.toggle('text-gray-500', !_blShowDone);
            _blRenderSprintTabs();   // refresh the per-tab counts
            _blRender();
        }

        function _blSetType(val) {
            _blType = val;
            document.querySelectorAll('.bl-type-btn').forEach(b => {
                const active = b.dataset.type === val;
                b.classList.toggle('ring-2', active);
                b.classList.toggle('ring-offset-1', active);
                b.classList.toggle('ring-current', active);
            });
            _blRender();
        }

        // Default the backlog to the logged-in user's items; '' (All assignees) shows everyone.
        // Model.Owner is a comma-separated multi-select — match a task if it has ANY chosen assignee.
        const _blOwnerSet = (@Html.Raw(JsonSerializer.Serialize(Model.Owner ?? "")) || '')
            .split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
        function _blOwnerMatch(o){
            if (!_blOwnerSet.length) return true;
            const parts = (o || '').split(',').map(x => x.trim().toLowerCase());
            return _blOwnerSet.some(w => parts.includes(w));
        }

        // ── Tree render ───────────────────────────────────────────────────────
        function _blRender() {
            let tasks = _blType ? _blTasks.filter(t => t.itemType === _blType) : _blTasks;

            // Standard backlog: hide completed work unless "Show completed" is on. Keep the ancestor
            // chain of any not-done item so the Epic→Feature→Story→Task tree stays connected (a done
            // Epic still shows if it has unfinished descendants; a fully-done subtree is hidden).
            if (!_blShowDone) {
                const byId = {}; _blAllTasks.forEach(t => byId[t.id] = t);
                const keep = new Set();
                tasks.forEach(t => {
                    if (!_blIsDone(t)) {
                        let cur = t;
                        while (cur) { keep.add(cur.id); cur = cur.parentId ? byId[cur.parentId] : null; }
                    }
                });
                tasks = tasks.filter(t => keep.has(t.id));
            }

            // Owner filter: keep items assigned to the person(s) plus their ancestor chain (so the
            // Epic→Feature→Story→Task tree stays connected rather than orphaning children).
            if (_blOwnerSet.length) {
                const byId = {}; _blAllTasks.forEach(t => byId[t.id] = t);
                const keep = new Set();
                tasks.forEach(t => {
                    if (_blOwnerMatch(t.owner)) {
                        let cur = t;
                        while (cur) { keep.add(cur.id); cur = cur.parentId ? byId[cur.parentId] : null; }
                    }
                });
                tasks = tasks.filter(t => keep.has(t.id));
            }

            const map = {};
            tasks.forEach(t => map[t.id] = { ...t, children: [] });
            const roots = [];
            tasks.forEach(t => {
                if (t.parentId && map[t.parentId]) map[t.parentId].children.push(map[t.id]);
                else roots.push(map[t.id]);
            });

            const typeOrder = {Epic:0,Feature:1,Story:2,Task:3,Bug:4,'':5};
            const sortFn = (a,b) => {
                const ao = a.backlogOrder ?? 999999, bo = b.backlogOrder ?? 999999;
                if (ao !== bo) return ao - bo;
                return (typeOrder[a.itemType||'']??5) - (typeOrder[b.itemType||'']??5) || (a.goal||'').localeCompare(b.goal||'');
            };
            function sortTree(nodes) { nodes.sort(sortFn); nodes.forEach(n => sortTree(n.children)); }
            sortTree(roots);

            if (_blExpanded.size === 0) roots.forEach(n => { if(n.children.length) _blExpanded.add(n.id); });

            const container = document.getElementById('backlog-tree');
            if (!roots.length) {
                container.innerHTML = `<div class="text-center py-16 text-gray-400 text-sm">No ${_blShowDone ? '' : 'open '}items in this view<br><span class="text-xs text-gray-300">${_blShowDone ? 'Try a different sprint or type filter' : 'Everything here may be complete — click “Show completed” to see done work'}</span></div>`;
                return;
            }
            container.innerHTML = roots.map(n => _blNode(n, 0)).join('');
        }

        // ── Sprint-planning progress: count sprintable descendants (Story/Task/Bug)
        //    and how many are already assigned to a sprint. Walks _blAllTasks so the
        //    count stays correct even when the current tab filters children out ──
        function _blSprintProgress(node) {
            let total = 0, inSprint = 0;
            (function walk(pid) {
                _blAllTasks.forEach(t => {
                    if (t.parentId !== pid) return;
                    if (t.itemType !== 'Epic' && t.itemType !== 'Feature') {
                        total++;
                        if (t.sprintId) inSprint++;
                    }
                    walk(t.id);
                });
            })(node.id);
            return { total, inSprint };
        }

        // ── Node renderer ─────────────────────────────────────────────────────
        function _blNode(node, depth) {
            const hasKids  = node.children.length > 0;
            const expanded = _blExpanded.has(node.id);
            const tc       = _blTypeCfg[node.itemType] || { cls:'bg-gray-50 text-gray-400', lbl:'—' };
            const indent   = 12 + depth * 24;

            const sprint   = node.sprintId ? _blSprints.find(s => s.id === node.sprintId) : null;
            let sprintEl = sprint
                ? `<span class="hidden sm:inline text-[10px] px-1.5 py-0.5 rounded-full bg-blue-50 text-blue-600 shrink-0">${_esc(sprint.name)}</span>`
                : `<span class="hidden sm:inline text-[10px] text-gray-300 shrink-0">Backlog</span>`;

            // Epic/Feature: show sprint-planning progress (descendants in sprint) instead of "Backlog"
            if (node.itemType === 'Epic' || node.itemType === 'Feature') {
                const p = _blSprintProgress(node);
                if (p.total > 0) {
                    const pct = Math.round(p.inSprint / p.total * 100);
                    sprintEl = `<span class="hidden sm:flex items-center gap-1.5 shrink-0" title="${p.inSprint} of ${p.total} item(s) assigned to a sprint">
                        <span class="w-14 h-1.5 rounded-full bg-gray-100 overflow-hidden"><span class="block h-full rounded-full ${pct === 100 ? 'bg-green-400' : 'bg-blue-400'}" style="width:${pct}%"></span></span>
                        <span class="text-[10px] ${pct === 100 ? 'text-green-500 font-semibold' : 'text-gray-400'}">${p.inSprint}/${p.total}</span>
                    </span>`;
                } else {
                    sprintEl = `<span class="hidden sm:inline text-[10px] text-gray-300 shrink-0">No items</span>`;
                }
            }

            const ownerEl = (node.owner||'').split(',').map(o=>o.trim()).filter(Boolean).slice(0,2)
                .map(o=>_owAv(o,'20px')).join('');

            const childType = _blChildType[node.itemType] || '';
            const addBtn    = childType
                ? `<button onclick="event.stopPropagation();_blAddChild(${node.id},'${childType}')" class="opacity-0 group-hover:opacity-100 w-6 h-6 flex items-center justify-center rounded hover:bg-blue-50 text-gray-400 hover:text-blue-500 shrink-0 transition-all text-base leading-none" title="Add ${childType}">+</button>`
                : `<span class="w-6 shrink-0"></span>`;

            const taskJson = JSON.stringify(node).replace(/\\/g,'\\\\').replace(/"/g,'&quot;');

            // Quick assign button — shown when plan panel is open
            const canAssign = node.itemType !== 'Epic' && node.itemType !== 'Feature';
            const assignBtn = _blPlanOpen && canAssign
                ? (node.sprintId
                    ? `<button onclick="event.stopPropagation();_blRemoveFromSprint(${node.id})" class="opacity-0 group-hover:opacity-100 text-[10px] px-2 py-0.5 rounded bg-gray-100 text-gray-500 hover:bg-red-50 hover:text-red-500 shrink-0 transition-all" title="Move to Backlog">↩ Backlog</button>`
                    : `<button onclick="event.stopPropagation();_blQuickAssign(${node.id})" class="opacity-0 group-hover:opacity-100 text-[10px] px-2 py-0.5 rounded bg-blue-50 text-blue-600 hover:bg-blue-100 shrink-0 transition-all" title="Assign to selected sprint">→ Sprint</button>`)
                : '';

            // Drag attrs — root items get reorder ondragover/ondrop; all items are draggable for sprint assign
            const reorderAttrs = depth === 0
                ? `ondragover="_blRowDragOver(event,${node.id})" ondrop="_blRowDrop(event,${node.id})"`
                : '';

            let html = `<div class="backlog-row group flex items-center gap-2 py-2 pr-3 hover:bg-gray-50 transition-colors cursor-grab active:cursor-grabbing"
                             style="padding-left:${indent}px" data-bl-id="${node.id}" data-bl-depth="${depth}"
                             draggable="true"
                             ondragstart="_blDragStart(event,${node.id},${depth})"
                             ondragend="_blDragEnd(event)"
                             ${reorderAttrs}>
                <span class="w-4 text-center text-gray-300 text-[10px] shrink-0 ${hasKids?'cursor-pointer hover:text-gray-600':''}" onclick="${hasKids?`event.stopPropagation();_blToggle(${node.id})`:''}">
                    ${hasKids ? (expanded ? '▼' : '▶') : ''}
                </span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 ${tc.cls}">${tc.lbl}</span>
                <button class="flex-1 text-sm text-left text-gray-800 hover:text-blue-600 truncate" onclick='openCanvas(JSON.parse(this.dataset.task))' data-task="${taskJson}">${_esc(node.goal||'—')}</button>
                ${node.project  ? `<span class="hidden lg:inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 shrink-0 max-w-[110px] truncate cursor-pointer hover:bg-blue-100" title="Module: ${_esc(node.project)}" data-val="${_esc(node.project)}" onclick="event.stopPropagation();quickFilterModule(this.dataset.val,event)">${_esc(node.project)}</span>` : ''}
                ${node.property ? `<span class="hidden lg:inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200 shrink-0 max-w-[110px] truncate cursor-pointer hover:bg-purple-100" title="Client: ${_esc(node.property)}" data-val="${_esc(node.property)}" onclick="event.stopPropagation();quickFilterClient(this.dataset.val,event)">${_esc(node.property)}</span>` : ''}
                ${node.status?`<span class="hidden md:inline text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 shrink-0">${_esc(node.status)}</span>`:''}
                ${sprintEl}
                <div class="flex items-center gap-0.5 shrink-0">${ownerEl}</div>
                ${assignBtn}
                ${addBtn}
            </div>`;

            if (hasKids) {
                html += `<div id="bl-kids-${node.id}" class="${expanded?'':'hidden'}">${node.children.map(c=>_blNode(c,depth+1)).join('')}</div>`;
            }
            return html;
        }

        // ── Expand / collapse ─────────────────────────────────────────────────
        function _blToggle(id) {
            const el  = document.getElementById('bl-kids-' + id);
            const row = document.querySelector(`[data-bl-id="${id}"] span:first-child`);
            if (!el) return;
            const hide = !el.classList.contains('hidden');
            el.classList.toggle('hidden', hide);
            if (row) row.textContent = hide ? '▶' : '▼';
            if (hide) _blExpanded.delete(id); else _blExpanded.add(id);
        }

        function _blAddChild(parentId, childType) {
            openCanvas(null);
            setTimeout(() => {
                document.getElementById('cf-item-type-sel').value = childType;
                document.getElementById('cf-item-type').value     = childType;
                document.getElementById('cf-parent-id').value     = parentId;
                onItemTypeChange(childType);
                setTimeout(() => { document.getElementById('cf-parent-sel').value = String(parentId); }, 600);
            }, 80);
        }

        // ── Sprint Planning Panel ─────────────────────────────────────────────
        function _blTogglePlan() {
            _blPlanOpen = !_blPlanOpen;
            const panel = document.getElementById('bl-plan-panel');
            const btn   = document.getElementById('bl-plan-btn');
            panel.classList.toggle('hidden', !_blPlanOpen);
            btn.classList.toggle('bg-blue-50',     _blPlanOpen);
            btn.classList.toggle('text-blue-600',  _blPlanOpen);
            btn.classList.toggle('border-blue-200',_blPlanOpen);
            if (_blPlanOpen) {
                if (!_blPlanSprintId) {
                    const active = _blSprints.find(s => s.isActive);
                    if (active) _blPlanSprintId = active.id;
                }
                _blRenderPlanPanel();
            }
            _blRender(); // refresh rows to show/hide quick-assign buttons
        }

        function _blPlanSelectSprint(val) {
            _blPlanSprintId = val ? parseInt(val) : null;
            _blRenderPlanPanel();
        }

        function _blRenderPlanPanel() {
            const panel = document.getElementById('bl-plan-panel');
            if (!panel) return;
            const sprint      = _blPlanSprintId ? _blSprints.find(s => s.id === _blPlanSprintId) : null;
            const sprintItems = sprint ? _blAllTasks.filter(t => t.sprintId === sprint.id) : [];
            const pts         = sprintItems.reduce((s,t) => s + (t.weight||0), 0);

            const sprintOpts = _blSprints.map(s =>
                `<option value="${s.id}" ${_blPlanSprintId === s.id ? 'selected' : ''}>${s.isActive?'⚡ ':''}${_esc(s.name)}</option>`
            ).join('');

            const sd = sprint?.startDate ? String(sprint.startDate).slice(0,10) : null;
            const ed = sprint?.endDate   ? String(sprint.endDate).slice(0,10)   : null;
            const dateRow = sprint && (sd||ed)
                ? `<div class="flex justify-between mt-2 text-[10px] text-gray-400"><span>${sd||'—'} → ${ed||'—'}</span><span>${sprintItems.length} item${sprintItems.length!==1?'s':''} · ${pts}h</span></div>`
                : sprint ? `<div class="text-right mt-2 text-[10px] text-gray-400">${sprintItems.length} items · ${pts}h</div>` : '';

            const itemsHtml = sprintItems.length
                ? sprintItems.map(t => `
                    <div class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50 group/pi border-b border-gray-50 last:border-0">
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 ${_blTypeCfg[t.itemType]?.cls||'bg-gray-100 text-gray-500'}">${_blTypeCfg[t.itemType]?.lbl||'—'}</span>
                        <span class="flex-1 text-xs text-gray-700 truncate" title="${_esc(t.goal||'')}">${_esc(t.goal||'—')}</span>
                        ${t.weight ? `<span class="text-[10px] text-gray-400 shrink-0">${t.weight}h</span>` : ''}
                        <button onclick="_blRemoveFromSprint(${t.id})" class="opacity-0 group-hover/pi:opacity-100 text-gray-400 hover:text-red-500 text-sm shrink-0 transition-all" title="Move to Backlog">↩</button>
                    </div>`).join('')
                : `<div class="text-center py-8 text-xs text-gray-300 px-4">No items in this sprint<br>Drag rows here to assign</div>`;

            panel.innerHTML = `
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden flex flex-col" style="max-height:calc(100vh - 160px)">
                <div class="p-3 border-b border-gray-100 bg-gray-50 flex-shrink-0">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Sprint Plan</span>
                        <button onclick="_blTogglePlan()" class="text-gray-400 hover:text-gray-600 text-sm transition-colors leading-none">✕</button>
                    </div>
                    <select onchange="_blPlanSelectSprint(this.value)"
                            class="w-full border border-gray-200 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="">— Select Sprint —</option>
                        ${sprintOpts}
                    </select>
                    ${dateRow}
                </div>
                <div id="bl-plan-drop"
                     class="m-2 p-3 border-2 border-dashed rounded-lg text-xs text-center transition-all flex-shrink-0 ${sprint ? 'border-gray-200 text-gray-400' : 'border-gray-100 text-gray-300 cursor-not-allowed'}"
                     ondragover="_blPlanDragOver(event)" ondrop="_blDropOnSprint(event)" ondragleave="_blPlanDragLeave(event)">
                    ${sprint ? '⬇ Drop item here to add to sprint' : 'Select a sprint above'}
                </div>
                <div class="flex-1 overflow-y-auto">${itemsHtml}</div>
            </div>`;
        }

        // ── Drag & Drop ───────────────────────────────────────────────────────
        function _blDragStart(e, taskId, depth) {
            _blDragId    = taskId;
            _blDragDepth = depth;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', String(taskId));
            setTimeout(() => document.querySelector(`[data-bl-id="${taskId}"]`)?.classList.add('opacity-40'), 0);
        }

        function _blDragEnd(e) {
            if (_blDragId) document.querySelector(`[data-bl-id="${_blDragId}"]`)?.classList.remove('opacity-40');
            document.querySelectorAll('.bl-drop-before,.bl-drop-after').forEach(el => el.classList.remove('bl-drop-before','bl-drop-after'));
            _blDragId = null; _blDragDepth = -1; _blDropTarget = null;
        }

        // Drag over a root row — show reorder insertion indicator
        function _blRowDragOver(e, taskId) {
            if (!_blDragId || _blDragId === taskId || _blDragDepth !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            const el = document.querySelector(`[data-bl-id="${taskId}"]`);
            if (!el) return;
            const rect   = el.getBoundingClientRect();
            const before = e.clientY < rect.top + rect.height / 2;
            document.querySelectorAll('.bl-drop-before,.bl-drop-after').forEach(x => x.classList.remove('bl-drop-before','bl-drop-after'));
            el.classList.add(before ? 'bl-drop-before' : 'bl-drop-after');
            _blDropTarget = taskId;
            _blDropBefore = before;
        }

        async function _blRowDrop(e, taskId) {
            e.preventDefault();
            e.stopPropagation();
            document.querySelectorAll('.bl-drop-before,.bl-drop-after').forEach(x => x.classList.remove('bl-drop-before','bl-drop-after'));
            if (!_blDragId || _blDragId === taskId || _blDragDepth !== 0) return;

            // Compute current root ordering (same sort as _blRender)
            const roots = _blTasks.filter(t => !t.parentId || !_blAllTasks.find(x => x.id === t.parentId));
            roots.sort((a,b) => { const ao=a.backlogOrder??999999,bo=b.backlogOrder??999999; return ao!==bo?ao-bo:(a.goal||'').localeCompare(b.goal||''); });

            const dragIdx = roots.findIndex(t => t.id === _blDragId);
            if (dragIdx < 0) return;
            const [moved] = roots.splice(dragIdx, 1);
            const tgtIdx  = roots.findIndex(t => t.id === taskId);
            roots.splice(tgtIdx < 0 ? roots.length : (_blDropBefore ? tgtIdx : tgtIdx+1), 0, moved);

            // Update local order so re-render is instant
            roots.forEach((t,i) => {
                t.backlogOrder = i + 1;
                const at = _blAllTasks.find(x => x.id === t.id);
                if (at) at.backlogOrder = i + 1;
            });
            _blRender();

            // Persist
            try {
                await fetch('/Tasks/ReorderBacklog', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(roots.map(t => t.id))
                });
            } catch(err) { console.warn('ReorderBacklog failed', err); }
        }

        // Fallback drop on the container (ignored — row drops handle everything)
        function _blTreeDrop(e) { e.preventDefault(); }

        // Sprint panel drag handlers
        function _blPlanDragOver(e) {
            if (!_blPlanSprintId || !_blDragId) return;
            e.preventDefault();
            e.stopPropagation();
            e.currentTarget.classList.add('bl-plan-drop-active');
        }

        function _blPlanDragLeave(e) {
            e.currentTarget.classList.remove('bl-plan-drop-active');
        }

        async function _blDropOnSprint(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('bl-plan-drop-active');
            if (!_blPlanSprintId) return;
            const taskId = _blDragId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!taskId) return;
            await _blCheckOwnerThenAssign(taskId, _blPlanSprintId);
        }

        // Quick-assign button: assign to selected plan sprint, or remove if already in a sprint
        async function _blQuickAssign(taskId) {
            if (!_blPlanSprintId) {
                Swal.fire({ icon:'info', text:'Select a sprint in the Plan Sprint panel first.', timer:2000, showConfirmButton:false });
                return;
            }
            await _blCheckOwnerThenAssign(taskId, _blPlanSprintId);
        }

        // Req 2 & 4: check owner before sprint assignment; prompt if missing
        async function _blCheckOwnerThenAssign(taskId, sprintId) {
            const task = _blAllTasks.find(t => t.id === taskId);
            if (task && !task.owner) {
                const userOpts = (CV_USERS || []).map(u => `<option value="${u}">${u}</option>`).join('');
                const { value: chosenOwner, isConfirmed } = await Swal.fire({
                    title: 'Assign Owner',
                    html: `<p class="text-sm text-gray-600 mb-3">
                             <strong>${task.goal || 'This task'}</strong> has no owner.<br>
                             Assign an owner before adding to the sprint.
                           </p>
                           <select id="swal-owner-sel" class="swal2-input" style="width:90%;margin:0 auto;">
                             <option value="">— Select owner —</option>${userOpts}
                           </select>`,
                    showCancelButton: true,
                    confirmButtonText: 'Assign & Add to Sprint',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#94a3b8',
                    preConfirm: () => {
                        const v = document.getElementById('swal-owner-sel').value;
                        if (!v) { Swal.showValidationMessage('Please select an owner.'); return false; }
                        return v;
                    }
                });
                if (!isConfirmed || !chosenOwner) return;
                // Save owner first
                const fd = new FormData();
                fd.append('id', taskId);
                fd.append('owner', chosenOwner);
                fd.append('__RequestVerificationToken', document.querySelector('[name=__RequestVerificationToken]').value);
                const r = await fetch('/Tasks/QuickSetOwner', { method:'POST', body:fd });
                const d = await r.json();
                if (!d.success) { showToast(d.error || 'Could not set owner.', 'error'); return; }
                if (task) task.owner = chosenOwner;
                showToast(`Owner set to ${chosenOwner}.`, 'success');
            }
            await _blAssignToSprint(taskId, sprintId);
        }

        async function _blRemoveFromSprint(taskId) {
            await _blAssignToSprint(taskId, null);
        }

        async function _blAssignToSprint(taskId, sprintId) {
            const fd = new FormData();
            fd.append('taskId', taskId);
            if (sprintId) fd.append('sprintId', sprintId);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            try {
                const r = await fetch('/Tasks/AssignSprint', { method:'POST', body:fd });
                const d = await r.json();
                if (d.success) {
                    const at = _blAllTasks.find(x => x.id === taskId);
                    if (at) at.sprintId = sprintId || null;
                    _blFilterTasks();
                    _blRender();
                    if (_blPlanOpen) _blRenderPlanPanel();
                    // Req 6: capacity warning
                    if (d.capacityWarning)
                        Swal.fire({ icon:'warning', title:'Over capacity', text: d.capacityWarning, timer:4000, showConfirmButton:false });
                } else {
                    Swal.fire({ icon:'warning', text: d.error || 'Could not assign to sprint.', timer:2500, showConfirmButton:false });
                }
            } catch(err) { console.warn('AssignSprint failed', err); }
        }

        _blLoad();
        </script>
    }

    @* ════════════════════ SPRINT BOARD VIEW ════════════════════ *@
    @if (Model.ViewMode == "board")
    {
        <div class="space-y-3">
            <!-- Sprint selector tabs -->
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-medium text-gray-500 mr-1">Sprint:</span>
                <div id="bd-sprint-tabs" class="flex gap-1 flex-wrap">
                    <div class="h-7 w-40 bg-gray-100 animate-pulse rounded-full"></div>
                </div>
            </div>

            <!-- Active sprint info card -->
            <div id="bd-sprint-info" class="hidden bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl px-5 py-3 flex items-center gap-4 flex-wrap">
                <div class="flex-1 min-w-0">
                    <p id="bd-sprint-name" class="font-semibold text-sm"></p>
                    <p id="bd-sprint-dates" class="text-blue-200 text-xs mt-0.5"></p>
                    <p id="bd-sprint-goal" class="text-blue-100 text-xs mt-1 italic truncate"></p>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                    <div class="text-right">
                        <p id="bd-progress-label" class="text-xs text-blue-200 mb-1"></p>
                        <div class="w-32 h-2 bg-blue-800 rounded-full overflow-hidden">
                            <div id="bd-progress-bar" class="h-full bg-white rounded-full transition-all" style="width:0%"></div>
                        </div>
                    </div>
                    <button onclick="_bdToggleBurndown()" id="bd-burndown-btn"
                            class="flex items-center gap-1.5 text-xs px-3 py-1.5 bg-white/20 hover:bg-white/30 rounded-lg transition-colors font-medium">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
                        Burndown
                    </button>
                </div>
            </div>

            <!-- Burndown chart panel (hidden by default) -->
            <div id="bd-burndown-panel" class="hidden bg-white border border-gray-200 rounded-xl p-4">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-700">Sprint Burndown</h3>
                    <div class="flex items-center gap-3">
                        <div class="flex rounded-lg border border-gray-200 overflow-hidden text-xs">
                            <button id="bd-mode-tasks" onclick="_bdSetBurnMode('tasks')"
                                    class="px-2.5 py-1 bg-blue-600 text-white font-medium transition-colors">Tasks</button>
                            <button id="bd-mode-weight" onclick="_bdSetBurnMode('weight')"
                                    class="px-2.5 py-1 bg-white text-gray-500 hover:bg-gray-50 font-medium transition-colors">Hrs</button>
                        </div>
                        <button onclick="_bdToggleBurndown()" class="text-gray-400 hover:text-gray-600 text-xs">✕ Close</button>
                    </div>
                </div>
                <div style="height:220px;position:relative">
                    <canvas id="bd-burndown-chart"></canvas>
                </div>
            </div>

            <!-- Item type + Person filters -->
            <div class="flex items-center gap-4 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-medium text-gray-500 mr-1">Type:</span>
                    @foreach (var (type, label, cls) in new[]{
                        ("","All","bg-gray-800 text-white"),
                        ("Epic","🟦 Epic","bg-blue-100 text-blue-700"),
                        ("Feature","🟩 Feature","bg-emerald-100 text-emerald-700"),
                        ("Story","📋 Story","bg-violet-100 text-violet-700"),
                        ("Task","✅ Task","bg-gray-100 text-gray-600"),
                        ("Bug","🐛 Bug","bg-red-100 text-red-600")})
                    {
                        <button class="bd-type-btn text-xs px-3 py-1 rounded-full font-medium transition-all @cls"
                                data-type="@type" onclick="_bdSetType('@type')">@label</button>
                    }
                </div>
                <div class="flex items-center gap-2 ml-auto">
                    <span class="text-xs font-medium text-gray-500">Person:</span>
                    <select id="bd-person-filter" onchange="_bdFilterPerson(this.value)"
                            class="border border-gray-200 rounded-lg px-2 py-1 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="" selected="@(ownerSel.Count != 1 ? "selected" : null)">All</option>
                        @foreach (var o in Model.Owners)
                        {
                            <option value="@o.Name" selected="@(ownerSel.Count == 1 && ownerSel.Contains(o.Name) ? "selected" : null)">@o.Name</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Board columns — built dynamically from WorkStates (same set as the Kanban view) -->
            <div id="bd-columns" class="flex gap-3 overflow-x-auto pb-2 -mx-1 px-1" style="height:calc(100vh - 300px);min-height:420px"></div>
        </div>

        <script>
        let _bdTasks   = [];
        let _bdSprints = [];
        let _bdSprint  = 'active'; // 'active' | sprint id string
        let _bdType    = '';
        let _bdDragging = null;    // task id being dragged

        // Columns mirror the Kanban view: one column per WorkState (DB-driven, with the same
        // AllStatuses fallback the Kanban uses when WorkStates is empty). Each column is exactly
        // ONE status — dropping a card sets the task to that status, and the shared flow rule
        // (_isFlowMoveAllowed) rejects moves that aren't valid for the item type.
        let BOARD_COLS = [];   // [{ key, name, color }]
        function _bdSlug(s) { return 'c' + String(s).replace(/[^a-zA-Z0-9]/g, '_'); }
        function _bdInitCols() {
            if (BOARD_COLS.length) return;
            const src = (typeof _wsData !== 'undefined' && _wsData && _wsData.length)
                ? _wsData
                : ['New','To Do','Active','In Progress','Resolved','Done','Closed'].map(n => ({ name: n, color: '#94a3b8' }));
            BOARD_COLS = src.map(ws => ({ key: _bdSlug(ws.name), name: ws.name, color: ws.color || '#94a3b8' }));
        }
        // Statuses treated as terminal ("done") for the sprint progress bar / overdue styling.
        const BD_DONE = ['Done','Resolved','Closed'];
        const BD_TYPE_ICON = { Epic:'🟦', Feature:'🟩', Story:'📋', Task:'✅', Bug:'🐛' };
        const BD_PRI_CLS   = { P0:'bg-red-100 text-red-700', P1:'bg-orange-100 text-orange-700', P2:'bg-yellow-100 text-yellow-700', P3:'bg-gray-100 text-gray-600' };

        function _bdColFor(status) {
            _bdInitCols();
            const c = BOARD_COLS.find(c => c.name === status);
            return c ? c.key : (BOARD_COLS[0] ? BOARD_COLS[0].key : '');
        }

        // ── Load ──────────────────────────────────────────────────────────────
        async function _bdLoad() {
            const filter = _bdSprint === 'active' ? 'active' : _bdSprint;
            try {
                const r = await fetch('/Tasks/GetBacklog?sprintFilter=' + filter);
                const d = await r.json();
                _bdTasks   = d.tasks   || [];
                _bdSprints = d.sprints || [];
                _bdRenderSprintTabs();
                _bdUpdateInfo();
                _bdRender();
                if (_bdBurndownVisible) _bdLoadBurndown();
            } catch(e) { console.error(e); }
        }

        function _bdRenderSprintTabs() {
            const container = document.getElementById('bd-sprint-tabs');
            const active = _bdSprints.find(s => s.isActive);
            let html = `<button class="bd-sprint-btn text-xs px-3 py-1 rounded-full font-medium border transition-all ${_bdSprint==='active'?'bg-blue-600 text-white border-blue-600':'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}"
                onclick="_bdSetSprint('active')">⚡ Active Sprint</button>`;
            _bdSprints.forEach(s => {
                const sel = _bdSprint == s.id;
                html += `<button class="bd-sprint-btn text-xs px-3 py-1 rounded-full font-medium border transition-all ${sel?'bg-blue-600 text-white border-blue-600':'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}"
                    onclick="_bdSetSprint(${s.id})">${_esc(s.name)}</button>`;
            });
            html += `<button class="bd-sprint-btn text-xs px-3 py-1 rounded-full font-medium border transition-all ${_bdSprint==='backlog'?'bg-blue-600 text-white border-blue-600':'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}"
                onclick="_bdSetSprint('backlog')">Backlog</button>`;
            container.innerHTML = html;
        }

        function _bdUpdateInfo() {
            const activeSprint = _bdSprints.find(s => s.isActive);
            const info = document.getElementById('bd-sprint-info');
            if (!activeSprint || (_bdSprint !== 'active' && String(_bdSprint) !== String(activeSprint?.id))) {
                info.classList.add('hidden'); return;
            }
            info.classList.remove('hidden');
            document.getElementById('bd-sprint-name').textContent  = activeSprint.name;
            const fmtD = s => s ? s.split('T')[0] : null;
            const dates = [fmtD(activeSprint.startDate), fmtD(activeSprint.endDate)].filter(Boolean).join(' → ');
            document.getElementById('bd-sprint-dates').textContent = dates;
            document.getElementById('bd-sprint-goal').textContent  = activeSprint.goal || '';
            const total = _bdTasks.length;
            const done  = _bdTasks.filter(t => BD_DONE.includes(t.status)).length;
            document.getElementById('bd-progress-label').textContent = `${done} / ${total} done`;
            document.getElementById('bd-progress-bar').style.width   = total ? Math.round(done/total*100)+'%' : '0%';
        }

        function _bdRenderBoard() { _bdRender(); } // alias for external caller
        function _bdRender() {
            _bdInitCols();
            const wrap = document.getElementById('bd-columns');
            if (!wrap) return;
            let visible = _bdType ? _bdTasks.filter(t => t.itemType === _bdType) : _bdTasks;
            if (_bdOwnerFilter.length) {
                const wanted = _bdOwnerFilter.map(o => o.toLowerCase());
                visible = visible.filter(t => {
                    const parts = (t.owner || '').split(',').map(o => o.trim().toLowerCase());
                    return wanted.some(w => parts.includes(w));
                });
            }
            const _fmtH = v => { const n = Math.round(+(v) || 0); return `${n}h`; };
            const emptyHtml = `<div class="flex flex-col items-center justify-center py-10 text-gray-300 text-xs gap-1"><svg class="w-7 h-7 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"/></svg>No items</div>`;
            wrap.innerHTML = BOARD_COLS.map(col => {
                const cards = visible.filter(t => t.status === col.name);
                const estH  = cards.reduce((s, t) => s + (+(t.weight)      || 0), 0);
                const actH  = cards.reduce((s, t) => s + (+(t.actualHours) || 0), 0);
                const hoursTxt = cards.length ? `est: ${_fmtH(estH)}  act: ${_fmtH(actH)}` : '';
                const body  = cards.length ? cards.map(t => _bdCard(t)).join('') : emptyHtml;
                return `<div class="flex-1 min-w-[228px] h-full flex flex-col" data-col="${col.key}">
                    <div class="flex items-center justify-between px-3 py-2 rounded-t-xl bg-gray-50 border border-gray-200 border-b-0">
                        <div class="flex items-center gap-2 flex-wrap min-w-0">
                            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:${col.color}"></span>
                            <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide truncate">${_esc(col.name)}</span>
                            <span class="text-xs bg-gray-200 text-gray-600 font-semibold px-2 py-0.5 rounded-full">${cards.length || ''}</span>
                            <span class="text-[10px] text-gray-400">${hoursTxt}</span>
                        </div>
                        <button onclick="_bdAddTask('${col.key}')" title="Add task"
                                class="w-6 h-6 flex items-center justify-center rounded-md text-gray-400 hover:bg-gray-200 hover:text-gray-700 transition-colors text-lg leading-none flex-shrink-0">+</button>
                    </div>
                    <div id="bd-cards-${col.key}" class="bd-dropzone flex-1 min-h-0 space-y-2 p-2 border border-gray-200 border-t-0 rounded-b-xl bg-gray-50/60 overflow-y-auto"
                         ondragover="_bdDragOver(event)" ondrop="_bdDrop(event,'${col.key}')" ondragleave="_bdDragLeave(event)">${body}</div>
                </div>`;
            }).join('');
        }

        function _bdCard(t) {
            const icon   = BD_TYPE_ICON[t.itemType] || '◻';
            const priCls = BD_PRI_CLS[t.priority]  || 'bg-gray-100 text-gray-500';
            const owners = (t.owner || '').split(',').map(o => o.trim()).filter(Boolean);
            const avatars = owners.slice(0,3).map(o => _owAv(o, '22px', '-6px')).join('');
            const bdSp    = (t.sprintId != null) ? _bdSprints.find(s => s.id === t.sprintId) : null;
            const bdSpName = bdSp ? bdSp.name : '';
            // Req 10: overdue = has end date, past today, and not in a terminal status
            const today = new Date().toISOString().split('T')[0];
            const isOverdue = t.endDate && t.endDate < today && !['Done','Resolved','Closed'].includes(t.status);
            const borderCls = isOverdue ? 'border-red-300 bg-red-50/40' : 'border-gray-200';
            const overdueTag = isOverdue ? `<span class="text-[9px] font-bold text-red-500 uppercase tracking-wide">Overdue</span>` : '';
            return `<div class="bd-card bg-white border ${borderCls} rounded-xl p-3 cursor-pointer hover:shadow-md hover:border-blue-200 transition-all select-none"
                        draggable="true"
                        data-task-id="${t.id}"
                        ondragstart="_bdDragStart(event,${t.id})"
                        onclick="_bdOpenTask(${t.id})">
                <div class="flex items-start gap-2 mb-2">
                    <span class="text-sm flex-shrink-0 mt-0.5">${icon}</span>
                    <p class="text-sm font-medium text-gray-800 leading-snug flex-1 min-w-0">${_esc(t.goal || '—')}</p>
                </div>
                ${(t.project || t.property || bdSpName) ? `<div class="flex flex-wrap gap-1 mb-2">
                    ${t.project  ? `<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 max-w-[110px] truncate cursor-pointer hover:bg-blue-100" title="Module: ${_esc(t.project)}" data-val="${_esc(t.project)}" onclick="event.stopPropagation();quickFilterModule(this.dataset.val,event)">${_esc(t.project)}</span>` : ''}
                    ${t.property ? `<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200 max-w-[110px] truncate cursor-pointer hover:bg-purple-100" title="Client: ${_esc(t.property)}" data-val="${_esc(t.property)}" onclick="event.stopPropagation();quickFilterClient(this.dataset.val,event)">${_esc(t.property)}</span>` : ''}
                    ${bdSpName   ? `<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 max-w-[110px] truncate" title="Sprint: ${_esc(bdSpName)}">⚡ ${_esc(bdSpName)}</span>` : ''}
                </div>` : ''}
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] text-gray-400 font-mono">#${t.id}</span>
                    ${t.priority ? `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full ${priCls}">${_esc(t.priority)}</span>` : ''}
                    ${overdueTag}
                    <div class="flex ml-auto" style="margin-left:auto;padding-left:6px">${avatars}</div>
                </div>
            </div>`;
        }

        function _bdOpenTask(taskId) {
            const task = _bdTasks.find(t => t.id === taskId);
            if (task) openCanvas(task);
        }

        // ── Drag-and-drop ─────────────────────────────────────────────────────
        function _bdDragStart(event, taskId) {
            _bdDragging = taskId;
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', taskId);
            event.currentTarget.classList.add('opacity-50');
        }
        function _bdDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            event.currentTarget.classList.add('ring-2','ring-blue-400','ring-inset');
        }
        function _bdDragLeave(event) {
            event.currentTarget.classList.remove('ring-2','ring-blue-400','ring-inset');
        }
        async function _bdDrop(event, colKey) {
            event.preventDefault();
            event.currentTarget.classList.remove('ring-2','ring-blue-400','ring-inset');
            const taskId = _bdDragging || parseInt(event.dataTransfer.getData('text/plain'));
            _bdDragging = null;
            document.querySelectorAll('.bd-card').forEach(c => c.classList.remove('opacity-50'));
            if (!taskId) return;
            const task   = _bdTasks.find(t => t.id === taskId);
            if (!task) return;
            const col = BOARD_COLS.find(c => c.key === colKey);
            const newStatus = col ? col.name : null;
            if (!newStatus || task.status === newStatus) return;
            // HARD flow rule: block moves that don't follow the item type's flow.
            if (!_isFlowMoveAllowed(task.itemType || '', task.status, newStatus)) {
                const nxt = _allowedNext(task.itemType || '', task.status);
                showToast(`Can't move a ${task.itemType || 'item'} from ${task.status || '—'} to ${newStatus}.`
                    + (nxt.length ? ` Allowed: ${nxt.join(', ')}.` : ''), 'error');
                return;
            }
            // Require actual hours when dragging into done column
            let bdActualHours = null;
            if (_isDoneStatus(task.itemType || '', newStatus)) {
                const hrs = await _promptActualHours();
                if (hrs === false) return;
                bdActualHours = hrs;
            }
            const token = document.querySelector('#canvas-form input[name=__RequestVerificationToken]').value;
            const fd = new FormData();
            fd.append('id', taskId); fd.append('status', newStatus);
            if (bdActualHours !== null) fd.append('actualHours', bdActualHours);
            fd.append('__RequestVerificationToken', token);
            try {
                const r = await fetch('/Tasks/UpdateStatus', { method:'POST', body: fd });
                const j = await r.json();
                if (j.success) {
                    task.status = newStatus;
                    _bdUpdateInfo();
                    _bdRender();
                } else if (j.needActualHours) {
                    showToast('Enter actual hours before marking as done.', 'error');
                } else if (j.needOwner) {
                    const owner = await _promptAssignOwner(taskId, task.goal, newStatus);
                    if (owner) {
                        task.owner = owner;
                        const r2 = await fetch('/Tasks/UpdateStatus', { method:'POST', body: fd });
                        const j2 = await r2.json();
                        if (j2.success) {
                            task.status = newStatus;
                            _bdUpdateInfo();
                            _bdRender();
                            showToast(`Assigned to ${owner} and moved to ${newStatus}.`, 'success');
                        } else showToast(j2.error || 'Failed to update.', 'error');
                    }
                } else if (j.openChildren) {
                    if (await _confirmForceClose(j.openChildren)) {
                        fd.append('ForceClose', 'true');
                        const r2 = await fetch('/Tasks/UpdateStatus', { method:'POST', body: fd });
                        const j2 = await r2.json();
                        if (j2.success) {
                            task.status = newStatus;
                            _bdUpdateInfo();
                            _bdRender();
                        } else showToast(j2.error || 'Failed to update.', 'error');
                    }
                } else showToast(j.error || 'Failed to update.', 'error');
            } catch { showToast('Network error.', 'error'); }
        }

        function _bdSetSprint(val) { _bdSprint = val; _bdLoad(); }

        // ── Add task from column ──────────────────────────────────────────────
        function _bdAddTask(colKey) {
            _bdInitCols();
            const col = BOARD_COLS.find(c => c.key === colKey);
            const defaultStatus = col ? col.name : 'To Do';
            openCanvas(null);
            setTimeout(() => {
                const statusSel = document.getElementById('cf-status');
                if (statusSel) {
                    // Populate options if empty (new task has no item type yet)
                    if (!statusSel.options.length)
                        (BOARD_COLS.length ? BOARD_COLS.map(c => c.name)
                                           : ['New','To Do','Active','In Progress','Resolved','Done','Closed']).forEach(s => {
                            const o = document.createElement('option'); o.value = o.text = s;
                            statusSel.appendChild(o);
                        });
                    statusSel.value = defaultStatus;
                }
                // Pre-set sprint to currently selected sprint
                const activeSprint = _bdSprints.find(s => s.isActive);
                const sprintId = _bdSprint === 'active' ? activeSprint?.id
                               : (_bdSprint !== 'backlog' ? _bdSprint : null);
                if (sprintId) {
                    const sprintHidden = document.getElementById('cf-sprint-id');
                    if (sprintHidden) sprintHidden.value = sprintId;
                    const sprintSel = document.getElementById('cf-sprint-sel');
                    if (sprintSel) sprintSel.value = sprintId;
                }
            }, 100);
        }

        // ── Burndown chart ────────────────────────────────────────────────────
        let _bdChart = null;
        let _bdBurndownVisible = false;
        let _bdBurnMode = 'tasks';
        let _bdLastBurnData = null;

        function _bdSetBurnMode(mode) {
            _bdBurnMode = mode;
            document.getElementById('bd-mode-tasks').className =
                'px-2.5 py-1 font-medium transition-colors ' + (mode === 'tasks' ? 'bg-blue-600 text-white' : 'bg-white text-gray-500 hover:bg-gray-50');
            document.getElementById('bd-mode-weight').className =
                'px-2.5 py-1 font-medium transition-colors ' + (mode === 'weight' ? 'bg-blue-600 text-white' : 'bg-white text-gray-500 hover:bg-gray-50');
            if (_bdLastBurnData) _bdRenderBurndown(_bdLastBurnData);
        }

        function _bdToggleBurndown() {
            _bdBurndownVisible = !_bdBurndownVisible;
            const panel = document.getElementById('bd-burndown-panel');
            panel.classList.toggle('hidden', !_bdBurndownVisible);
            if (_bdBurndownVisible) _bdLoadBurndown();
        }

        async function _bdLoadBurndown() {
            const activeSprint = _bdSprints.find(s => s.isActive);
            const sprintId = _bdSprint === 'active' ? activeSprint?.id
                           : (_bdSprint !== 'backlog' && _bdSprint ? _bdSprint : activeSprint?.id);
            if (!sprintId) {
                document.getElementById('bd-burndown-chart').closest('div').innerHTML =
                    '<p class="text-xs text-gray-400 text-center py-8">Select a sprint to view burndown.</p>';
                return;
            }
            try {
                const r = await fetch('/Tasks/GetBurndown?sprintId=' + sprintId);
                if (!r.ok) { showToast('No burndown data yet.', 'info'); return; }
                const d = await r.json();
                _bdLastBurnData = d;
                _bdRenderBurndown(d);
            } catch { showToast('Could not load burndown.', 'error'); }
        }

        function _bdRenderBurndown(d) {
            const ctx = document.getElementById('bd-burndown-chart');
            if (!ctx) return;
            if (_bdChart) { _bdChart.destroy(); _bdChart = null; }
            const useWeight = _bdBurnMode === 'weight' && (d.weightDays || []).length > 0;
            const labels = (useWeight ? d.weightDays : d.days).map(x => x.date);
            const actual = (useWeight ? d.weightDays : d.days).map(x => x.remaining);
            const ideal  = (useWeight ? d.weightIdeal : d.ideal).map(x => x.remaining);
            const yLabel = useWeight ? 'Hours remaining' : 'Tasks remaining';
            _bdChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: 'Ideal', data: ideal, borderColor: '#94a3b8', borderDash: [5,4], borderWidth: 1.5, pointRadius: 0, tension: 0, fill: false },
                        { label: 'Actual', data: actual, borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,0.07)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#2563eb', tension: 0.3, fill: true },
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { font: { size: 11 }, boxWidth: 20 } },
                               tooltip: { callbacks: { label: c => `${c.dataset.label}: ${c.parsed.y}${useWeight ? 'h' : ''} remaining` } } },
                    scales: {
                        x: { ticks: { font: { size: 10 }, maxRotation: 45 }, grid: { color: '#f1f5f9' } },
                        y: { beginAtZero: true, ticks: { font: { size: 10 } }, grid: { color: '#f1f5f9' },
                             title: { display: true, text: yLabel, font: { size: 10 }, color: '#94a3b8' } }
                    }
                }
            });
        }
        // ─────────────────────────────────────────────────────────────────────

        function _bdSetType(type) {
            _bdType = type;
            document.querySelectorAll('.bd-type-btn').forEach(b => {
                const isActive = b.dataset.type === type;
                b.style.opacity = isActive ? '1' : '0.45';
            });
            _bdRender();
        }

        // ── SignalR: live card movement ───────────────────────────────────────
        const _bdPrevOnTaskUpdated = window.onTaskUpdated;
        window.onTaskUpdated = function(data) {
            if (_bdPrevOnTaskUpdated) _bdPrevOnTaskUpdated(data);
            const t = _bdTasks.find(t => t.id === data.id);
            if (!t) return;
            t.status = data.status; t.priority = data.priority; t.owner = data.owner;
            _bdUpdateInfo(); _bdRender();
        };

        // Auto-load — defer to DOMContentLoaded so helpers defined in later script blocks
        // (e.g. _esc) are parsed before the board renders; otherwise a fast backlog fetch can
        // win the race and _bdRenderSprintTabs throws "_esc is not defined".
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => _bdLoad());
        else _bdLoad();
        </script>
    }

</div>

<script>
const CV_ME     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myDisplayName));
const CV_COLORS  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ownerColorMap));
const CV_IMAGES  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ownerImageMap));

function _owAv(o, sz, ml) {
    sz = sz || '22px';
    var img = CV_IMAGES && CV_IMAGES[o];
    var style = 'width:' + sz + ';height:' + sz + ';border-radius:50%;border:2px solid #fff;flex-shrink:0;' + (ml ? 'margin-left:' + ml + ';' : '');
    if (img) return '<img src="' + img.replace(/"/g,'&quot;') + '" style="' + style + 'object-fit:cover;" title="' + _esc(o) + '" />';
    var clr = (CV_COLORS && CV_COLORS[o]) || '#094f70';
    return '<div style="' + style + 'background:' + clr + ';color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;">' + ((o[0] || '?').toUpperCase()) + '<\/div>';
}
const CV_ADMIN  = @Html.Raw(User.IsInRole("Admin") ? "true" : "false");
const CV_LEAD   = @Html.Raw(User.FindFirst("TeamRole")?.Value is "TeamAdmin" or "TeamLead" ? "true" : "false");
// Mirrors the server's CanModifyAsync bypass (IsTeamAdmin = System Admin OR team-role TeamAdmin).
// Used for the "edit any task" gate so Team Admins get the edit form, not just System Admins.
const CV_TEAM_ADMIN = @Html.Raw(User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value == "TeamAdmin" ? "true" : "false");
const CV_USERS  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Owners.Select(o => o.Name).Where(n => !string.IsNullOrEmpty(n)).ToList(),
    jsonOpts));
const CV_USER_COLORS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Owners.Where(o => !string.IsNullOrEmpty(o.Name))
               .ToDictionary(o => o.Name!, o => o.Color ?? "#094f70"),
    jsonOpts));

// Statuses available per item type — built from WorkStates.ItemTypes (DB-driven, null = all types)
const ITEM_STATUSES = (() => {
    const ws = @Html.Raw(workStatesJson);
    const types = ['Epic', 'Feature', 'Story', 'Task', 'Bug'];
    const map = { '': ws.map(w => w.name) };
    types.forEach(t => {
        map[t] = ws
            .filter(w => !w.itemTypes || w.itemTypes.split(',').map(s => s.trim()).includes(t))
            .map(w => w.name);
    });
    return map;
})();
// Valid parent type for each item type
const PARENT_TYPE = { Feature: 'Epic', Story: 'Feature', Task: 'Story', Bug: 'Story' };

// FORWARD-ONLY status flow (mirrors TaskStatusRules server-side). From any status you may
// jump to ANY later status in the type's order (skips allowed, e.g. "To Do" → "Done") or to
// "Blocked"; backward moves are rejected. Blocked resumes to any status. HARD rule for all roles.
const FLOW_ORDER = {
    Task:    ['To Do', 'In Progress', 'Development Done', 'In QA', 'Done'],
    Bug:     ['New', 'Active', 'Resolved', 'Closed'],
    Story:   ['New', 'Active', 'Resolved', 'Closed'],
    Feature: ['New', 'Active', 'Resolved', 'Closed'],
    Epic:    ['New', 'Active', 'Closed'],   // no Blocked side-state
};
// Derive from→[reachable] maps: each status maps to all LATER statuses (+ Blocked); Blocked maps
// to the whole flow (resume anywhere). Keys stay the full status list so callers can enumerate them.
const ALLOWED_TRANSITIONS = (() => {
    const out = {};
    for (const [type, flow] of Object.entries(FLOW_ORDER)) {
        const hasBlocked = type !== 'Epic';
        const m = {};
        flow.forEach((s, i) => { m[s] = hasBlocked ? [...flow.slice(i + 1), 'Blocked'] : flow.slice(i + 1); });
        if (hasBlocked) m['Blocked'] = flow.slice();
        out[type] = m;
    }
    return out;
})();

// Initial status per item type — the only status a NEW item may be created in.
const INITIAL_STATUS = { Task: 'To Do', Bug: 'New', Story: 'New', Feature: 'New', Epic: 'New', '': 'New' };
// A status move is valid only if it stays put or advances forward in the item type's flow.
// HARD rule for everyone (no admin bypass) — mirrors the server-side guard.
function _isFlowMoveAllowed(itemType, from, to) {
    if (!from || from === to) return true;
    const next = (ALLOWED_TRANSITIONS[itemType] || {})[from];
    if (!next) return true;          // unknown / legacy source status — don't trap (mirrors server)
    return next.includes(to);
}
function _allowedNext(itemType, from) {
    return (ALLOWED_TRANSITIONS[itemType] || {})[from] || [];
}
</script>

<!-- ═══ OFF-CANVAS BACKDROP ═══ -->
<div id="canvas-backdrop"
     class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
