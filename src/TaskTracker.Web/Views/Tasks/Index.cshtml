        text: `${count} child item(s) are not yet complete. Close this item anyway?`,
        showCancelButton: true, confirmButtonText: 'Close anyway', cancelButtonText: 'Cancel',
        confirmButtonColor: '#d33'
    });
    return res.isConfirmed;
}

