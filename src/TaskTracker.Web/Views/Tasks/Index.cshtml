                @if (User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value is "TeamAdmin" or "TeamLead")
                {
                    @* Admin / Team Admin / Team Lead: searchable multi-select picker to assign anyone *@
                    <div id="cf-owner-picker" class="relative">
                        <div id="cf-owner-trigger"
                             onclick="toggleOwnerPicker()"
                             class="min-h-[38px] w-full border border-gray-200 rounded-lg px-2 py-1.5 flex flex-wrap gap-1 items-center cursor-pointer hover:border-blue-400 bg-white transition-colors">
                            <span id="cf-owner-placeholder" class="text-gray-400 text-sm px-1">Select owner(s)…</span>
                            <svg class="w-3.5 h-3.5 text-gray-400 ml-auto flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </div>
                        <div id="cf-owner-panel"
                             class="hidden absolute z-[200] left-0 right-0 mt-1 bg-white border border-gray-200 rounded-xl shadow-xl overflow-hidden">
                            <div class="p-2 border-b border-gray-100">
                                <input id="cf-owner-search" type="text" placeholder="Search…"
                                       oninput="_filterOwners(this.value)"
                                       onclick="event.stopPropagation()"
                                       class="w-full text-sm px-3 py-1.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                            <ul id="cf-owner-items" class="max-h-44 overflow-y-auto py-1"></ul>
                        </div>
                    </div>
                    <select id="cf-owner-sel" class="hidden" multiple>
                        @foreach (var o in Model.Owners) {
                            <option value="@o.Name">@o.Name</option>
                        }
                    </select>
                }
                else
                {
                    @* Non-admin: always themselves, read-only *@
                    <div id="cf-owner-display"
                         class="w-full border border-gray-100 bg-gray-50 rounded-lg px-3 py-2 text-sm text-gray-700 flex items-center gap-2">
                        @Html.Raw(AvatarEl(myDisplayName, ownerColorMap, ownerImageMap, "w-[22px] h-[22px]", "text-xs"))
