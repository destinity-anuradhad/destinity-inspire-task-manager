<style>@@keyframes slideInToast{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}</style>
<!-- ═══ OFF-CANVAS PANEL ═══ -->
<div id="task-canvas"
     class="fixed inset-y-0 right-0 w-full max-w-2xl lg:max-w-3xl bg-white shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
