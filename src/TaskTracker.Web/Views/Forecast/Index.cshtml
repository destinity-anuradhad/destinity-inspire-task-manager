@using TaskTracker.Services
@model VelocityForecast
@{
    ViewData["Title"] = "Forecast";
    string Sprints(int? n) => n is null ? "—" : (n == 0 ? "done" : $"{n} sprint{(n == 1 ? "" : "s")}");
}

<div class="max-w-4xl mx-auto mt-10 px-4 pb-16">
    <div class="mb-6">
        <h1 class="text-xl font-bold text-gray-900">Delivery forecast</h1>
        <p class="text-sm text-gray-500 mt-1">
            Projected sprints to clear the remaining backlog for @ViewBag.ActiveTeam, from historical velocity.
        </p>
    </div>

    @if (!Model.HasEnoughData)
    {
        <div class="px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">
            Not enough history to forecast yet. Complete at least one sprint with story-point work to
            establish a velocity baseline.
            @if (Model.RemainingPoints > 0)
            {
                <span class="block mt-1 text-amber-700">Remaining backlog: <strong>@Model.RemainingPoints pts</strong>.</span>
            }
        </div>
    }
    else
    {
        <div class="grid sm:grid-cols-3 gap-3 mb-6">
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">@Model.RemainingPoints</div>
                <div class="text-xs text-gray-500 mt-1">Remaining points</div>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">@Model.AverageVelocity</div>
                <div class="text-xs text-gray-500 mt-1">Avg velocity (@Model.CompletedSprintsUsed sprints)</div>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-[#094f70]">@Sprints(Model.ProjectedSprintsExpected)</div>
                <div class="text-xs text-gray-500 mt-1">Projected (expected)</div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6">
            <p class="text-sm font-semibold text-gray-800 mb-3">Projection range</p>
            <div class="flex items-center justify-between text-sm">
                <div>
                    <div class="text-green-600 font-bold text-lg">@Sprints(Model.ProjectedSprintsOptimistic)</div>
                    <div class="text-xs text-gray-500">Optimistic (@Model.MaxVelocity pts/sprint)</div>
                </div>
                <div class="text-center">
                    <div class="text-[#094f70] font-bold text-lg">@Sprints(Model.ProjectedSprintsExpected)</div>
                    <div class="text-xs text-gray-500">Expected (@Model.AverageVelocity pts/sprint)</div>
                </div>
                <div class="text-right">
                    <div class="text-amber-600 font-bold text-lg">@Sprints(Model.ProjectedSprintsPessimistic)</div>
                    <div class="text-xs text-gray-500">Pessimistic (@Model.MinVelocity pts/sprint)</div>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
            <div class="px-6 py-3 border-b border-gray-100 bg-gray-50">
                <p class="text-sm font-semibold text-gray-800">Velocity history</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-gray-400 border-b border-gray-100">
                            <th class="px-6 py-3 font-medium">Sprint</th>
                            <th class="px-4 py-3 font-medium">Completed</th>
                            <th class="px-4 py-3 font-medium">Velocity (pts)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.History)
                        {
                            <tr class="border-b border-gray-50">
                                <td class="px-6 py-3 text-gray-800">@p.SprintName</td>
                                <td class="px-4 py-3 text-xs text-gray-500">@(p.CompletedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="px-4 py-3 font-medium text-gray-900">@p.CompletedEstimate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
