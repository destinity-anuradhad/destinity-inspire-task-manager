@using TaskTracker.Services
@model VelocityForecast
@{
    ViewData["Title"] = "Forecast";
    string Sprints(int? n) => n is null ? "—" : (n == 0 ? "done" : $"{n} sprint{(n == 1 ? "" : "s")}");
    string Acc(decimal est, decimal act) => est <= 0 ? "—" : $"{Math.Round(act / est * 100)}%";
}

<div class="max-w-4xl mx-auto mt-10 px-4 pb-16">
    <div class="mb-6">
        <h1 class="text-xl font-bold text-gray-900">Delivery forecast</h1>
        <p class="text-sm text-gray-500 mt-1">
            Projected sprints to clear the remaining backlog for @ViewBag.ActiveTeam, from historical
            velocity — <strong>estimate hours delivered per sprint</strong>. Actual logged hours are shown
            alongside as a reality check.
        </p>
    </div>

    @if (!Model.HasEnoughData)
    {
        <div class="px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">
            Not enough history to forecast yet. Complete at least one sprint with estimated work to
            establish a velocity baseline.
            @if (Model.RemainingHours > 0)
            {
                <span class="block mt-1 text-amber-700">Remaining backlog: <strong>@Model.RemainingHours hrs</strong>.</span>
            }
        </div>
    }
    else
    {
        <div class="grid sm:grid-cols-4 gap-3 mb-6">
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">@Model.RemainingHours</div>
                <div class="text-xs text-gray-500 mt-1">Remaining hours</div>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">@Model.AverageVelocity</div>
                <div class="text-xs text-gray-500 mt-1">Avg est. velocity (@Model.CompletedSprintsUsed sprints)</div>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-gray-700">@Model.AverageActualVelocity</div>
                <div class="text-xs text-gray-500 mt-1">Avg actual hrs / sprint</div>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-4 text-center">
                <div class="text-2xl font-bold text-[#094f70]">@Sprints(Model.ProjectedSprintsExpected)</div>
                <div class="text-xs text-gray-500 mt-1">Projected (expected)</div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6">
            <p class="text-sm font-semibold text-gray-800 mb-3">
                Projection range <span class="font-normal text-gray-400">— based on estimate-hour velocity</span>
            </p>
            <div class="flex items-center justify-between text-sm">
                <div>
                    <div class="text-green-600 font-bold text-lg">@Sprints(Model.ProjectedSprintsOptimistic)</div>
                    <div class="text-xs text-gray-500">Optimistic (@Model.MaxVelocity hrs/sprint)</div>
                </div>
                <div class="text-center">
                    <div class="text-[#094f70] font-bold text-lg">@Sprints(Model.ProjectedSprintsExpected)</div>
                    <div class="text-xs text-gray-500">Expected (@Model.AverageVelocity hrs/sprint)</div>
                </div>
                <div class="text-right">
                    <div class="text-amber-600 font-bold text-lg">@Sprints(Model.ProjectedSprintsPessimistic)</div>
                    <div class="text-xs text-gray-500">Pessimistic (@Model.MinVelocity hrs/sprint)</div>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
            <div class="px-6 py-3 border-b border-gray-100 bg-gray-50">
                <p class="text-sm font-semibold text-gray-800">Velocity history</p>
                <p class="text-xs text-gray-400 mt-0.5">
                    Estimate delivered vs actual hours logged per sprint. Accuracy = actual ÷ estimate
                    (over 100% = work took longer than estimated).
                </p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-gray-400 border-b border-gray-100">
                            <th class="px-6 py-3 font-medium">Sprint</th>
                            <th class="px-4 py-3 font-medium">Completed</th>
                            <th class="px-4 py-3 font-medium">Est. delivered (hrs)</th>
                            <th class="px-4 py-3 font-medium">Actual (hrs)</th>
                            <th class="px-4 py-3 font-medium">Accuracy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.History)
                        {
                            <tr class="border-b border-gray-50">
                                <td class="px-6 py-3 text-gray-800">@p.SprintName</td>
                                <td class="px-4 py-3 text-xs text-gray-500">@(p.CompletedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="px-4 py-3 font-medium text-gray-900">@p.CompletedEstimate</td>
                                <td class="px-4 py-3 text-gray-700">@p.ActualHours</td>
                                <td class="px-4 py-3 text-gray-500">@Acc(p.CompletedEstimate, p.ActualHours)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
