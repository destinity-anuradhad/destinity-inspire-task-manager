@model List<TaskTracker.Models.EmailOutboxMessage>
@{
    ViewData["Title"] = "Email Outbox";
    var pending = Model.Count(m => m.Status is "Pending" or "Processing");
    var deadLetters = Model.Count(m => m.Status == "DeadLetter");
}

<div class="max-w-6xl mx-auto space-y-5">
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Email Outbox</h1>
            <p>Delivery queue, retries, and dead-letter recovery</p>
        </div>
    </div>
    @if (TempData["Success"] != null) { <p class="text-sm text-green-700">@TempData["Success"]</p> }
    @if (TempData["Error"] != null) { <p class="text-sm text-red-700">@TempData["Error"]</p> }
    <div class="grid grid-cols-2 gap-4">
        <div class="bg-white border border-gray-200 rounded-xl p-4"><p class="text-xs text-gray-500">Pending / processing</p><p class="text-2xl font-bold text-gray-800">@pending</p></div>
        <div class="bg-white border border-gray-200 rounded-xl p-4"><p class="text-xs text-gray-500">Dead letters</p><p class="text-2xl font-bold @(deadLetters > 0 ? "text-red-600" : "text-gray-800")">@deadLetters</p></div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-left text-xs text-gray-500"><tr><th class="px-4 py-3">Created</th><th class="px-4 py-3">Recipient</th><th class="px-4 py-3">Subject</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Attempts</th><th class="px-4 py-3">Last error</th><th class="px-4 py-3"></th></tr></thead>
            <tbody class="divide-y divide-gray-100">
            @foreach (var message in Model)
            {
                <tr>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600">@message.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                    <td class="px-4 py-3"><div class="font-medium text-gray-800">@message.ToName</div><div class="text-xs text-gray-500">@message.ToEmail</div></td>
                    <td class="px-4 py-3 text-gray-700 max-w-xs truncate">@message.Subject</td>
                    <td class="px-4 py-3"><span class="text-xs font-semibold @(message.Status == "DeadLetter" ? "text-red-700" : message.Status == "Sent" ? "text-green-700" : "text-amber-700")">@message.Status</span></td>
                    <td class="px-4 py-3 text-gray-600">@message.AttemptCount</td>
                    <td class="px-4 py-3 text-xs text-red-600 max-w-xs truncate" title="@message.LastError">@message.LastError</td>
                    <td class="px-4 py-3">@if (message.Status == "DeadLetter") { <form method="post" action="/EmailOutbox/Replay">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@message.Id" /><button class="text-xs font-semibold text-blue-700 hover:text-blue-900">Replay</button></form> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
