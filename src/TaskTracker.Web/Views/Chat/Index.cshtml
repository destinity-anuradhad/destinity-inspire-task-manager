async function _chatLoadFiles(){
    const box=document.getElementById('chat-files-list'); box.innerHTML='<div class="text-center sk-muted text-sm py-8">Loading…</div>';
    try {
        const r=await fetch('/Chat/Attachments'); const files=await r.json();
        if(!files.length){ box.innerHTML='<div class="text-center sk-muted text-sm py-10">No files shared yet.</div>'; return; }
        const imgs=files.filter(f=>f.isImage), docs=files.filter(f=>!f.isImage);
        let html='';
        if(imgs.length){
            html+='<div class="px-3 pt-3 pb-1 text-[11px] font-semibold uppercase tracking-wide sk-faint">Images ('+imgs.length+')</div>';
            html+='<div class="grid grid-cols-3 gap-1 px-2">'+imgs.map(f=>`<img src="${_esc(f.url)}" onclick="_chatLightbox('${_esc(f.url)}')" class="w-full rounded cursor-zoom-in hover:brightness-95 transition" style="aspect-ratio:1;object-fit:cover" title="${_esc(f.fileName)}" alt="">`).join('')+'</div>';
        }
        if(docs.length){
            html+='<div class="px-3 pt-4 pb-1 text-[11px] font-semibold uppercase tracking-wide sk-faint">Files ('+docs.length+')</div>';
            html+=docs.map(f=>`<a href="${_esc(f.url)}" target="_blank" class="flex items-center gap-2.5 px-3 py-2 hover:bg-gray-50 transition"><svg class="w-8 h-8 shrink-0 sk-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg><span class="min-w-0"><span class="block text-[13px] font-medium sk-txt truncate">${_esc(f.fileName)}</span><span class="block text-[11px] sk-muted truncate">${_fmtSize(f.fileSize)} · ${_esc(f.senderName)}</span></span></a>`).join('');
        }
        box.innerHTML=html;
    } catch { box.innerHTML='<div class="text-center sk-muted text-sm py-8">Could not load files.</div>'; }
}

// ── Mute / settings ──────────────────────────────────────────────────────────
function _chatEventMuted(m){ return m.kind==='event' && !!(m.meta&&_chatMuted[m.meta.type]); }
function _applyMuteVisibility(){
    document.querySelectorAll('#chat-messages [data-evtype]').forEach(el => {
        el.style.display = _chatMuted[el.getAttribute('data-evtype')] ? 'none' : '';
    });
}
function _chatLoadSettings(){
    try { _chatMuted = Object.assign({assign:false,status:false,sprint:false}, JSON.parse(localStorage.getItem(_muteKey())||'{}')); } catch { _chatMuted={assign:false,status:false,sprint:false}; }
    const a=document.getElementById('set-assign'), s=document.getElementById('set-status'), p=document.getElementById('set-sprint'), al=document.getElementById('set-alerts');
    if(a) a.checked=!_chatMuted.assign; if(s) s.checked=!_chatMuted.status; if(p) p.checked=!_chatMuted.sprint;
    if(al) al.checked = localStorage.getItem('chatAlerts')!=='0';
}
function _chatSaveSettings(){
    _chatMuted={ assign:!document.getElementById('set-assign').checked, status:!document.getElementById('set-status').checked, sprint:!document.getElementById('set-sprint').checked };
    localStorage.setItem(_muteKey(), JSON.stringify(_chatMuted));
    const al=document.getElementById('set-alerts');
    localStorage.setItem('chatAlerts', al.checked?'1':'0');
    if(al.checked && 'Notification' in window && Notification.permission==='default') Notification.requestPermission();
    _applyMuteVisibility();
}
function _chatToggleSettings(ev){
    const el=document.getElementById('chat-settings');
    if(!el.classList.contains('hidden')){ el.classList.add('hidden'); return; }
    _chatLoadSettings(); el.classList.remove('hidden');
    const r=ev.currentTarget.getBoundingClientRect();
    el.style.top=(r.bottom+6)+'px'; el.style.left=Math.max(8,r.right-288)+'px';
}

// ── Lightbox ─────────────────────────────────────────────────────────────────
function _chatLightbox(url){ const lb=document.getElementById('chat-lightbox'); document.getElementById('chat-lightbox-img').src=url; lb.classList.remove('hidden'); }
function _chatCloseLightbox(){ document.getElementById('chat-lightbox').classList.add('hidden'); }

// ── Jump to latest ───────────────────────────────────────────────────────────
function _chatOnScroll(){ const l=document.getElementById('chat-messages'); if(_nearBottom(l)){ _chatNewCount=0; document.getElementById('chat-jump').classList.add('hidden'); } }
function _chatJumpToLatest(){ const l=document.getElementById('chat-messages'); l.scrollTo({top:l.scrollHeight,behavior:'smooth'}); _chatNewCount=0; document.getElementById('chat-jump').classList.add('hidden'); }
function _chatShowJump(){ const b=document.getElementById('chat-jump'); document.getElementById('chat-jump-label').textContent=_chatNewCount>0?`${_chatNewCount} new message${_chatNewCount>1?'s':''}`:'Latest'; b.classList.remove('hidden'); }

function _appendMessage(m, scroll, animate){
    if(_chatSeen.has(m.id)) return; _chatSeen.add(m.id);
    const list=document.getElementById('chat-messages');
    document.getElementById('chat-empty').classList.add('hidden'); document.getElementById('chat-welcome').classList.add('hidden');
    _chatTrackMember(m); _chatSeedReactions(m); _chatTypers.delete(m.senderName); _chatRenderTyping();
    const isEvent=m.kind==='event';
    const prevKey=_chatLastKey;
    const dayNew=!prevKey||(new Date(prevKey.ts).toDateString()!==new Date(m.createdAt).toDateString());
    const grouped=!isEvent && !dayNew && prevKey && prevKey.user===m.senderName && (new Date(m.createdAt)-new Date(prevKey.ts))<5*60*1000;
    if(dayNew) list.insertAdjacentHTML('beforeend', _dayDivider(m.createdAt));
    list.insertAdjacentHTML('beforeend', _msgHtml(m, grouped));
    const el=list.lastElementChild;
    if(animate) el?.classList.add('sk-pop-in');
    if(isEvent && _chatMuted[(m.meta&&m.meta.type)]) el.style.display='none';
    _chatRenderReactions(m.id);
    _chatLastKey=isEvent?null:{ user:m.senderName, ts:m.createdAt };
    if(scroll){ if(animate) list.scrollTo({top:list.scrollHeight,behavior:'smooth'}); else list.scrollTop=list.scrollHeight; }
    else if(animate && el.style.display!=='none'){ _chatNewCount++; _chatShowJump(); }
}

async function _chatLoadMembers(){
    try { const r=await fetch('/Chat/Members'); _chatMemberNames=await r.json(); } catch { _chatMemberNames=[]; }
    const names=[..._chatMemberNames].sort((a,b)=>b.length-a.length).map(_reEsc);
    _chatMentionRe=names.length?new RegExp('@@('+names.join('|')+')','gi'):null;
    _chatRenderMembers();
}
async function _chatLoadInitial(){
    try {
        const r=await fetch('/Chat/Messages'); const msgs=await r.json();
        document.getElementById('chat-loading').remove();
        if(!msgs.length) document.getElementById('chat-welcome').classList.remove('hidden');
        msgs.forEach(m=>_appendMessage(m,false));
        if(msgs.length) _chatOldestId=msgs[0].id;
        if(msgs.length>=30) document.getElementById('chat-loadolder').classList.remove('hidden');
        _applyMuteVisibility();
        const l=document.getElementById('chat-messages'); l.scrollTop=l.scrollHeight;
    } catch(e){ document.getElementById('chat-loading').textContent='Could not load messages.'; }
}
async function _chatLoadOlder(){
    if(!_chatOldestId) return;
    const list=document.getElementById('chat-messages'); const prevH=list.scrollHeight;
    const r=await fetch('/Chat/Messages?before='+_chatOldestId); const msgs=await r.json();
    if(!msgs.length){ document.getElementById('chat-loadolder').classList.add('hidden'); return; }
    const anchor=document.getElementById('chat-loadolder'); let prev=null; const frag=document.createElement('div'); const seeded=[];
    msgs.forEach(m=>{
        if(_chatSeen.has(m.id)) return; _chatSeen.add(m.id); _chatTrackMember(m); _chatSeedReactions(m); seeded.push(m.id);
        const isEvent=m.kind==='event';
        const dayNew=!prev||(new Date(prev.ts).toDateString()!==new Date(m.createdAt).toDateString());
        const grouped=!isEvent && !dayNew && prev && prev.user===m.senderName && (new Date(m.createdAt)-new Date(prev.ts))<5*60*1000;
        if(dayNew) frag.insertAdjacentHTML('beforeend', _dayDivider(m.createdAt));
        frag.insertAdjacentHTML('beforeend', _msgHtml(m, grouped));
        prev=isEvent?null:{ user:m.senderName, ts:m.createdAt };
    });
    anchor.after(...frag.childNodes);
    seeded.forEach(id=>_chatRenderReactions(id)); _applyMuteVisibility();
    _chatOldestId=msgs[0].id;
    if(msgs.length<30) document.getElementById('chat-loadolder').classList.add('hidden');
    list.scrollTop=list.scrollHeight-prevH;
}

// ── Composer ─────────────────────────────────────────────────────────────────
function _chatAutoGrow(t){ t.style.height='auto'; t.style.height=Math.min(t.scrollHeight,160)+'px'; }
function _chatOnInput(t){ _chatAutoGrow(t); _chatMentionScan(); _chatTypingPing(); }
function _chatKeydown(e){
    if(_chatMention.open){
        if(e.key==='ArrowDown'){e.preventDefault();_chatMention.index=(_chatMention.index+1)%_chatMention.matches.length;_chatMentionRender();return;}
        if(e.key==='ArrowUp'){e.preventDefault();_chatMention.index=(_chatMention.index-1+_chatMention.matches.length)%_chatMention.matches.length;_chatMentionRender();return;}
        if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();_chatMentionPick(_chatMention.index);return;}
        if(e.key==='Escape'){e.preventDefault();_chatMentionClose();return;}
    }
    if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); _chatSend(); }
}
function _chatAddFiles(fl){ for(const f of fl){ if(f.size>10*1024*1024){_chatToast(`'${f.name}' exceeds 10 MB`);continue;} _chatPending.push(f);} _chatRenderFiles(); }
function _chatRenderFiles(){
    const box=document.getElementById('chat-files'); box.classList.toggle('hidden',_chatPending.length===0);
    box.innerHTML=_chatPending.map((f,i)=>`<span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs" style="background:#f1f2f3;color:#1d1c1d;border:1px solid #e0e0e0"><span class="max-w-[160px] truncate">${_esc(f.name)}</span><span class="text-[10px] sk-muted">${_fmtSize(f.size)}</span><button onclick="_chatRemoveFile(${i})" class="sk-muted hover:text-red-500 text-sm leading-none">&times;</button></span>`).join('');
}
function _chatRemoveFile(i){ _chatPending.splice(i,1); _chatRenderFiles(); }
async function _chatSend(){
    const input=document.getElementById('chat-input'); const body=input.value.trim();
    if(!body&&_chatPending.length===0) return;
    const btn=document.getElementById('chat-send'); btn.disabled=true;
    const fd=new FormData(); fd.append('body',body); _chatPending.forEach(f=>fd.append('files',f)); fd.append('__RequestVerificationToken',_chatToken);
    try { const r=await fetch('/Chat/Send',{method:'POST',body:fd}); const d=await r.json();
        if(d.success){ input.value=''; _chatAutoGrow(input); _chatMentionClose(); _chatPending=[]; _chatRenderFiles(); if(d.message) _appendMessage(d.message,true,true); }
        else _chatToast(d.error||'Could not send.'); }
    catch { _chatToast('Network error.'); }
    finally { btn.disabled=false; input.focus(); }
}
async function _chatDelete(id){
    const fd=new FormData(); fd.append('id',id); fd.append('__RequestVerificationToken',_chatToken);
    const r=await fetch('/Chat/Delete',{method:'POST',body:fd}); const d=await r.json(); if(!d.success) _chatToast(d.error||'Could not delete.');
}
function _chatMarkDeleted(id){
    const row=document.querySelector(`.chat-msg[data-id="${id}"]`); if(!row) return;
    const b=row.querySelector(`.chat-body[data-id="${id}"]`); if(b) b.innerHTML='<span class="text-[13px] italic sk-muted">message deleted</span>';
    row.querySelector('.sk-actions')?.remove(); row.querySelector('.chat-reactions')?.remove();
}

// ── @@mention autocomplete ────────────────────────────────────────────────────
function _chatMentionScan(){
    const inp=document.getElementById('chat-input'); const pos=inp.selectionStart;
    const mm=inp.value.slice(0,pos).match(/@@([^\s@@]*)$/);
    if(!mm||!_chatMemberNames.length){ _chatMentionClose(); return; }
    const frag=mm[1].toLowerCase(); const matches=_chatMemberNames.filter(n=>n.toLowerCase().includes(frag)).slice(0,8);
    if(!matches.length){ _chatMentionClose(); return; }
    _chatMention={open:true,index:0,matches,start:pos-mm[0].length}; _chatMentionRender();
}
function _chatMentionRender(){
    const pop=document.getElementById('chat-mention-pop');
    pop.innerHTML=_chatMention.matches.map((n,i)=>`<div class="sk-mrow ${i===_chatMention.index?'active':''}" data-mention="${i}"><div class="w-6 h-6 rounded-md flex items-center justify-center text-white text-[10px] font-semibold shrink-0" style="background:#094f70">${_esc(_initials(n))}</div><span class="truncate text-[14px]">${_esc(n)}</span></div>`).join('');
    pop.classList.remove('hidden');
}
function _chatMentionClose(){ _chatMention.open=false; document.getElementById('chat-mention-pop')?.classList.add('hidden'); }
function _chatMentionPick(i){
    const inp=document.getElementById('chat-input'); const name=_chatMention.matches[i]; if(name==null) return;
    const before=inp.value.slice(0,_chatMention.start); const after=inp.value.slice(inp.selectionStart); const insert='@@'+name+' ';
    inp.value=before+insert+after; const caret=(before+insert).length; inp.focus(); inp.setSelectionRange(caret,caret);
    _chatMentionClose(); _chatAutoGrow(inp);
}

// ── Emoji insert ─────────────────────────────────────────────────────────────
function _chatToggleEmojiInsert(anchor){
    let pop=document.getElementById('chat-emoji-insert');
    if(pop&&!pop.classList.contains('hidden')){ pop.classList.add('hidden'); return; }
    if(!pop){ pop=document.createElement('div'); pop.id='chat-emoji-insert'; pop.className='sk-pop hidden'; document.body.appendChild(pop); }
    pop.innerHTML=EMOJIS.map(e=>`<button data-insert="${e}" class="sk-pop-em">${e}</button>`).join('');
    const r=anchor.getBoundingClientRect(); pop.classList.remove('hidden');
    pop.style.left=Math.max(8,Math.min(r.left-100,window.innerWidth-260))+'px'; pop.style.top=Math.max(8,r.top-pop.offsetHeight-8)+'px';
}
function _chatInsertText(t){
    const inp=document.getElementById('chat-input'); if(!inp) return;
    const s=inp.selectionStart,e=inp.selectionEnd; inp.value=inp.value.slice(0,s)+t+inp.value.slice(e);
    const c=s+t.length; inp.focus(); inp.setSelectionRange(c,c); _chatAutoGrow(inp);
    document.getElementById('chat-emoji-insert')?.classList.add('hidden');
}

// ── Typing ───────────────────────────────────────────────────────────────────
function _chatTypingPing(){ const now=Date.now(); if(now-_chatTypingSent<2500) return; _chatTypingSent=now; if(typeof _srConn!=='undefined'&&_srConn.state==='Connected') _srConn.invoke('ChatTyping').catch(()=>{}); }
function _chatOnTyping(name){ if(name===_chatMe) return; _chatTypers.set(name,Date.now()); _chatRenderTyping(); }
function _chatRenderTyping(){
    const el=document.getElementById('chat-typing'); if(!el) return; const now=Date.now();
    for(const [n,t] of _chatTypers) if(now-t>4500) _chatTypers.delete(n);
    const names=[..._chatTypers.keys()]; let txt='';
    if(names.length===1) txt=`${names[0]} is typing`; else if(names.length===2) txt=`${names[0]} and ${names[1]} are typing`; else if(names.length>2) txt='Several people are typing';
    el.innerHTML = txt?`<span class="sk-typing-dots"><span></span><span></span><span></span></span>${_esc(txt)}…`:'';
}

// Drag & drop + paste
function _chatDragOver(e){ e.preventDefault(); document.getElementById('chat-messages').style.boxShadow='inset 0 0 0 2px #094f70'; }
function _chatDragLeave(e){ document.getElementById('chat-messages').style.boxShadow=''; }
function _chatDrop(e){ e.preventDefault(); _chatDragLeave(e); if(e.dataTransfer?.files?.length) _chatAddFiles(e.dataTransfer.files); }
document.addEventListener('paste', e => { const items=e.clipboardData?.items; if(!items) return; const imgs=[...items].filter(i=>i.type.startsWith('image/')).map(i=>i.getAsFile()).filter(Boolean); if(imgs.length&&document.getElementById('chat-input')) _chatAddFiles(imgs); });

function _chatToast(msg){ const t=document.createElement('div'); t.className='fixed bottom-6 right-6 z-[10001] text-white text-sm px-4 py-2 rounded-lg shadow-lg'; t.style.background='#e01e5a'; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2600); }

// ── Delegation ───────────────────────────────────────────────────────────────
function _chatWireDelegation(){
    document.addEventListener('click', e => {
        const chip=e.target.closest('[data-react]'); if(chip){ _chatReact(+chip.dataset.mid,chip.dataset.react); return; }
        const ins=e.target.closest('[data-insert]'); if(ins){ _chatInsertText(ins.dataset.insert); return; }
        const act=e.target.closest('[data-act]'); if(act){ const mid=+act.dataset.mid; if(act.dataset.act==='react') _chatOpenPicker(mid,act); else if(act.dataset.act==='edit') _chatBeginEdit(mid); else if(act.dataset.act==='del') _chatDelete(mid); return; }
        const sv=e.target.closest('[data-editsave]'); if(sv){ _chatSaveEdit(+sv.dataset.editsave); return; }
        const cx=e.target.closest('[data-editcancel]'); if(cx){ _chatCancelEdit(+cx.dataset.editcancel); return; }
        const mp=e.target.closest('[data-mention]'); if(mp){ _chatMentionPick(+mp.dataset.mention); return; }
        if(!e.target.closest('#chat-emoji-pop')) _chatClosePicker();
        if(!e.target.closest('#chat-emoji-insert')&&!e.target.closest('button[title="Emoji"]')) document.getElementById('chat-emoji-insert')?.classList.add('hidden');
        if(!e.target.closest('#chat-settings')&&!e.target.closest('button[title="Notification & feed settings"]')) document.getElementById('chat-settings')?.classList.add('hidden');
        if(!e.target.closest('#chat-mention-pop')&&e.target.id!=='chat-input') _chatMentionClose();
    });
    document.getElementById('chat-mention-pop')?.addEventListener('mousemove', e => { const row=e.target.closest('[data-mention]'); if(!row) return; _chatMention.index=+row.dataset.mention; document.querySelectorAll('#chat-mention-pop .sk-mrow').forEach((el,i)=>el.classList.toggle('active',i===_chatMention.index)); });
}

// ── Real-time ────────────────────────────────────────────────────────────────
function _chatWireSignalR(){
    if(typeof _srConn==='undefined'){ setTimeout(_chatWireSignalR,300); return; }
    const badge=document.getElementById('chat-conn');
    const setState=()=>{ const c=_srConn.state==='Connected'; badge.innerHTML=`<span class="inline-block w-2 h-2 rounded-full mr-1 align-middle" style="background:${c?'#2bac76':'#c9c9c9'}"></span>${c?'connected':'offline'}`; };
    _srConn.on('ChatMessage',        m  => { const l=document.getElementById('chat-messages'); const stick=_nearBottom(l); _appendMessage(m,stick,true); });
    _srConn.on('ChatMessageDeleted', id => _chatMarkDeleted(id));
    _srConn.on('ChatMessageEdited',  p  => _chatApplyEdit(p.id, p.body));
    _srConn.on('ChatReaction',       p  => _chatOnReaction(p.messageId, p.emoji, p.count));
    _srConn.on('ChatTyping',         n  => _chatOnTyping(n));
    _srConn.onreconnected(setState); _srConn.onclose(setState); _srConn.onreconnecting(setState);
    setState(); setInterval(setState,4000);
}

document.addEventListener('DOMContentLoaded', async () => {
    try { const tid=(typeof _chatTeamId!=='undefined')?_chatTeamId:''; localStorage.setItem('chatUnread_'+tid,'0'); localStorage.setItem('chatMention_'+tid,'0'); if(typeof _renderChatBadge==='function') _renderChatBadge(); } catch {}
    _chatLoadSettings();
    _chatWireDelegation();
    await _chatLoadMembers();
    _chatLoadInitial();
    _chatWireSignalR();
    setInterval(_chatRenderTyping,1500);
});
</script>
