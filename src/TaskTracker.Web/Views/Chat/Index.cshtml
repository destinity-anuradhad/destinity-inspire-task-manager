    return `<div class="sk-actions self-start flex items-center overflow-hidden shrink-0">
        <button data-act="react" data-mid="${m.id}" title="React" class="sk-actbtn"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></button>
        ${canEdit?`<button data-act="edit" data-mid="${m.id}" title="Edit" class="sk-actbtn"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></button>`:''}
        ${canDel?`<button data-act="del" data-mid="${m.id}" title="Delete" class="sk-actbtn sk-actbtn-del"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>`:''}
    </div>`;
}
function _bodyInner(m){
    if(m.deleted) return `<span class="text-[13px] italic sk-muted">message deleted</span>`;
    const edited=m.editedAt?' <span class="sk-edited">(edited)</span>':'';
    const body=m.body ? `<div class="chat-body sk-txt text-[15px] leading-relaxed whitespace-pre-wrap break-words" data-id="${m.id}" data-raw="${_esc(m.body)}">${_renderBody(m.body)}${edited}</div>` : `<div class="chat-body" data-id="${m.id}" data-raw=""></div>`;
    const atts=(m.attachments||[]).map(_attHtml).join('');
    return `${body}${atts}<div class="chat-reactions flex flex-wrap gap-1 mt-1.5" data-id="${m.id}"></div>`;
}
function _eventHtml(m){
    const meta=m.meta||{}; const ico=meta.icon?`<span class="text-[18px]">${_esc(meta.icon)}</span>`:'';
    const link=meta.url?` · <a href="${_esc(meta.url)}" class="sk-link font-medium">${_esc(meta.link||'Open')} →</a>`:'';
    return `<div class="sk-row chat-msg flex gap-3 px-5 py-1" data-id="${m.id}" data-user="${_esc(m.senderName)}" data-ts="${_esc(m.createdAt)}" data-evtype="${_esc(meta.type||'')}">
        <div class="w-9 shrink-0 flex justify-center pt-1">${ico}</div>
        <div class="flex-1 min-w-0"><div class="sk-event-card">
            <div class="sk-event-body">${_renderBody(m.body||'')}</div>
            <div class="sk-event-meta">${_esc(m.senderName)} · ${_fmtTime(m.createdAt)}${link}</div>
        </div></div></div>`;
}
function _msgHtml(m, grouped){
    if(m.kind==='event') return _eventHtml(m);   // activity posts stay full-width, not left/right
    const mine = m.senderName === _chatMe;
    const name = (!mine && !grouped) ? `<div class="sk-bname" style="color:${_esc(m.avatarColor||'#1d1c1d')}">${_esc(m.senderName)}</div>` : '';
    const meta = m.deleted ? '' : `<div class="sk-bmeta">${_fmtTime(m.createdAt)}</div>`;
    const bubble = `<div class="sk-bubble ${mine?'sk-out':'sk-in'}${grouped?' sk-grouped':''}" data-mid="${m.id}">${name}${_bodyInner(m)}${meta}</div>`;
    if(mine)
        return `<div class="sk-row chat-msg group flex items-end justify-end gap-2 px-5 ${grouped?'py-0.5':'py-1 mt-1'}" data-id="${m.id}" data-user="${_esc(m.senderName)}" data-ts="${_esc(m.createdAt)}">
            ${_actionsBar(m)}${bubble}</div>`;
    return `<div class="sk-row chat-msg group flex items-end gap-2 px-5 ${grouped?'py-0.5':'py-1 mt-1'}" data-id="${m.id}" data-user="${_esc(m.senderName)}" data-ts="${_esc(m.createdAt)}">
        ${grouped ? '<div class="w-9 shrink-0"></div>' : `<div class="shrink-0">${_avatarInner(m, true)}</div>`}
        ${bubble}${_actionsBar(m)}</div>`;
}
function _dayDivider(iso){
    return `<div class="flex items-center gap-3 my-3 px-5"><div class="flex-1 sk-day-line"></div><span class="sk-day-chip">${_esc(_fmtDay(iso))}</span><div class="flex-1 sk-day-line"></div></div>`;
}

// ── Members ──────────────────────────────────────────────────────────────────
function _chatTrackMember(m){
    if(!_chatMembers.has(m.senderName)){ _chatMembers.set(m.senderName,{name:m.senderName,color:m.avatarColor||'#094f70',image:m.avatarImage||null}); _chatRenderMembers(); }
