@model ImportPreviewResult
@{
    ViewData["Title"] = "Import Preview";
    var job = Model.Job;
    var applied = job.Status == "Applied";
    string RowBadge(string s) => s switch {
        "Valid"   => "bg-green-50 text-green-600",
        "Created" => "bg-green-50 text-green-600",
        "Invalid" => "bg-red-50 text-red-600",
        "Failed"  => "bg-red-50 text-red-600",
        "Skipped" => "bg-gray-100 text-gray-500",
        _ => "bg-gray-100 text-gray-500"
    };
}

<div class="max-w-5xl mx-auto mt-10 px-4 pb-16">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-xl font-bold text-gray-900">@(applied ? "Import result" : "Preview")</h1>
            <p class="text-sm text-gray-500 mt-1 truncate max-w-[420px]">@job.FileName</p>
        </div>
        <a href="/Import" class="text-sm text-[#094f70] hover:underline font-medium">← All imports</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 rounded-xl text-sm text-green-700">@TempData["Success"]</div>
    }

    <!-- Summary + action -->
    <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 flex items-center justify-between flex-wrap gap-4">
        <div class="flex gap-6 text-sm">
            <div><div class="text-gray-400 text-xs uppercase tracking-wide">Total</div><div class="font-semibold text-gray-900">@job.TotalRows</div></div>
            <div><div class="text-gray-400 text-xs uppercase tracking-wide">Valid</div><div class="font-semibold text-green-600">@job.ValidRows</div></div>
            <div><div class="text-gray-400 text-xs uppercase tracking-wide">Errors</div><div class="font-semibold text-red-600">@job.ErrorRows</div></div>
            @if (applied)
            {
                <div><div class="text-gray-400 text-xs uppercase tracking-wide">Created</div><div class="font-semibold text-green-600">@job.CreatedRows</div></div>
                <div><div class="text-gray-400 text-xs uppercase tracking-wide">Skipped</div><div class="font-semibold text-gray-500">@job.SkippedRows</div></div>
                <div><div class="text-gray-400 text-xs uppercase tracking-wide">Failed</div><div class="font-semibold text-red-600">@job.FailedRows</div></div>
            }
        </div>
        @if (!applied)
        {
            <form method="post" action="/Import/Apply">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@job.Id" />
                <button type="submit" @(job.ValidRows == 0 ? "disabled" : "")
                        class="px-5 py-2 text-sm btn-primary rounded-lg font-semibold @(job.ValidRows == 0 ? "opacity-50 cursor-not-allowed" : "")">
                    Import @job.ValidRows valid row(s)
                </button>
            </form>
        }
        else
        {
            <span class="inline-block rounded-full px-3 py-1 text-xs font-medium bg-green-50 text-green-600">Applied @job.AppliedAt?.ToString("yyyy-MM-dd HH:mm")</span>
        }
    </div>

    <!-- Rows -->
    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wide text-gray-400 border-b border-gray-100">
                        <th class="px-4 py-3 font-medium">#</th>
                        <th class="px-6 py-3 font-medium">Goal</th>
                        <th class="px-4 py-3 font-medium">Type</th>
                        <th class="px-4 py-3 font-medium">Status</th>
                        <th class="px-4 py-3 font-medium">Key</th>
                        <th class="px-4 py-3 font-medium">Row</th>
                        <th class="px-4 py-3 font-medium">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="border-b border-gray-50">
                            <td class="px-4 py-2.5 text-gray-400">@r.RowNumber</td>
                            <td class="px-6 py-2.5">
                                <span class="text-gray-900">@r.Goal</span>
                                @if (r.CreatedTaskId != null) { <span class="text-xs text-gray-400"> → #@r.CreatedTaskId</span> }
                            </td>
                            <td class="px-4 py-2.5 text-gray-600 font-mono text-xs">@r.ItemType</td>
                            <td class="px-4 py-2.5 text-gray-600 text-xs">@r.Status</td>
                            <td class="px-4 py-2.5 text-gray-500 font-mono text-xs">@(r.ExternalKey ?? "")</td>
                            <td class="px-4 py-2.5">
                                <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium @RowBadge(r.RowStatus)">@r.RowStatus</span>
                            </td>
                            <td class="px-4 py-2.5 text-xs text-red-500 max-w-[240px] truncate" title="@r.Message">@r.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
