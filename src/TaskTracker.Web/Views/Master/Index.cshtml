@{
    ViewData["Title"] = "Master Files";
    var users       = ViewBag.Users       as List<TaskTracker.Models.AppUser>      ?? [];
    var activeTeams = ViewBag.ActiveTeams as List<TaskTracker.Models.Team> ?? [];
    var userTeams   = ViewBag.UserTeams as Dictionary<int, List<TaskTracker.Services.UserTeamInfo>>
                      ?? new Dictionary<int, List<TaskTracker.Services.UserTeamInfo>>();
    var workStates  = ViewBag.WorkStates as List<TaskTracker.Models.WorkState> ?? [];
    var activeTab   = (ViewBag.ActiveTab as string ?? "users");

    string[] palette = [
        "#094f70","#f47920","#3b82f6","#10b981",
        "#f59e0b","#ef4444","#8b5cf6","#ec4899",
        "#14b8a6","#6366f1","#f97316","#64748b"
    ];
}

<div class="space-y-5">

    <!-- Header -->
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Master Files</h1>
            <p>@(activeTab == "columns" ? "Manage Kanban columns, colors, and WIP limits" : "Manage user accounts and roles")</p>
        </div>
        @if (activeTab == "columns")
        {
            <button onclick="openMcCanvas('new-workstate', {})"
                    class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white"
                    style="background:#094f70;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Column
            </button>
        }
        else
        {
            <button onclick="document.getElementById('newUserModal').classList.remove('hidden')"
                    class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white"
                    style="background:#094f70;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
                New User
            </button>
        }
    </div>

    <!-- Tab bar -->
    <div class="flex gap-1 border-b border-gray-200">
        <a href="/Master?tab=users"
           class="px-4 py-2.5 text-sm font-medium border-b-2 transition-colors @(activeTab == "users" ? "border-[#094f70] text-[#094f70]" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
            Users
        </a>
        <a href="/Master?tab=columns"
           class="px-4 py-2.5 text-sm font-medium border-b-2 transition-colors @(activeTab == "columns" ? "border-[#094f70] text-[#094f70]" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
            Kanban Columns
        </a>
        <a href="/EmailOutbox" class="px-4 py-2.5 text-sm font-medium text-gray-500 hover:text-gray-700">Email Outbox</a>
    </div>

    @* ── Users tab ─────────────────────────────────────────────── *@
    <div class="@(activeTab == "columns" ? "hidden" : "")"  id="tab-users">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/50">
                <p class="text-xs text-gray-500">Users are also task owners. Edit their username, display name, level and avatar color.</p>
            </div>

            @if (!users.Any())
            {
                <div class="text-center py-12 text-gray-400"><p class="text-sm">No users found.</p></div>
            }
            else
            {
                <ul class="divide-y divide-gray-100">
                    @foreach (var user in users)
                    {
                        var uColor   = user.Color ?? "#094f70";
                        var initial  = user.DisplayName.Length > 0 ? user.DisplayName[0].ToString().ToUpper() : "?";
                        var uTeams   = userTeams.TryGetValue(user.Id, out var ut) ? ut : [];
                        <li class="px-5 py-4 flex items-start gap-4 hover:bg-gray-50 transition-colors group">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0 shadow-sm mt-0.5"
                                 style="background:@uColor">@initial</div>
                            <div class="flex-1 min-w-0">
                                <!-- Name row -->
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold text-gray-800">@user.DisplayName</span>
                                    <span class="text-xs px-2 py-0.5 rounded-full font-medium flex-shrink-0 @(user.Role=="Admin"?"badge-brand":"bg-gray-100 text-gray-500")">
                                        @(user.Role == "Admin" ? "SysAdmin" : "Member")
                                    </span>
                                    @if (user.Status == "Pending")
                                    {
                                        <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-700 flex-shrink-0">Pending</span>
                                    }
                                    else if (user.Status == "Rejected")
                                    {
                                        <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-red-100 text-red-600 flex-shrink-0">Rejected</span>
                                    }
                                </div>
                                <!-- Username -->
                                <p class="text-xs text-gray-400 mt-0.5 mb-2">@@@user.Username
                                    @if (!string.IsNullOrEmpty(user.Email))
                                    {
                                        <span class="ml-2 text-gray-300">·</span>
                                        <span class="ml-1">@user.Email</span>
                                    }
                                </p>
                                <!-- Team badges -->
                                @if (uTeams.Any())
                                {
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var tm in uTeams)
                                        {
                                            <span class="inline-flex items-center gap-1 text-[10px] font-medium px-2 py-0.5 rounded-full border"
                                                  style="border-color:@(tm.TeamColor)40;color:@tm.TeamColor;background:@(tm.TeamColor)12;">
                                                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:@tm.TeamColor;"></span>
                                                @tm.TeamName
                                                <span class="text-gray-400 font-normal">· @tm.TeamRole</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[10px] text-gray-300 italic">No team assigned</span>
                                }
                            </div>
                            <button type="button"
                                    onclick="openMcCanvas('edit-user', {id:@user.Id, username:@System.Text.Json.JsonSerializer.Serialize(user.Username), displayName:@System.Text.Json.JsonSerializer.Serialize(user.DisplayName), role:@System.Text.Json.JsonSerializer.Serialize(user.Role), color:'@uColor'})"
                                    class="opacity-30 group-hover:opacity-100 transition-opacity p-1.5 text-gray-400 hover:text-brand hover:bg-blue-50 rounded-lg flex-shrink-0 mt-0.5" title="Edit">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    @* ── Kanban Columns tab ─────────────────────────────────────── *@
    <div class="@(activeTab != "columns" ? "hidden" : "")" id="tab-columns">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/50 flex items-center justify-between">
                <p class="text-xs text-gray-500">Drag rows to reorder columns. Set a WIP limit to cap how many tasks can be in a column at once.</p>
                <span class="text-xs text-gray-400">@workStates.Count column@(workStates.Count == 1 ? "" : "s")</span>
            </div>

            @if (!workStates.Any())
            {
                <div class="text-center py-12 text-gray-400">
                    <p class="text-sm">No columns yet.</p>
                    <button onclick="openMcCanvas('new-workstate', {})" class="mt-3 text-sm text-blue-600 hover:underline">Add your first column</button>
                </div>
            }
            else
            {
                <ul id="ws-list" class="divide-y divide-gray-100">
                    @for (int wi = 0; wi < workStates.Count; wi++)
                    {
                        var ws = workStates[wi];
                        <li data-ws-id="@ws.Id"
                            class="px-5 py-3.5 flex items-center gap-4 hover:bg-gray-50 transition-colors group">
                            <!-- Drag handle -->
                            <span class="ws-drag-handle cursor-grab text-gray-300 hover:text-gray-500 flex-shrink-0 touch-none" title="Drag to reorder">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M9 5a1 1 0 110 2 1 1 0 010-2zm0 6a1 1 0 110 2 1 1 0 010-2zm0 6a1 1 0 110 2 1 1 0 010-2zm6-12a1 1 0 110 2 1 1 0 010-2zm0 6a1 1 0 110 2 1 1 0 010-2zm0 6a1 1 0 110 2 1 1 0 010-2z"/>
                                </svg>
                            </span>
                            <!-- Color dot -->
                            <div class="w-3 h-3 rounded-full flex-shrink-0 ring-2 ring-offset-1"
                                 style="background:@ws.Color;ring-color:@ws.Color"></div>
                            <!-- Name -->
                            <div class="flex-1 min-w-0">
                                <span class="text-sm font-medium text-gray-800">@ws.Name</span>
                                <span class="ml-2 text-[10px] text-gray-400">order @ws.SortOrder</span>
                            </div>
                            <!-- WIP badge -->
                            @if (ws.WipLimit.HasValue)
                            {
                                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 flex-shrink-0"
                                      title="WIP limit">
                                    WIP @ws.WipLimit
                                </span>
                            }
                            else
                            {
                                <span class="text-[11px] text-gray-300 flex-shrink-0">No WIP limit</span>
                            }
                            <!-- Item type scope badges -->
                            <div class="flex items-center gap-1 flex-shrink-0">
                            @if (string.IsNullOrEmpty(ws.ItemTypes))
                            {
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-400">All types</span>
                            }
                            else
                            {
                                foreach (var t in ws.ItemTypes.Split(','))
                                {
                                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 text-blue-600 font-medium">@t.Trim()</span>
                                }
                            }
                            </div>
                            <!-- Actions -->
                            <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
                                <button type="button" title="Edit"
                                        onclick="openMcCanvas('edit-workstate', {id:@ws.Id, name:@System.Text.Json.JsonSerializer.Serialize(ws.Name), color:'@ws.Color', wipLimit:@(ws.WipLimit.HasValue ? ws.WipLimit.Value.ToString() : "null"), itemTypes:@System.Text.Json.JsonSerializer.Serialize(ws.ItemTypes ?? "")})"
                                        class="p-1.5 text-gray-400 hover:text-brand hover:bg-blue-50 rounded-lg transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <form method="post" action="/Master/DeleteWorkState"
                                      onsubmit="return confirm('Delete column \'@ws.Name\'? Tasks must be moved out first.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ws.Id"/>
                                    <button type="submit" title="Delete"
                                            class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

</div>

@* ══════════════════════════════════════════════════════════
   NEW USER MODAL
   ══════════════════════════════════════════════════════════ *@
<div id="newUserModal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4"
     onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 sticky top-0 bg-white rounded-t-2xl">
            <div>
                <h2 class="font-semibold text-gray-900">Create New User</h2>
                <p class="text-xs text-gray-400 mt-0.5">Account is created active — no approval needed</p>
            </div>
            <button onclick="document.getElementById('newUserModal').classList.add('hidden')"
                    class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form method="post" action="/Master/CreateUser" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1.5">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" name="displayName" required placeholder="e.g. Kaviya S."
                           class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1.5">Username <span class="text-red-500">*</span></label>
                    <input type="text" name="username" required placeholder="e.g. kaviyas"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1.5">Email <span class="text-gray-400 font-normal">(optional)</span></label>
                <input type="email" name="userEmail" placeholder="user@example.com"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1.5">Password <span class="text-red-500">*</span></label>
                    <input type="password" name="password" required placeholder="Min. 8 characters"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70]"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1.5">System Role</label>
                    <select name="systemRole"
                            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70] bg-white">
                        <option value="Member">Member</option>
                        <option value="Admin">SysAdmin</option>
                    </select>
                </div>
            </div>
            <div class="border-t border-gray-100 pt-4">
                <p class="text-xs font-medium text-gray-700 mb-3">Assign to Team <span class="text-gray-400 font-normal">(optional)</span></p>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs text-gray-500 mb-1.5">Team</label>
                        <select name="teamId" id="nu-team"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70] bg-white"
                                onchange="document.getElementById('nu-teamrole').disabled = !this.value">
                            <option value="">— No team —</option>
                            @foreach (var t in activeTeams)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 mb-1.5">Team Role</label>
                        <select name="teamRole" id="nu-teamrole" disabled
                                class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#094f70] bg-white disabled:opacity-40">
                            <option value="Member">Member</option>
                            <option value="TeamLead">Team Lead</option>
                            <option value="TeamAdmin">Team Admin</option>
                        </select>
                    </div>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-2">Avatar Color</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var clr in palette)
                    {
                        <button type="button" data-nucolor="@clr" onclick="nuPickColor(this)"
                                class="w-7 h-7 rounded-full hover:scale-110 transition-all"
                                style="background:@clr"></button>
                    }
                </div>
                <input type="hidden" name="color" id="nu-color" value="#3b82f6"/>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="document.getElementById('newUserModal').classList.add('hidden')"
                        class="flex-1 py-2.5 rounded-lg text-sm font-medium border border-gray-200 text-gray-600 hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-2.5 rounded-lg text-sm font-semibold text-white"
                        style="background:#094f70;">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>
<script>
function nuPickColor(btn) {
    const c = btn.dataset.nucolor;
    document.getElementById('nu-color').value = c;
    document.querySelectorAll('[data-nucolor]').forEach(b => {
        b.style.boxShadow = b.dataset.nucolor === c ? '0 0 0 2px #fff, 0 0 0 3.5px ' + c : '';
        b.style.transform = b.dataset.nucolor === c ? 'scale(1.2)' : '';
    });
}
document.getElementById('nu-team').addEventListener('change', function() {
    document.getElementById('nu-teamrole').disabled = !this.value;
});
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('newUserModal').classList.add('hidden');
});
</script>

@* ══════════════════════════════════════════════════════════
   OFF-CANVAS BACKDROP
   ══════════════════════════════════════════════════════════ *@
<div id="mc-backdrop"
     class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
     onclick="closeMcCanvas()"></div>

@* ══════════════════════════════════════════════════════════
   OFF-CANVAS PANEL
   ══════════════════════════════════════════════════════════ *@
<div id="mc-canvas"
     class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 shrink-0">
        <div>
            <h2 id="mc-title" class="text-lg font-semibold text-gray-900">Edit User</h2>
            <p id="mc-subtitle" class="text-xs text-gray-400 mt-0.5 hidden"></p>
        </div>
        <button onclick="closeMcCanvas()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Scrollable form body -->
    <form id="mc-form" method="post" action="" class="flex-1 overflow-y-auto px-6 py-5 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="mc-id" value="" />

        @* ── Name (workstates) ── *@
        <div id="mc-field-name" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Column Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" id="mc-name" placeholder="e.g. In Review"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        @* ── WIP Limit (workstates) ── *@
        <div id="mc-field-wipLimit" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">WIP Limit <span class="text-gray-400 font-normal">(optional)</span></label>
            <input type="number" name="wipLimit" id="mc-wipLimit" min="1" max="999" placeholder="Leave blank for no limit"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <p class="text-xs text-gray-400 mt-1">When a column reaches this count the header turns amber/red.</p>
        </div>

        @* ── Item Types (workstates) ── *@
        <div id="mc-field-itemTypes" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Applies to item types</label>
            <div class="flex flex-wrap gap-2 p-3 border border-gray-200 rounded-lg bg-gray-50">
                @foreach (var it in new[] { "Epic", "Feature", "Story", "Task", "Bug" })
                {
                    <label class="flex items-center gap-1.5 cursor-pointer select-none">
                        <input type="checkbox" class="mc-item-type-cb w-3.5 h-3.5 rounded accent-blue-600" value="@it" />
                        <span class="text-xs text-gray-700">@it</span>
                    </label>
                }
            </div>
            <input type="hidden" name="itemTypes" id="mc-itemTypes-value" />
            <p class="text-xs text-gray-400 mt-1">Leave all unchecked to show this status for every item type.</p>
        </div>

        @* ── Username (users) ── *@
        <div id="mc-field-username" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Username</label>
            <input type="text" name="username" id="mc-username"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        @* ── Display Name (users) ── *@
        <div id="mc-field-displayName" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Display Name</label>
            <input type="text" name="displayName" id="mc-displayName"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        @* ── Role (users) ── *@
        <div id="mc-field-role" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Level</label>
            <select name="role" id="mc-role"
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                <option value="Member">Member</option>
                <option value="Admin">Admin</option>
            </select>
        </div>

        @* ── Color picker (all) ── *@
        <div id="mc-field-color">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Color</label>
            <div class="flex flex-wrap gap-2.5 p-3 border border-gray-200 rounded-lg bg-gray-50">
                @foreach (var clr in palette)
                {
                    <button type="button" data-color="@clr" onclick="mcPickColor(this)"
                            class="w-7 h-7 rounded-full flex-shrink-0 transition-all hover:scale-110"
                            style="background:@clr"></button>
                }
            </div>
            <input type="hidden" name="color" id="mc-color" value="#094f70" />
        </div>

        @* ── Avatar preview (users) ── *@
        <div id="mc-field-avatar" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-2">Preview</label>
            <div class="flex items-center gap-3">
                <div id="mc-avatar"
                     class="w-12 h-12 rounded-full flex items-center justify-center text-white text-lg font-bold shadow"
                     style="background:#094f70">?</div>
                <div>
                    <p id="mc-avatar-name" class="text-sm font-semibold text-gray-800">—</p>
                    <p id="mc-avatar-role" class="text-xs text-gray-400">Member</p>
                </div>
            </div>
        </div>
    </form>

    <!-- Footer -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50 shrink-0">
        <button type="button" onclick="closeMcCanvas()"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Cancel
        </button>
        <button type="button" id="mc-save-btn" onclick="submitMcCanvas()"
                class="px-5 py-2 text-sm btn-primary rounded-lg">
            Save
        </button>
    </div>
</div>

@section Scripts {
<script>
const MC_CFG = {
    'edit-user':       { action: '/Master/EditUser',      title: 'Edit User',       fields: ['username','displayName','role','color','avatar'], hasId: true },
    'new-workstate':   { action: '/Master/SaveWorkState', title: 'Add Column',      fields: ['name','wipLimit','itemTypes','color'], hasId: false },
    'edit-workstate':  { action: '/Master/SaveWorkState', title: 'Edit Column',     fields: ['name','wipLimit','itemTypes','color'], hasId: true },
};
const MC_ALL_FIELDS = ['username','displayName','role','avatar','name','wipLimit','itemTypes'];

function openMcCanvas(type, data) {
    const cfg = MC_CFG[type];
    if (!cfg) return;

    // Title & form action
    document.getElementById('mc-title').textContent = cfg.title;
    document.getElementById('mc-form').action = cfg.action;

    // Show/hide fields
    MC_ALL_FIELDS.forEach(f => document.getElementById('mc-field-' + f).classList.add('hidden'));
    cfg.fields.forEach(f => {
        const el = document.getElementById('mc-field-' + f);
        if (el) el.classList.remove('hidden');
    });

    // Populate values
    document.getElementById('mc-id').value         = data?.id ?? '';
    document.getElementById('mc-username').value    = data?.username ?? '';
    document.getElementById('mc-displayName').value = data?.displayName ?? '';
    document.getElementById('mc-role').value        = data?.role ?? 'Member';
    document.getElementById('mc-name').value        = data?.name ?? '';
    document.getElementById('mc-wipLimit').value    = (data?.wipLimit != null && data.wipLimit !== 'null') ? data.wipLimit : '';

    // Populate item-type checkboxes
    const checked = (data?.itemTypes ?? '').split(',').map(s => s.trim()).filter(Boolean);
    document.querySelectorAll('.mc-item-type-cb').forEach(cb => {
        cb.checked = checked.includes(cb.value);
    });
    document.getElementById('mc-itemTypes-value').value = data?.itemTypes ?? '';

    const color = data?.color ?? '#094f70';
    document.getElementById('mc-color').value = color;
    mcSyncSwatches(color);

    // Avatar preview
    if (cfg.fields.includes('avatar')) {
        const dn      = data?.displayName ?? '';
        const initial = dn.length > 0 ? dn[0].toUpperCase() : '?';
        const av      = document.getElementById('mc-avatar');
        av.textContent    = initial;
        av.style.background = color;
        document.getElementById('mc-avatar-name').textContent = dn || '—';
        document.getElementById('mc-avatar-role').textContent = data?.role ?? 'Member';
    }

    // Focus first visible input
    const firstInput = document.querySelector('#mc-canvas input:not([type=hidden]):not(.hidden), #mc-canvas select:not(.hidden)');
    if (firstInput) setTimeout(() => firstInput.focus(), 310);

    // Open panel
    const bd = document.getElementById('mc-backdrop');
    const pn = document.getElementById('mc-canvas');
    bd.style.pointerEvents = 'auto';
    requestAnimationFrame(() => {
        bd.classList.add('opacity-100');
        bd.classList.remove('opacity-0');
        pn.classList.remove('translate-x-full');
    });
    document.body.style.overflow = 'hidden';
}

function closeMcCanvas() {
    const bd = document.getElementById('mc-backdrop');
    const pn = document.getElementById('mc-canvas');
    bd.classList.remove('opacity-100');
    bd.classList.add('opacity-0');
    pn.classList.add('translate-x-full');
    setTimeout(() => { bd.style.pointerEvents = 'none'; }, 300);
    document.body.style.overflow = '';
}

function submitMcCanvas() {
    const form = document.getElementById('mc-form');
    // Validate visible name field
    const nameEl = document.getElementById('mc-name');
    if (!document.getElementById('mc-field-name').classList.contains('hidden')) {
        if (!nameEl.value.trim()) { nameEl.focus(); nameEl.classList.add('ring-2','ring-red-400'); return; }
        nameEl.classList.remove('ring-2','ring-red-400');
    }
    // Gather item-type checkboxes into hidden field before submit
    if (!document.getElementById('mc-field-itemTypes').classList.contains('hidden')) {
        const selected = [...document.querySelectorAll('.mc-item-type-cb:checked')].map(cb => cb.value);
        document.getElementById('mc-itemTypes-value').value = selected.join(',');
    }
    form.submit();
}

function mcPickColor(btn) {
    const color = btn.dataset.color;
    document.getElementById('mc-color').value = color;
    mcSyncSwatches(color);
    // Update live avatar
    const av = document.getElementById('mc-avatar');
    if (av) av.style.background = color;
}

function mcSyncSwatches(selected) {
    document.querySelectorAll('#mc-canvas button[data-color]').forEach(function(btn) {
        const sel = btn.dataset.color === selected;
        btn.style.boxShadow = sel ? '0 0 0 2px #fff, 0 0 0 3.5px ' + btn.dataset.color : '';
        btn.style.transform = sel ? 'scale(1.2)' : '';
    });
}

// Close on Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !document.getElementById('mc-canvas').classList.contains('translate-x-full'))
        closeMcCanvas();
});

// ── Kanban Columns drag-to-reorder ───────────────────────────
(function() {
    const list = document.getElementById('ws-list');
    if (!list) return;

    let dragEl = null, dragOver = null;

    list.addEventListener('dragstart', function(e) {
        dragEl = e.target.closest('li');
        if (!dragEl) return;
        dragEl.style.opacity = '0.5';
        e.dataTransfer.effectAllowed = 'move';
    });

    list.addEventListener('dragover', function(e) {
        e.preventDefault();
        const over = e.target.closest('li');
        if (!over || over === dragEl) return;
        if (over !== dragOver) {
            if (dragOver) dragOver.classList.remove('border-t-2', 'border-[#094f70]');
            dragOver = over;
            dragOver.classList.add('border-t-2', 'border-[#094f70]');
        }
    });

    list.addEventListener('dragleave', function(e) {
        if (!list.contains(e.relatedTarget) && dragOver) {
            dragOver.classList.remove('border-t-2', 'border-[#094f70]');
            dragOver = null;
        }
    });

    list.addEventListener('drop', function(e) {
        e.preventDefault();
        if (dragOver) dragOver.classList.remove('border-t-2', 'border-[#094f70]');
        if (!dragEl || !dragOver || dragEl === dragOver) return;
        list.insertBefore(dragEl, dragOver);
        dragOver = null;
        saveOrder();
    });

    list.addEventListener('dragend', function() {
        if (dragEl) dragEl.style.opacity = '';
        if (dragOver) dragOver.classList.remove('border-t-2', 'border-[#094f70]');
        dragEl = dragOver = null;
    });

    // Make each row draggable via its handle
    list.querySelectorAll('.ws-drag-handle').forEach(function(handle) {
        const li = handle.closest('li');
        li.draggable = true;
    });

    async function saveOrder() {
        const ids = [...list.querySelectorAll('li[data-ws-id]')].map(li => parseInt(li.dataset.wsId));
        try {
            await fetch('/Master/ReorderWorkStates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids),
            });
        } catch {}
    }
})();
</script>
}
