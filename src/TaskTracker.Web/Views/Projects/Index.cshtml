@model List<TaskTracker.Models.ProjectItem>
@{
    ViewData["Title"] = "Projects";
    var members = ViewBag.Members as List<TaskTracker.Models.AppUser> ?? [];
    var canManage = User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value == "TeamAdmin";
    var leads = members.ToDictionary(m => m.Id, m => m.DisplayName);
    var releases = (ViewBag.Releases as List<TaskTracker.Models.ProjectRelease> ?? [])
        .GroupBy(r => r.ProjectId).ToDictionary(g => g.Key, g => g.ToList());
}
<div class="max-w-6xl mx-auto space-y-5">
    <div class="page-hd"><div class="page-hd-left"><h1>Projects</h1><p>Team-owned delivery work and lifecycle</p></div></div>
    @if (TempData["Success"] != null) { <p class="text-sm text-green-700">@TempData["Success"]</p> }
    @if (TempData["Error"] != null) { <p class="text-sm text-red-700">@TempData["Error"]</p> }
    @if (canManage)
    {
        <form method="post" action="/Projects/Save" class="bg-white border border-gray-200 rounded-xl p-5 grid grid-cols-1 md:grid-cols-3 gap-4">
            @Html.AntiForgeryToken()
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Project name</label><input name="name" required maxlength="200" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Lead</label><select name="leadUserId" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"><option value="">Unassigned</option>@foreach (var user in members) { <option value="@user.Id">@user.DisplayName</option> }</select></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Target date</label><input type="date" name="targetDate" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div class="md:col-span-2"><label class="block text-xs font-medium text-gray-500 mb-1">Description</label><input name="description" maxlength="2000" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div class="flex items-end"><button class="btn-primary text-sm px-5 py-2 rounded-lg">Create Project</button></div>
        </form>
    }
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    @foreach (var project in Model)
    {
        <div class="bg-white border border-gray-200 rounded-xl p-5"><div class="flex justify-between gap-3"><div><h2 class="font-semibold text-gray-800">@project.Name</h2><p class="text-xs text-gray-500 mt-1">Lead: @(project.LeadUserId.HasValue && leads.TryGetValue(project.LeadUserId.Value, out var lead) ? lead : "Unassigned")</p></div><span class="text-xs font-semibold text-green-700">@project.Status</span></div>
            @if (!string.IsNullOrWhiteSpace(project.Description)) { <p class="text-sm text-gray-600 mt-3">@project.Description</p> }
            @if (project.TargetDate.HasValue) { <p class="text-xs text-gray-500 mt-3">Target: @project.TargetDate.Value.ToString("d MMM yyyy")</p> }
            @if (releases.TryGetValue(project.Id, out var projectReleases) && projectReleases.Count > 0)
            {
                <div class="mt-4 border-t border-gray-100 pt-3 space-y-2">
                    <p class="text-xs font-semibold text-gray-500">Releases</p>
                    @foreach (var release in projectReleases)
                    {
                        <div class="flex items-center justify-between gap-2 text-xs"><span class="text-gray-700">@release.Name @(release.TargetDate.HasValue ? $"· {release.TargetDate.Value:d MMM}" : "")</span><span class="font-semibold @(release.Status == "Released" ? "text-green-700" : "text-amber-700")">@release.Status</span>
                        @if (canManage && release.Status != "Released") { <form method="post" action="/Projects/MarkReleased">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@release.Id" /><button class="text-blue-700 font-semibold">Release</button></form> }</div>
                    }
                </div>
            }
            @if (canManage)
            {
                <form method="post" action="/Projects/CreateRelease" class="mt-4 pt-3 border-t border-gray-100 flex gap-2 flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@project.Id" /><input name="name" required maxlength="200" placeholder="Version, e.g. 2.1" class="min-w-0 flex-1 border border-gray-200 rounded-lg px-2 py-1.5 text-xs" /><input type="date" name="targetDate" class="border border-gray-200 rounded-lg px-2 py-1.5 text-xs" /><button class="text-xs font-semibold text-blue-700">Add release</button></form>
            }
            @if (canManage) { <form method="post" action="/Projects/Archive" class="mt-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@project.Id" /><button class="text-xs font-semibold text-red-600">Archive</button></form> }
        </div>
    }
    </div>
    @if (Model.Count == 0) { <p class="text-sm text-gray-500">No active projects for this team.</p> }
</div>
