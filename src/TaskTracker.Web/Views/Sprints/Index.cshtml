@model List<TaskTracker.Models.Sprint>
@using System.Text.Json
@{
    ViewData["Title"] = "Sprints";
    var taskCounts  = ViewBag.TaskCounts  as Dictionary<int, int> ?? new();
    var ownerNames  = ViewBag.OwnerNames  as List<string>         ?? new();
    var jsonOpts    = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="space-y-5">
    <!-- Header -->
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Sprints</h1>
            <p>Plan and manage development sprints</p>
        </div>
        <button onclick="openSprintPanel(null)"
                class="btn-primary text-sm px-4 py-2 rounded-lg flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Sprint
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-16 text-center">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p class="text-gray-500 font-medium">No sprints yet</p>
            <p class="text-gray-400 text-sm mt-1">Create your first sprint to start planning work</p>
            <button onclick="openSprintPanel(null)" class="mt-4 btn-primary text-sm px-4 py-2 rounded-lg">Create Sprint</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var sprint in Model)
            {
                var cnt  = taskCounts.GetValueOrDefault(sprint.Id, 0);
                var sJson = System.Text.Json.JsonSerializer.Serialize(sprint,
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });

                <div class="bg-white border @(sprint.IsActive ? "border-blue-400 ring-2 ring-blue-100" : "border-gray-200") rounded-xl p-5 flex flex-col gap-4 relative group">
                    @if (sprint.IsActive)
                    {
                        <span class="absolute top-4 right-4 text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">Active</span>
                    }

                    <!-- Sprint name & dates -->
                    <div class="pr-16">
                        <h2 class="font-semibold text-gray-900 text-base leading-snug">@sprint.Name</h2>
                        @if (sprint.StartDate.HasValue || sprint.EndDate.HasValue)
                        {
                            <p class="text-xs text-gray-400 mt-0.5">
                                @(sprint.StartDate?.ToString("yyyy-MM-dd") ?? "—") → @(sprint.EndDate?.ToString("yyyy-MM-dd") ?? "—")
                            </p>
                        }
                    </div>

                    <!-- Goal -->
                    @if (!string.IsNullOrEmpty(sprint.Goal))
                    {
                        <p class="text-sm text-gray-600 line-clamp-2">@sprint.Goal</p>
                    }

                    <!-- Stats -->
                    <div class="flex items-center gap-3 text-xs text-gray-500">
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/>
                            </svg>
                            @cnt task@(cnt == 1 ? "" : "s")
                        </span>
                        @if (!string.IsNullOrEmpty(sprint.CreatedBy))
                        {
                            <span>by @sprint.CreatedBy</span>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 pt-1 border-t border-gray-100">
                        <button onclick='openSprintPanel(@Html.Raw(sJson))'
                                class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 flex items-center justify-center gap-1.5 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Edit
                        </button>
                        @if (!sprint.IsActive)
                        {
                            <button onclick="setActive(@sprint.Id)"
                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-blue-200 text-blue-600 hover:bg-blue-50 flex items-center justify-center gap-1.5 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Set Active
                            </button>
                        }
                        else
                        {
                            <button onclick="completeSprint(@sprint.Id, '@Html.Raw(Html.Encode(sprint.Name))')"
                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-green-200 text-green-600 hover:bg-green-50 flex items-center justify-center gap-1.5 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Complete Sprint
                            </button>
                        }
                        <button onclick="openCapacity(@sprint.Id)"
                                class="p-1.5 text-gray-400 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors"
                                title="Capacity Planning">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                        </button>
                        <button onclick="deleteSprint(@sprint.Id, @cnt)"
                                class="p-1.5 text-gray-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                                title="Delete sprint">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ═══ CAPACITY PLANNING MODAL ═══ -->
<div id="cap-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-start justify-center pt-12 px-4" style="display:none!important">
    <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl max-h-[82vh] flex flex-col">
        <!-- Modal header -->
        <div class="flex items-start justify-between px-6 py-4 border-b border-gray-100 shrink-0">
            <div>
                <h3 id="cap-title" class="text-base font-semibold text-gray-900">Capacity Planning</h3>
                <p id="cap-subtitle" class="text-xs text-gray-400 mt-0.5"></p>
            </div>
            <button onclick="closeCapacity()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors -mt-1 -mr-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <!-- Modal body -->
        <div class="flex-1 overflow-y-auto px-6 py-4" id="cap-body">
            <div class="py-10 text-center text-gray-300 text-sm">Loading…</div>
        </div>
        <!-- Add member footer -->
        <div class="border-t border-gray-100 px-6 py-3 bg-gray-50 rounded-b-2xl shrink-0">
            <div class="flex items-center gap-2">
                <select id="cap-add-owner" class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 bg-white">
                    <option value="">Add team member…</option>
                </select>
                <input id="cap-add-pts" type="number" min="0" step="0.5" placeholder="Capacity (hours)"
                       class="w-36 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                <button onclick="addCapacityRow()"
                        class="px-4 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium transition-colors shrink-0">
                    Add
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ SPRINT SLIDE PANEL ═══ -->
<div id="sp-backdrop"
     class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
     onclick="closeSprintPanel()"></div>

<div id="sprint-panel"
     class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 shrink-0">
        <div>
            <h3 id="sp-title" class="text-lg font-semibold text-gray-900">New Sprint</h3>
            <p id="sp-subtitle" class="text-xs text-gray-400 hidden"></p>
        </div>
        <button onclick="closeSprintPanel()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Form -->
    <form id="sprint-form" class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" id="sp-id" name="Id" value="0" />

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Sprint Name <span class="text-red-500">*</span></label>
            <input id="sp-name" name="Name" type="text" required placeholder="e.g. Sprint 1 — Login Flow"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Start Date</label>
                <input id="sp-start" name="StartDate" type="date"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">End Date</label>
                <input id="sp-end" name="EndDate" type="date"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Sprint Goal</label>
            <textarea id="sp-goal" name="Goal" rows="4" placeholder="What should this sprint achieve?"
                      class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
        </div>
    </form>

    <!-- Footer -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50 shrink-0">
        <button type="button" onclick="closeSprintPanel()"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
        <button type="button" onclick="saveSprint()"
                class="px-5 py-2 text-sm btn-primary rounded-lg flex items-center gap-2">
            <span id="sp-save-label">Create Sprint</span>
            <svg id="sp-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
            </svg>
        </button>
    </div>
</div>

<script>
const spBackdrop = document.getElementById('sp-backdrop');
const spPanel    = document.getElementById('sprint-panel');

function openSprintPanel(sprint) {
    document.getElementById('sp-id').value    = sprint?.id    ?? 0;
    document.getElementById('sp-name').value  = sprint?.name  ?? '';
    document.getElementById('sp-start').value = sprint?.startDate ?? '';
    document.getElementById('sp-end').value   = sprint?.endDate   ?? '';
    document.getElementById('sp-goal').value  = sprint?.goal      ?? '';
    document.getElementById('sp-title').textContent       = sprint ? 'Edit Sprint' : 'New Sprint';
    document.getElementById('sp-save-label').textContent  = sprint ? 'Save Changes' : 'Create Sprint';
    const sub = document.getElementById('sp-subtitle');
    if (sprint) { sub.textContent = 'Sprint #' + sprint.id; sub.classList.remove('hidden'); }
    else { sub.classList.add('hidden'); }
    spBackdrop.classList.remove('opacity-0', 'pointer-events-none');
    spBackdrop.classList.add('opacity-100');
    spPanel.classList.remove('translate-x-full');
    document.getElementById('sp-name').focus();
}

function closeSprintPanel() {
    spBackdrop.classList.add('opacity-0', 'pointer-events-none');
    spBackdrop.classList.remove('opacity-100');
    spPanel.classList.add('translate-x-full');
}

async function saveSprint() {
    const form = document.getElementById('sprint-form');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = document.querySelector('#sprint-panel button[onclick="saveSprint()"]');
    const sp  = document.getElementById('sp-spinner');
    btn.disabled = true; sp.classList.remove('hidden');
    try {
        const r = await fetch('/Sprints/Save', { method: 'POST', body: new FormData(form) });
        if (!r.ok) {
            const d = await r.json().catch(() => ({}));
            Swal.fire({ icon: 'error', title: 'Error', text: d.message || 'Failed to save sprint.' });
            return;
        }
        location.reload();
    } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.' });
    } finally {
        btn.disabled = false; sp.classList.add('hidden');
    }
}

async function setActive(id) {
    const r = await fetch('/Sprints/SetActive/' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
}

async function deactivateSprint() {
    const r = await fetch('/Sprints/Deactivate', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
}

// All sprints (for the "move unfinished items to…" picker)
const SPRINT_LIST = [
    @foreach (var s in Model) { @Html.Raw($"{{ id: {s.Id}, name: '{Html.Encode(s.Name).Replace("'", "\\'")}', active: {s.IsActive.ToString().ToLower()} }},") }
];

async function completeSprint(id, name) {
    // How many unfinished items are in this sprint?
    let info = { total: 0, incomplete: 0, done: 0 };
    try {
        const r = await fetch('/Sprints/GetIncomplete?sprintId=' + id);
        info = await r.json();
    } catch {}

    const others = SPRINT_LIST.filter(s => s.id !== id);
    const options = '<option value="backlog">← Backlog</option>' +
        others.map(s => `<option value="${s.id}">${s.name}</option>`).join('');

    const html = info.incomplete > 0
        ? `<p class="text-sm text-gray-600 mb-3">${info.done} of ${info.total} item(s) are complete.<br>
             <b>${info.incomplete} unfinished item(s)</b> — where should they go?</p>
           <select id="swal-moveto" class="swal2-select" style="width:80%;font-size:14px">${options}</select>`
        : `<p class="text-sm text-gray-600">All ${info.total} item(s) are complete. 🎉</p>`;

    const res = await Swal.fire({
        icon: 'question',
        title: `Complete "${name}"?`,
        html: html,
        showCancelButton: true,
        confirmButtonText: 'Complete Sprint',
        confirmButtonColor: '#16a34a',
        preConfirm: () => document.getElementById('swal-moveto')?.value ?? 'backlog'
    });
    if (!res.isConfirmed) return;

    const fd = new FormData();
    fd.append('id', id);
    fd.append('moveTo', res.value);
    fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');
    const r2 = await fetch('/Sprints/Complete', { method: 'POST', body: fd });
    const d  = await r2.json();
    if (d.success) {
        await Swal.fire({ icon: 'success', title: 'Sprint completed',
            text: d.moved > 0 ? `${d.moved} unfinished item(s) moved to ${d.movedTo === 'backlog' ? 'the Backlog' : 'the selected sprint'}.` : 'All items were complete.',
            timer: 2500, showConfirmButton: false });
        location.reload();
    } else {
        Swal.fire({ icon: 'error', text: d.message || 'Could not complete sprint.' });
    }
}

async function deleteSprint(id, taskCount) {
    if (taskCount > 0) {
        Swal.fire({ icon: 'warning', title: 'Cannot Delete', text: `This sprint has ${taskCount} task(s). Move or unassign them first.` });
        return;
    }
    const confirm = await Swal.fire({
        icon: 'warning', title: 'Delete Sprint?', text: 'This cannot be undone.',
        showCancelButton: true, confirmButtonText: 'Delete', confirmButtonColor: '#ef4444'
    });
    if (!confirm.isConfirmed) return;
    const r = await fetch('/Sprints/Delete/' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
    else {
        const d = await r.json().catch(() => ({}));
        Swal.fire({ icon: 'error', title: 'Error', text: d.message || 'Failed to delete.' });
    }
}

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeSprintPanel(); closeCapacity(); }
});

// ── Capacity Planning ──────────────────────────────────────────────────────────
const CAP_OWNERS = @Html.Raw(JsonSerializer.Serialize(ownerNames, jsonOpts));

let _capSprintId = null;

function _capToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}

function _capEsc(s) {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function openCapacity(sprintId) {
    _capSprintId = sprintId;
    const modal  = document.getElementById('cap-modal');
    modal.style.removeProperty('display');
    modal.classList.remove('hidden');
    modal.style.display = 'flex';
    _loadCapacity();
}

function closeCapacity() {
    const modal = document.getElementById('cap-modal');
    modal.style.display = 'none';
    _capSprintId = null;
}

async function _loadCapacity() {
    document.getElementById('cap-body').innerHTML =
        '<div class="py-10 text-center text-gray-300 text-sm">Loading…</div>';
    const r = await fetch('/Sprints/GetCapacity?sprintId=' + _capSprintId);
    if (!r.ok) {
        document.getElementById('cap-body').innerHTML =
            '<div class="py-6 text-center text-red-400 text-sm">Failed to load capacity data.</div>';
        return;
    }
    const data = await r.json();
    document.getElementById('cap-title').textContent = 'Capacity — ' + data.sprintName;
    const dates = [data.startDate, data.endDate].filter(Boolean).join(' → ');
    document.getElementById('cap-subtitle').textContent = dates;

    // Populate "add member" select (skip owners already shown)
    const present = new Set((data.rows || []).map(r => r.ownerName.toLowerCase()));
    const addSel  = document.getElementById('cap-add-owner');
    addSel.innerHTML = '<option value="">Add team member…</option>'
        + CAP_OWNERS
            .filter(n => n && !present.has(n.toLowerCase()))
            .map(n => '<option value="' + _capEsc(n) + '">' + _capEsc(n) + '</option>')
            .join('');

    _renderCapRows(data.rows || [], data.totalCapacity, data.totalAllocated);
}

function _renderCapRows(rows, totalCap, totalAlloc) {
    const body = document.getElementById('cap-body');
    if (!rows.length) {
        body.innerHTML =
            '<div class="py-10 text-center text-gray-400 text-sm">No tasks or capacity entries for this sprint yet.</div>';
        return;
    }

    const tableRows = rows.map(row => {
        const cap    = row.capacityHours;
        const alloc  = row.allocatedPoints;
        const pct    = (cap != null && cap > 0) ? Math.round(alloc / cap * 100) : null;
        const barW   = (pct != null) ? Math.min(pct, 100) : 0;
        const barCls = (pct == null)  ? 'bg-gray-200'
                     : (pct > 100)    ? 'bg-red-400'
                     : (pct >= 75)    ? 'bg-blue-400'
                                      : 'bg-green-400';
        const pctLbl = (pct != null) ? (pct + '%') : '—';
        const capVal = (cap != null) ? cap : '';

        return '<tr class="border-b border-gray-50 hover:bg-gray-50/50">'
            + '<td class="py-3 pr-4">'
            +   '<span class="font-medium text-gray-800 text-sm">' + _capEsc(row.ownerName) + '</span>'
            +   '<span class="text-gray-400 text-xs ml-1.5">(' + row.taskCount + ' task' + (row.taskCount === 1 ? '' : 's') + ')</span>'
            + '</td>'
            + '<td class="py-3 pr-4">'
            +   '<div class="flex items-center justify-end gap-1">'
            +     '<input type="number" min="0" step="0.5" value="' + _capEsc(String(capVal)) + '" placeholder="—"'
            +       ' class="w-16 text-right border border-gray-200 rounded px-2 py-0.5 text-sm focus:outline-none focus:ring-1 focus:ring-purple-500"'
            +       ' data-owner="' + _capEsc(row.ownerName) + '"'
            +       ' onchange="saveCapacityRow(this.dataset.owner, this.value)">'
            +     '<span class="text-gray-400 text-xs">h</span>'
            +   '</div>'
            + '</td>'
            + '<td class="py-3 pr-4 text-right">'
            +   '<span class="' + (alloc > 0 ? 'text-gray-800 font-medium' : 'text-gray-300') + ' text-sm">' + alloc + '</span>'
            +   '<span class="text-gray-400 text-xs ml-0.5">h</span>'
            + '</td>'
            + '<td class="py-3 min-w-[130px]">'
            +   '<div class="flex items-center gap-2">'
            +     '<div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">'
            +       '<div class="' + barCls + ' h-2 rounded-full transition-all" style="width:' + barW + '%"></div>'
            +     '</div>'
            +     '<span class="text-xs text-gray-500 w-9 text-right shrink-0">' + pctLbl + '</span>'
            +   '</div>'
            + '</td>'
            + '</tr>';
    }).join('');

    const totalPct = (totalCap > 0) ? Math.round(totalAlloc / totalCap * 100) + '%' : '—';
    const footer =
        '<tr class="border-t-2 border-gray-200 bg-gray-50/80">'
        + '<td class="py-2.5 pr-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</td>'
        + '<td class="py-2.5 pr-4 text-right text-sm font-semibold text-gray-700">' + totalCap + '<span class="font-normal text-gray-400 text-xs ml-0.5">h</span></td>'
        + '<td class="py-2.5 pr-4 text-right text-sm font-semibold text-gray-700">' + totalAlloc + '<span class="font-normal text-gray-400 text-xs ml-0.5">h</span></td>'
        + '<td class="py-2.5 text-xs text-gray-500">' + totalPct + ' overall utilization</td>'
        + '</tr>';

    body.innerHTML =
        '<table class="w-full text-sm">'
        + '<thead><tr class="text-left border-b border-gray-100">'
        +   '<th class="pb-2.5 pr-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Member</th>'
        +   '<th class="pb-2.5 pr-4 text-xs font-semibold text-gray-500 uppercase tracking-wide text-right">Capacity</th>'
        +   '<th class="pb-2.5 pr-4 text-xs font-semibold text-gray-500 uppercase tracking-wide text-right">Committed</th>'
        +   '<th class="pb-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wide">Utilization</th>'
        + '</tr></thead>'
        + '<tbody>' + tableRows + '</tbody>'
        + '<tfoot>' + footer + '</tfoot>'
        + '</table>';
}

async function saveCapacityRow(ownerName, hoursStr) {
    const pts = parseFloat(hoursStr);
    if (isNaN(pts) || pts < 0) return;
    await fetch('/Sprints/SaveCapacity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _capToken() },
        body: JSON.stringify({ sprintId: _capSprintId, ownerName, capacityHours: pts })
    });
    await _loadCapacity();
}

async function addCapacityRow() {
    const ownerSel = document.getElementById('cap-add-owner');
    const ptsFld   = document.getElementById('cap-add-pts');
    const owner    = ownerSel.value.trim();
    const pts      = parseFloat(ptsFld.value);
    if (!owner) {
        Swal.fire({ icon: 'warning', text: 'Select a team member.', toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
        return;
    }
    if (isNaN(pts) || pts < 0) {
        Swal.fire({ icon: 'warning', text: 'Enter a valid capacity in hours.', toast: true, position: 'top-end', timer: 2200, showConfirmButton: false });
        return;
    }
    await fetch('/Sprints/SaveCapacity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _capToken() },
        body: JSON.stringify({ sprintId: _capSprintId, ownerName: owner, capacityHours: pts })
    });
    ownerSel.value = '';
    ptsFld.value   = '';
    await _loadCapacity();
}
</script>
