@model List<TaskTracker.Models.Sprint>
@using System.Text.Json
@{
    ViewData["Title"] = "Sprints";
    var taskCounts       = ViewBag.TaskCounts       as Dictionary<int, int>     ?? new();
    var ownerNames       = ViewBag.OwnerNames       as List<string>             ?? new();
    var teamMemberNames  = ViewBag.TeamMemberNames  as List<string>             ?? new();
    var velocityPoints   = ViewBag.VelocityPoints   as Dictionary<int, decimal> ?? new();
    var spilloverCounts  = ViewBag.SpilloverCounts  as Dictionary<int, int>     ?? new();
    var actualHours      = ViewBag.ActualHours      as Dictionary<int, decimal> ?? new();
    var estimateHours    = ViewBag.EstimateHours    as Dictionary<int, decimal> ?? new();
    var sprintHours      = ViewBag.SprintHours      as Dictionary<int, decimal> ?? new();
    var jsonOpts       = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="space-y-5">
    <!-- Header -->
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Sprints</h1>
            <p>Plan and manage development sprints</p>
        </div>
        <button onclick="openSprintPanel(null)"
                class="btn-primary text-sm px-4 py-2 rounded-lg flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Sprint
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-16 text-center">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p class="text-gray-500 font-medium">No sprints yet</p>
            <p class="text-gray-400 text-sm mt-1">Create your first sprint to start planning work</p>
            <button onclick="openSprintPanel(null)" class="mt-4 btn-primary text-sm px-4 py-2 rounded-lg">Create Sprint</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var sprint in Model)
            {
                var cnt  = taskCounts.GetValueOrDefault(sprint.Id, 0);
                var sJson = System.Text.Json.JsonSerializer.Serialize(sprint,
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });

                <div class="bg-white border @(sprint.IsActive ? "border-blue-400 ring-2 ring-blue-100" : "border-gray-200") rounded-xl p-5 flex flex-col gap-4 relative group">
                    @if (sprint.IsActive)
                    {
                        <span class="absolute top-4 right-4 text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">Active</span>
                    }

                    <!-- Sprint name & dates -->
                    <div class="pr-16">
                        <h2 class="font-semibold text-gray-900 text-base leading-snug">@sprint.Name</h2>
                        @if (sprint.StartDate.HasValue || sprint.EndDate.HasValue)
                        {
                            <p class="text-xs text-gray-400 mt-0.5">
                                @(sprint.StartDate?.ToString("yyyy-MM-dd") ?? "—") → @(sprint.EndDate?.ToString("yyyy-MM-dd") ?? "—")
                            </p>
                        }
                    </div>

                    <!-- Goal -->
                    @if (!string.IsNullOrEmpty(sprint.Goal))
                    {
                        <p class="text-sm text-gray-600 line-clamp-2">@sprint.Goal</p>
                    }

                    <!-- Hours stats -->
                    @{
                        var actH  = actualHours.GetValueOrDefault(sprint.Id, 0);
                        var estH  = estimateHours.GetValueOrDefault(sprint.Id, 0);
                        var sprH  = sprintHours.GetValueOrDefault(sprint.Id, 0);
                        var hrPct = sprH > 0 ? (int)Math.Round((double)(actH / sprH) * 100) : 0;
                        string FmtH(decimal v) => v > 0 ? (v % 1 == 0 ? ((int)v).ToString() : v.ToString("0.#")) + "h" : "—";
                    }
                    <div class="grid grid-cols-3 gap-2 rounded-lg bg-gray-50 border border-gray-100 px-2 py-2">
                        <div class="flex flex-col items-center gap-0.5">
                            <span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">Estimate</span>
                            <span class="text-sm font-semibold text-gray-700">@FmtH(estH)</span>
                        </div>
                        <div class="flex flex-col items-center gap-0.5 border-x border-gray-200">
                            <span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">Actual</span>
                            <span class="text-sm font-semibold @(actH > 0 ? "text-blue-600" : "text-gray-700")">@FmtH(actH)</span>
                        </div>
                        <div class="flex flex-col items-center gap-0.5">
                            <span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">Sprint</span>
                            <span class="text-sm font-semibold text-gray-700">@FmtH(sprH)</span>
                        </div>
                    </div>
                    @if (sprH > 0 || actH > 0)
                    {
                        var barPct = Math.Min(hrPct, 100);
                        var barCls = hrPct >= 100 ? "bg-emerald-500" : hrPct >= 75 ? "bg-blue-500" : hrPct >= 40 ? "bg-amber-400" : "bg-gray-300";
                        var pctCls = hrPct >= 100 ? "text-emerald-600" : hrPct >= 75 ? "text-blue-600" : hrPct >= 40 ? "text-amber-600" : "text-gray-400";
                        <div class="flex items-center gap-2">
                            <div class="flex-1 bg-gray-100 rounded-full h-1.5 overflow-hidden">
                                <div class="@barCls h-1.5 rounded-full transition-all duration-500" style="width:@barPct%"></div>
                            </div>
                            <span class="text-[11px] font-semibold @pctCls shrink-0 w-10 text-right">@hrPct%</span>
                        </div>
                    }

                    <!-- Stats -->
                    <div class="flex items-center gap-3 text-xs text-gray-500">
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/>
                            </svg>
                            @cnt task@(cnt == 1 ? "" : "s")
                        </span>
                        @{
                            var vel = velocityPoints.GetValueOrDefault(sprint.Id, 0);
                        }
                        @if (vel > 0)
                        {
                            <span class="flex items-center gap-1 text-emerald-600 font-medium">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                                @vel.ToString("0.#") pts done
                            </span>
                        }
                        @if (spilloverCounts.TryGetValue(sprint.Id, out var spillover) && spillover > 0)
                        {
                            <span class="text-amber-600 font-medium">@spillover carried forward</span>
                        }
                        @if (!string.IsNullOrEmpty(sprint.CreatedBy))
                        {
                            <span>by @sprint.CreatedBy</span>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 pt-1 border-t border-gray-100">
                        <button onclick='openSprintPanel(@Html.Raw(sJson))'
                                class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 flex items-center justify-center gap-1.5 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Edit
                        </button>
                        @if (!sprint.IsActive)
                        {
                            <button onclick="setActive(@sprint.Id)"
                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-blue-200 text-blue-600 hover:bg-blue-50 flex items-center justify-center gap-1.5 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Set Active
                            </button>
                        }
                        else
                        {
                            <button onclick="completeSprint(@sprint.Id, '@Html.Raw(Html.Encode(sprint.Name))')"
                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg border border-green-200 text-green-600 hover:bg-green-50 flex items-center justify-center gap-1.5 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Complete Sprint
                            </button>
                        }
                        <button onclick="openCapacity(@sprint.Id)"
                                class="p-1.5 text-gray-400 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors"
                                title="Capacity Planning">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                        </button>
                        <button onclick="deleteSprint(@sprint.Id, @cnt)"
                                class="p-1.5 text-gray-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                                title="Delete sprint">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ═══ CAPACITY PLANNING MODAL ═══ -->
<div id="cap-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-start justify-center pt-12 px-4" style="display:none!important">
    <div class="bg-white rounded-2xl w-full max-w-3xl shadow-2xl max-h-[82vh] flex flex-col">
        <!-- Modal header -->
        <div class="flex items-start justify-between px-6 py-4 border-b border-gray-100 shrink-0">
            <div>
                <h3 id="cap-title" class="text-base font-semibold text-gray-900">Capacity Planning</h3>
                <p id="cap-subtitle" class="text-xs text-gray-400 mt-0.5"></p>
            </div>
            <button onclick="closeCapacity()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors -mt-1 -mr-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <!-- Modal body -->
        <div class="flex-1 overflow-y-auto px-6 py-4" id="cap-body">
            <div class="py-10 text-center text-gray-300 text-sm">Loading…</div>
        </div>
        <!-- Add member footer -->
        <div class="border-t border-gray-100 px-6 py-3 bg-gray-50 rounded-b-2xl shrink-0">
            <div class="flex items-center gap-2">
                <select id="cap-add-owner" class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 bg-white">
                    <option value="">Add team member…</option>
                </select>
                <input id="cap-add-pts" type="number" min="0" step="0.5" placeholder="Capacity (hours)"
                       class="w-36 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                <button onclick="addCapacityRow()"
                        class="px-4 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium transition-colors shrink-0">
                    Add
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ SPRINT SLIDE PANEL ═══ -->
<div id="sp-backdrop"
     class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
     onclick="closeSprintPanel()"></div>

<div id="sprint-panel"
     class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 shrink-0">
        <div>
            <h3 id="sp-title" class="text-lg font-semibold text-gray-900">New Sprint</h3>
            <p id="sp-subtitle" class="text-xs text-gray-400 hidden"></p>
        </div>
        <button onclick="closeSprintPanel()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Form -->
    <form id="sprint-form" class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" id="sp-id" name="Id" value="0" />

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Sprint Name <span class="text-red-500">*</span></label>
            <input id="sp-name" name="Name" type="text" required placeholder="e.g. Sprint 1 — Login Flow"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Start Date</label>
                <input id="sp-start" name="StartDate" type="date"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">End Date</label>
                <input id="sp-end" name="EndDate" type="date"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Sprint Goal</label>
            <textarea id="sp-goal" name="Goal" rows="3" placeholder="What should this sprint achieve?"
                      class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
        </div>

        <!-- ── Sprint Capacity ── -->
        <div class="border-t border-gray-100 pt-4">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm font-semibold text-gray-700">Sprint Capacity</p>
                    <p class="text-xs text-gray-400 mt-0.5">Working days × 8h = sprint hours per member</p>
                </div>
                <span id="sp-cap-total" class="text-sm font-bold text-blue-600"></span>
            </div>

            <!-- Team member rows -->
            <div class="rounded-lg border border-gray-100 overflow-hidden mb-3">
                <div class="grid grid-cols-[1fr_80px_72px] bg-gray-50 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-gray-400">
                    <span>Member</span>
                    <span class="text-center">Work Days</span>
                    <span class="text-right">Hours</span>
                </div>
                <div id="sp-cap-rows"></div>
            </div>

            <!-- Guest members (not in team) -->
            <div id="sp-guest-section">
                <button type="button" onclick="toggleGuestPanel()"
                        class="flex items-center gap-1.5 text-xs text-purple-600 hover:text-purple-700 font-medium">
                    <svg id="sp-guest-chevron" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add member outside team
                </button>
                <div id="sp-guest-panel" class="hidden mt-2 space-y-2">
                    <div class="flex items-center gap-2">
                        <select id="sp-guest-name" class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400 bg-white">
                            <option value="">Select user…</option>
                        </select>
                        <input id="sp-guest-days" type="number" min="0" max="99" step="1" placeholder="Days"
                               class="w-20 border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-purple-400">
                        <button type="button" onclick="addGuestRow()"
                                class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-xs font-medium shrink-0">Add</button>
                    </div>
                    <div id="sp-guest-rows" class="space-y-1"></div>
                </div>
            </div>
        </div>
    </form>

    <!-- Footer -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50 shrink-0">
        <button type="button" onclick="closeSprintPanel()"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
        <button type="button" onclick="saveSprint()"
                class="px-5 py-2 text-sm btn-primary rounded-lg flex items-center gap-2">
            <span id="sp-save-label">Create Sprint</span>
            <svg id="sp-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
            </svg>
        </button>
    </div>
</div>

<script>
const spBackdrop = document.getElementById('sp-backdrop');
const spPanel    = document.getElementById('sprint-panel');

const TEAM_MEMBERS  = @Html.Raw(JsonSerializer.Serialize(teamMemberNames, jsonOpts));
const ALL_USERS     = @Html.Raw(JsonSerializer.Serialize(ownerNames, jsonOpts));

// capacity state: { displayName -> workingDays }
let _spCapacity = {};   // team members
let _spGuests   = [];   // [{ name, days }]

function _capHours(days) { return (days || 0) * 8; }

function _renderSpCapRows() {
    const rows = document.getElementById('sp-cap-rows');
    if (!rows) return;
    rows.innerHTML = (TEAM_MEMBERS || []).map(name => {
        const days = _spCapacity[name] ?? '';
        const hrs  = days !== '' ? _capHours(Number(days)) + 'h' : '—';
        return `<div class="grid grid-cols-[1fr_80px_72px] items-center px-3 py-2 border-t border-gray-50" data-member="${name}">
            <span class="text-xs font-medium text-gray-700 truncate" title="${name}">${name}</span>
            <input type="number" min="0" max="99" step="1" value="${days}" placeholder="—"
                   class="mx-auto w-16 text-center text-xs border border-gray-200 rounded px-1 py-0.5 focus:outline-none focus:ring-1 focus:ring-blue-400"
                   oninput="onDaysInput('${name}', this.value)"
                   onkeydown="if(event.key==='Enter')this.blur()">
            <span id="sp-hrs-${name.replace(/\s+/g,'_')}" class="text-right text-xs font-semibold ${days > 0 ? 'text-blue-600' : 'text-gray-300'}">${hrs}</span>
        </div>`;
    }).join('');
    _updateTotal();
}

function onDaysInput(name, val) {
    const days = val === '' ? '' : Math.max(0, Number(val));
    _spCapacity[name] = days;
    const spanId = 'sp-hrs-' + name.replace(/\s+/g,'_');
    const span   = document.getElementById(spanId);
    if (span) {
        const hrs = days !== '' && days > 0 ? _capHours(days) + 'h' : '—';
        span.textContent  = hrs;
        span.className    = 'text-right text-xs font-semibold ' + (days > 0 ? 'text-blue-600' : 'text-gray-300');
    }
    _updateTotal();
}

function _updateTotal() {
    let total = 0;
    (TEAM_MEMBERS || []).forEach(n => { total += _capHours(Number(_spCapacity[n] ?? 0)); });
    (_spGuests || []).forEach(g => { total += _capHours(Number(g.days)); });
    const el = document.getElementById('sp-cap-total');
    if (el) el.textContent = total > 0 ? 'Total: ' + total + 'h' : '';
}

function _renderGuestRows() {
    const container = document.getElementById('sp-guest-rows');
    container.innerHTML = _spGuests.map((g, i) =>
        `<div class="flex items-center gap-2 rounded-lg bg-purple-50 border border-purple-100 px-3 py-1.5 text-xs">
            <span class="flex-1 font-medium text-gray-700">${g.name}</span>
            <span class="text-gray-500">${g.days} day${g.days != 1 ? 's' : ''}</span>
            <span class="font-semibold text-purple-600">${_capHours(g.days)}h</span>
            <button type="button" onclick="removeGuest(${i})" class="text-gray-300 hover:text-red-400 ml-1">✕</button>
        </div>`
    ).join('');
    _updateGuestSelect();
    _updateTotal();
}

function _updateGuestSelect() {
    const taken = new Set([...(TEAM_MEMBERS || []).map(n => n.toLowerCase()), ...(_spGuests || []).map(g => g.name.toLowerCase())]);
    const sel   = document.getElementById('sp-guest-name');
    sel.innerHTML = '<option value="">Select user…</option>'
        + ALL_USERS.filter(n => !taken.has(n.toLowerCase()))
            .map(n => `<option value="${n}">${n}</option>`).join('');
}

function addGuestRow() {
    const name = document.getElementById('sp-guest-name').value.trim();
    const days = parseInt(document.getElementById('sp-guest-days').value, 10);
    if (!name) { Swal.fire({ icon:'warning', toast:true, position:'top-end', timer:2000, showConfirmButton:false, text:'Select a user.' }); return; }
    if (isNaN(days) || days < 1) { Swal.fire({ icon:'warning', toast:true, position:'top-end', timer:2000, showConfirmButton:false, text:'Enter working days ≥ 1.' }); return; }
    _spGuests.push({ name, days });
    document.getElementById('sp-guest-days').value = '';
    _renderGuestRows();
}

function removeGuest(i) {
    _spGuests.splice(i, 1);
    _renderGuestRows();
}

function toggleGuestPanel() {
    const panel   = document.getElementById('sp-guest-panel');
    const chevron = document.getElementById('sp-guest-chevron');
    const hidden  = panel.classList.toggle('hidden');
    chevron.style.transform = hidden ? '' : 'rotate(45deg)';
    if (!hidden) _updateGuestSelect();
}

async function openSprintPanel(sprint) {
    document.getElementById('sp-id').value    = sprint?.id    ?? 0;
    document.getElementById('sp-name').value  = sprint?.name  ?? '';
    document.getElementById('sp-start').value = sprint?.startDate ?? '';
    document.getElementById('sp-end').value   = sprint?.endDate   ?? '';
    document.getElementById('sp-goal').value  = sprint?.goal      ?? '';
    document.getElementById('sp-title').textContent      = sprint ? 'Edit Sprint' : 'New Sprint';
    document.getElementById('sp-save-label').textContent = sprint ? 'Save Changes' : 'Create Sprint';
    const sub = document.getElementById('sp-subtitle');
    if (sprint) { sub.textContent = 'Sprint #' + sprint.id; sub.classList.remove('hidden'); }
    else        { sub.classList.add('hidden'); }

    // reset capacity state
    _spCapacity = {};
    _spGuests   = [];
    const guestPanel = document.getElementById('sp-guest-panel');
    if (guestPanel && !guestPanel.classList.contains('hidden')) toggleGuestPanel();
    _renderSpCapRows();

    // for existing sprints, pre-fill working days from saved capacity
    if (sprint?.id) {
        try {
            const r = await fetch('/Sprints/GetCapacity?sprintId=' + sprint.id);
            if (r.ok) {
                const cap     = await r.json();
                const members = TEAM_MEMBERS || [];
                const teamSet = new Set(members.map(n => n.toLowerCase()));
                (cap.rows || []).forEach(row => {
                    if (!row.capacityHours) return;
                    const days = Math.round(row.capacityHours / 8);
                    if (teamSet.has(row.ownerName.toLowerCase())) {
                        const canonical = members.find(n => n.toLowerCase() === row.ownerName.toLowerCase());
                        if (canonical) _spCapacity[canonical] = days || '';
                    } else {
                        _spGuests.push({ name: row.ownerName, days });
                    }
                });
                _renderSpCapRows();
                if (_spGuests.length) { toggleGuestPanel(); _renderGuestRows(); }
            }
        } catch {}
    }

    spBackdrop.classList.remove('opacity-0', 'pointer-events-none');
    spBackdrop.classList.add('opacity-100');
    spPanel.classList.remove('translate-x-full');
    document.getElementById('sp-name').focus();
}

function closeSprintPanel() {
    spBackdrop.classList.add('opacity-0', 'pointer-events-none');
    spBackdrop.classList.remove('opacity-100');
    spPanel.classList.add('translate-x-full');
}

async function saveSprint() {
    const form = document.getElementById('sprint-form');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = document.querySelector('#sprint-panel button[onclick="saveSprint()"]');
    const sp  = document.getElementById('sp-spinner');
    btn.disabled = true; sp.classList.remove('hidden');
    try {
        const r = await fetch('/Sprints/Save', { method: 'POST', body: new FormData(form) });
        if (!r.ok) {
            const d = await r.json().catch(() => ({}));
            Swal.fire({ icon: 'error', title: 'Error', text: d.message || 'Failed to save sprint.' });
            return;
        }
        const d        = await r.json();
        const sprintId = d.id;
        const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // save capacity for each member with days set
        const entries = [
            ...TEAM_MEMBERS
                .filter(n => _spCapacity[n] !== '' && Number(_spCapacity[n]) > 0)
                .map(n => ({ name: n, hours: _capHours(Number(_spCapacity[n])) })),
            ..._spGuests.map(g => ({ name: g.name, hours: _capHours(g.days) }))
        ];
        await Promise.all(entries.map(e =>
            fetch('/Sprints/SaveCapacity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ sprintId, ownerName: e.name, capacityHours: e.hours })
            })
        ));

        location.reload();
    } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.' });
    } finally {
        btn.disabled = false; sp.classList.add('hidden');
    }
}

async function setActive(id) {
    const r = await fetch('/Sprints/SetActive/' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
}

async function deactivateSprint() {
    const r = await fetch('/Sprints/Deactivate', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
}

// All sprints (for the "move unfinished items to…" picker)
const SPRINT_LIST = [
    @foreach (var s in Model) { @Html.Raw($"{{ id: {s.Id}, name: '{Html.Encode(s.Name).Replace("'", "\\'")}', active: {s.IsActive.ToString().ToLower()} }},") }
];

async function completeSprint(id, name) {
    // How many unfinished items are in this sprint?
    let info = { total: 0, incomplete: 0, done: 0 };
    try {
        const r = await fetch('/Sprints/GetIncomplete?sprintId=' + id);
        info = await r.json();
    } catch {}

    const others = SPRINT_LIST.filter(s => s.id !== id);
    const options = '<option value="backlog">← Backlog</option>' +
        others.map(s => `<option value="${s.id}">${s.name}</option>`).join('');

    const html = info.incomplete > 0
        ? `<p class="text-sm text-gray-600 mb-3">${info.done} of ${info.total} item(s) are complete.<br>
             <b>${info.incomplete} unfinished item(s)</b> — where should they go?</p>
           <select id="swal-moveto" class="swal2-select" style="width:80%;font-size:14px">${options}</select>`
        : `<p class="text-sm text-gray-600">All ${info.total} item(s) are complete. 🎉</p>`;

    const res = await Swal.fire({
        icon: 'question',
        title: `Complete "${name}"?`,
        html: html,
        showCancelButton: true,
        confirmButtonText: 'Complete Sprint',
        confirmButtonColor: '#16a34a',
        preConfirm: () => document.getElementById('swal-moveto')?.value ?? 'backlog'
    });
    if (!res.isConfirmed) return;

    const fd = new FormData();
    fd.append('id', id);
    fd.append('moveTo', res.value);
    fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');
    const r2 = await fetch('/Sprints/Complete', { method: 'POST', body: fd });
    const d  = await r2.json();
    if (d.success) {
        await Swal.fire({ icon: 'success', title: 'Sprint completed',
            text: d.moved > 0 ? `${d.moved} unfinished item(s) moved to ${d.movedTo === 'backlog' ? 'the Backlog' : 'the selected sprint'}.` : 'All items were complete.',
            timer: 2500, showConfirmButton: false });
        location.reload();
    } else {
        Swal.fire({ icon: 'error', text: d.message || 'Could not complete sprint.' });
    }
}

async function deleteSprint(id, taskCount) {
    if (taskCount > 0) {
        Swal.fire({ icon: 'warning', title: 'Cannot Delete', text: `This sprint has ${taskCount} task(s). Move or unassign them first.` });
        return;
    }
    const confirm = await Swal.fire({
        icon: 'warning', title: 'Delete Sprint?', text: 'This cannot be undone.',
        showCancelButton: true, confirmButtonText: 'Delete', confirmButtonColor: '#ef4444'
    });
    if (!confirm.isConfirmed) return;
    const r = await fetch('/Sprints/Delete/' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
    if (r.ok) location.reload();
    else {
        const d = await r.json().catch(() => ({}));
        Swal.fire({ icon: 'error', title: 'Error', text: d.message || 'Failed to delete.' });
    }
}

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeSprintPanel(); closeCapacity(); }
});

// ── Capacity Planning ──────────────────────────────────────────────────────────
const CAP_OWNERS = @Html.Raw(JsonSerializer.Serialize(ownerNames, jsonOpts));

let _capSprintId = null;

function _capToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}

function _capEsc(s) {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function openCapacity(sprintId) {
    _capSprintId = sprintId;
    const modal  = document.getElementById('cap-modal');
    modal.style.removeProperty('display');
    modal.classList.remove('hidden');
    modal.style.display = 'flex';
    _loadCapacity();
}

function closeCapacity() {
    const modal = document.getElementById('cap-modal');
    modal.style.display = 'none';
    _capSprintId = null;
}

async function _loadCapacity() {
    document.getElementById('cap-body').innerHTML =
        '<div class="py-10 text-center text-gray-300 text-sm">Loading…</div>';
    const r = await fetch('/Sprints/GetCapacity?sprintId=' + _capSprintId);
    if (!r.ok) {
        document.getElementById('cap-body').innerHTML =
            '<div class="py-6 text-center text-red-400 text-sm">Failed to load capacity data.</div>';
        return;
    }
    const data = await r.json();
    document.getElementById('cap-title').textContent = 'Capacity — ' + data.sprintName;
    const dates = [data.startDate, data.endDate].filter(Boolean).join(' → ');
    document.getElementById('cap-subtitle').textContent = dates;

    // Populate "add member" select (skip owners already shown)
    const present = new Set((data.rows || []).map(r => r.ownerName.toLowerCase()));
    const addSel  = document.getElementById('cap-add-owner');
    addSel.innerHTML = '<option value="">Add team member…</option>'
        + CAP_OWNERS
            .filter(n => n && !present.has(n.toLowerCase()))
            .map(n => '<option value="' + _capEsc(n) + '">' + _capEsc(n) + '</option>')
            .join('');

    _renderCapRows(data.rows || [], data.totalCapacity, data.totalAllocated, data.totalActualHours || 0);
}

function _renderCapRows(rows, totalCap, totalAlloc, totalActual) {
    const body = document.getElementById('cap-body');
    if (!rows.length) {
        body.innerHTML =
            '<div class="py-10 text-center text-gray-400 text-sm">No tasks assigned in this sprint yet.</div>';
        return;
    }

    const totalTasks  = rows.reduce((s, r) => s + r.taskCount,  0);
    const totalDone   = rows.reduce((s, r) => s + r.doneCount,  0);
    const totalPct    = totalTasks > 0 ? Math.round(totalDone / totalTasks * 100) : 0;
    const totalHrsPct = totalCap > 0   ? Math.round((totalActual || 0) / totalCap * 100) : 0;

    function _fmtH(val) { return val > 0 ? val.toFixed(1).replace(/\.0$/, '') + 'h' : '—'; }

    const tableRows = rows.map(row => {
        const pct    = row.completionPct;
        const barW   = Math.min(pct, 100);
        const barCls = pct === 100 ? 'bg-emerald-500'
                     : pct >= 75   ? 'bg-blue-500'
                     : pct >= 40   ? 'bg-amber-400'
                                   : 'bg-gray-300';
        const pillCls = pct === 100 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                      : pct >= 75   ? 'bg-blue-50 text-blue-700 border border-blue-200'
                      : pct >= 40   ? 'bg-amber-50 text-amber-700 border border-amber-200'
                                    : 'bg-gray-100 text-gray-500';
        const hPct     = row.hoursCompletionPct || 0;
        const hPillCls = hPct >= 100 ? 'text-emerald-600' : hPct >= 75 ? 'text-blue-600' : hPct >= 40 ? 'text-amber-600' : 'text-gray-400';
        const capVal   = row.capacityHours != null ? row.capacityHours : '';
        const ownEsc   = _capEsc(row.ownerName);

        return '<tr class="border-b border-gray-50 hover:bg-gray-50/60">'
            + '<td class="py-2 pr-3 text-sm font-medium text-gray-800">' + ownEsc + '</td>'
            + '<td class="py-2 pr-3 text-center text-sm text-gray-700">' + row.taskCount + '</td>'
            + '<td class="py-2 pr-3 text-center text-sm font-medium ' + (row.doneCount > 0 ? 'text-emerald-600' : 'text-gray-300') + '">' + row.doneCount + '</td>'
            + '<td class="py-2 pr-3 text-center">'
            +   '<span class="text-xs text-gray-500">' + _fmtH(row.allocatedHours) + '</span>'
            + '</td>'
            + '<td class="py-2 pr-3 text-center">'
            +   '<span class="text-xs font-medium text-blue-600">' + _fmtH(row.actualHours) + '</span>'
            + '</td>'
            + '<td class="py-2 pr-3 text-center">'
            +   '<input type="number" min="0" step="0.5" value="' + capVal + '" placeholder="—"'
            +     ' data-owner="' + ownEsc + '"'
            +     ' class="w-16 text-center text-xs border border-gray-200 rounded px-1 py-0.5 focus:outline-none focus:ring-1 focus:ring-purple-400 bg-white"'
            +     ' onchange="saveCapacityRow(this.dataset.owner, this.value)"'
            +     ' onkeydown="if(event.key===\'Enter\')this.blur()"'
            +     ' title="Sprint capacity hours — click to edit">'
            + '</td>'
            + '<td class="py-2 pr-4 text-center">'
            +   '<span class="text-xs font-semibold ' + hPillCls + '">' + (row.capacityHours != null || row.allocatedHours ? hPct + '%' : '—') + '</span>'
            + '</td>'
            + '<td class="py-2 min-w-[130px]">'
            +   '<div class="flex items-center gap-2">'
            +     '<div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">'
            +       '<div class="' + barCls + ' h-2 rounded-full transition-all duration-500" style="width:' + barW + '%"></div>'
            +     '</div>'
            +     '<span class="text-xs font-semibold px-1.5 py-0.5 rounded-full w-12 text-center shrink-0 ' + pillCls + '">' + pct + '%</span>'
            +   '</div>'
            + '</td>'
            + '</tr>';
    }).join('');

    const totalBarW   = Math.min(totalPct, 100);
    const totalBarCls = totalPct === 100 ? 'bg-emerald-500' : totalPct >= 75 ? 'bg-blue-500' : totalPct >= 40 ? 'bg-amber-400' : 'bg-gray-300';
    const hPillClsTotal = totalHrsPct >= 100 ? 'text-emerald-600' : totalHrsPct >= 75 ? 'text-blue-600' : totalHrsPct >= 40 ? 'text-amber-600' : 'text-gray-500';
    const footer =
        '<tr class="border-t-2 border-gray-200 bg-gray-50/80">'
        + '<td class="py-3 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</td>'
        + '<td class="py-3 pr-3 text-center text-sm font-semibold text-gray-700">' + totalTasks + '</td>'
        + '<td class="py-3 pr-3 text-center text-sm font-semibold text-emerald-600">' + totalDone + '</td>'
        + '<td class="py-3 pr-3 text-center text-xs text-gray-500">' + _fmtH(totalAlloc) + '</td>'
        + '<td class="py-3 pr-3 text-center text-xs font-semibold text-blue-600">' + _fmtH(totalActual || 0) + '</td>'
        + '<td class="py-3 pr-3 text-center text-xs font-semibold text-gray-700">' + _fmtH(totalCap) + '</td>'
        + '<td class="py-3 pr-4 text-center text-xs font-bold ' + hPillClsTotal + '">' + (totalCap > 0 || totalAlloc > 0 ? totalHrsPct + '%' : '—') + '</td>'
        + '<td class="py-3">'
        +   '<div class="flex items-center gap-2">'
        +     '<div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">'
        +       '<div class="' + totalBarCls + ' h-2 rounded-full transition-all duration-500" style="width:' + totalBarW + '%"></div>'
        +     '</div>'
        +     '<span class="text-xs font-bold text-gray-700 w-12 text-center shrink-0">' + totalPct + '%</span>'
        +   '</div>'
        + '</td>'
        + '</tr>';

    body.innerHTML =
        '<table class="w-full text-sm">'
        + '<thead><tr class="text-left border-b border-gray-100">'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Member</th>'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Tasks</th>'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Done</th>'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Estimate</th>'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Actual</th>'
        +   '<th class="pb-2.5 pr-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Sprint</th>'
        +   '<th class="pb-2.5 pr-4 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Hrs %</th>'
        +   '<th class="pb-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wide">Completion</th>'
        + '</tr></thead>'
        + '<tbody>' + tableRows + '</tbody>'
        + '<tfoot>' + footer + '</tfoot>'
        + '</table>';
}

async function saveCapacityRow(ownerName, hoursStr) {
    const pts = parseFloat(hoursStr);
    if (isNaN(pts) || pts < 0) return;
    await fetch('/Sprints/SaveCapacity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _capToken() },
        body: JSON.stringify({ sprintId: _capSprintId, ownerName, capacityHours: pts })
    });
    await _loadCapacity();
}

async function addCapacityRow() {
    const ownerSel = document.getElementById('cap-add-owner');
    const ptsFld   = document.getElementById('cap-add-pts');
    const owner    = ownerSel.value.trim();
    const pts      = parseFloat(ptsFld.value);
    if (!owner) {
        Swal.fire({ icon: 'warning', text: 'Select a team member.', toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
        return;
    }
    if (isNaN(pts) || pts < 0) {
        Swal.fire({ icon: 'warning', text: 'Enter a valid capacity in hours.', toast: true, position: 'top-end', timer: 2200, showConfirmButton: false });
        return;
    }
    await fetch('/Sprints/SaveCapacity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _capToken() },
        body: JSON.stringify({ sprintId: _capSprintId, ownerName: owner, capacityHours: pts })
    });
    ownerSel.value = '';
    ptsFld.value   = '';
    await _loadCapacity();
}
</script>
