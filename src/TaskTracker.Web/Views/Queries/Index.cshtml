@model List<TaskTracker.Models.SavedQuery>
@using System.Text.Json
@{
    ViewData["Title"] = "Saved Queries";
    var me      = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var isAdmin = User.IsInRole("Admin");
}

<div class="space-y-4">
    <div class="page-hd">
        <div class="page-hd-left">
            <h1>Saved Queries</h1>
            <p>@Model.Count saved quer@(Model.Count != 1 ? "ies" : "y")</p>
        </div>
        <a href="/Tasks" class="inline-flex items-center gap-2 btn-primary text-sm px-4 py-1.5 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
            </svg>
            Go to Tasks
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-16 text-center">
            <svg class="w-12 h-12 mx-auto text-gray-200 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            <p class="text-gray-500 text-sm font-medium">No saved queries yet</p>
            <p class="text-gray-400 text-xs mt-1">Use the <strong>Save as Query</strong> button on the Tasks page to save your current filters.</p>
            <a href="/Tasks" class="mt-4 inline-flex items-center gap-1.5 text-sm text-blue-600 hover:underline font-medium">
                Go to Tasks →
            </a>
        </div>
    }
    else
    {
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var q in Model)
            {
                Dictionary<string, string> filters;
                try   { filters = JsonSerializer.Deserialize<Dictionary<string, string>>(q.Filters) ?? new(); }
                catch { filters = new(); }

                var chipDefs = new[] {
                    ("Search",   filters.GetValueOrDefault("search",   "")),
                    ("Project",  filters.GetValueOrDefault("project",  "")),
                    ("Assignee", filters.GetValueOrDefault("owner",    "")),
                    ("Status",   filters.GetValueOrDefault("status",   "")),
                    ("Priority", filters.GetValueOrDefault("priority", "")),
                    ("From",     filters.GetValueOrDefault("dateFrom", "")),
                    ("To",       filters.GetValueOrDefault("dateTo",   "")),
                    ("View",     filters.GetValueOrDefault("view",     "table")),
                };
                var activeChips = chipDefs.Where(c => !string.IsNullOrWhiteSpace(c.Item2)).ToList();
                var canDelete   = q.CreatedBy == me || isAdmin;
                var canShare    = q.CreatedBy == me || isAdmin;

                <div class="bg-white border border-gray-200 rounded-xl p-4 flex flex-col gap-3 hover:shadow-sm transition-shadow">
                    <!-- Title row -->
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="text-sm font-semibold text-gray-900 truncate">@q.Name</h3>
                                @if (q.IsShared)
                                {
                                    <span class="inline-flex items-center gap-0.5 text-[10px] px-1.5 py-0.5 rounded-full bg-green-50 text-green-600 border border-green-100 shrink-0">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </svg>
                                        Shared
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(q.Description))
                            {
                                <p class="text-xs text-gray-500 mt-0.5 line-clamp-2">@q.Description</p>
                            }
                        </div>
                    </div>

                    <!-- Filter chips -->
                    @if (activeChips.Any())
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var (label, value) in activeChips)
                            {
                                <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                                    <span class="font-medium text-blue-400">@label:</span>@value
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-[11px] text-gray-300 italic">No filters — shows all tasks</p>
                    }

                    <!-- Footer: meta + actions -->
                    <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-50">
                        <span class="text-[11px] text-gray-400">
                            by @(q.CreatedBy ?? "—") · @q.CreatedAt.ToString("dd MMM yyyy")
                        </span>
                        <div class="flex items-center gap-1.5">
                            @if (canShare)
                            {
                                <button class="text-[11px] px-2 py-1 rounded transition-colors sq-share-btn @(q.IsShared ? "text-green-600 hover:text-green-800 hover:bg-green-50" : "text-gray-400 hover:text-green-600 hover:bg-green-50")"
                                        data-id="@q.Id" data-shared="@q.IsShared.ToString().ToLower()"
                                        title="@(q.IsShared ? "Make private" : "Share with team")">
                                    @(q.IsShared ? "Unshare" : "Share")
                                </button>
                            }
                            @if (canDelete)
                            {
                                <button class="text-[11px] text-gray-400 hover:text-red-500 px-2 py-1 rounded hover:bg-red-50 transition-colors sq-del-btn"
                                        data-id="@q.Id" data-name="@q.Name">
                                    Delete
                                </button>
                            }
                            <a href="/Queries/Run/@q.Id"
                               class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Run
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<form id="sq-delete-form" method="post" style="display:none">@Html.AntiForgeryToken()</form>

<script>
document.querySelectorAll('.sq-del-btn').forEach(btn => {
    btn.addEventListener('click', () => deleteQuery(btn.dataset.id, btn.dataset.name));
});
document.querySelectorAll('.sq-share-btn').forEach(btn => {
    btn.addEventListener('click', () => toggleShare(btn));
});

async function toggleShare(btn) {
    const id     = btn.dataset.id;
    const shared = btn.dataset.shared === 'true';
    const token  = document.querySelector('#sq-delete-form input[name="__RequestVerificationToken"]').value;
    const fd     = new FormData();
    fd.append('__RequestVerificationToken', token);
    const r = await fetch('/Queries/ToggleShare/' + id, { method: 'POST', body: fd });
    const d = await r.json();
    if (d.success) location.reload();
    else Swal.fire({ icon: 'error', text: d.error || 'Could not update query.' });
}

async function deleteQuery(id, name) {
    const { isConfirmed } = await Swal.fire({
        title: 'Delete query?',
        html: `<span class="font-medium">${name}</span> will be permanently removed.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        confirmButtonColor: '#ef4444',
        cancelButtonText: 'Cancel'
    });
    if (!isConfirmed) return;
    const fd = new FormData();
    fd.append('__RequestVerificationToken',
        document.querySelector('#sq-delete-form input[name="__RequestVerificationToken"]').value);
    const r = await fetch('/Queries/Delete/' + id, { method: 'POST', body: fd });
    const d = await r.json();
    if (d.success) {
        Swal.fire({ icon: 'success', text: 'Query deleted.', timer: 1500, showConfirmButton: false })
            .then(() => location.reload());
    } else {
        Swal.fire({ icon: 'error', text: d.error || 'Could not delete query.' });
    }
}
</script>
