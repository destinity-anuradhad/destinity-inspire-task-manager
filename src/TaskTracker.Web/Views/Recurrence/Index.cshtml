@model List<TaskTracker.Models.RecurringTaskDefinition>
@{
    ViewData["Title"] = "Recurring Work";
    var templates = ViewBag.Templates as List<TaskTracker.Models.TaskTemplate> ?? [];
    var members = ViewBag.Members as List<TaskTracker.Models.AppUser> ?? [];
    var canManage = User.IsInRole("Admin") || User.FindFirst("TeamRole")?.Value == "TeamAdmin";
    var templateNames = templates.ToDictionary(t => t.Id, t => t.Name);
    var memberNames = members.ToDictionary(m => m.Id, m => m.DisplayName);
}
<div class="max-w-6xl mx-auto space-y-5">
    <div class="page-hd"><div class="page-hd-left"><h1>Recurring Work</h1><p>Create reliable scheduled tasks from team templates</p></div></div>
    @if (TempData["Success"] != null) { <p class="text-sm text-green-700">@TempData["Success"]</p> }
    @if (TempData["Error"] != null) { <p class="text-sm text-red-700">@TempData["Error"]</p> }
    @if (canManage)
    {
        <form method="post" action="/Recurrence/Create" class="bg-white border border-gray-200 rounded-xl p-5 grid grid-cols-1 md:grid-cols-3 gap-4">@Html.AntiForgeryToken()
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Task title</label><input name="goal" required maxlength="500" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Template</label><select name="taskTemplateId" required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"><option value="">Select template</option>@foreach (var template in templates) { <option value="@template.Id">@template.Name</option> }</select></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Owner</label><select name="ownerUserId" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"><option value="">Unassigned</option>@foreach (var member in members) { <option value="@member.Id">@member.DisplayName</option> }</select></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Frequency</label><select name="frequency" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"><option>Weekly</option><option>Monthly</option></select></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">First run</label><input type="datetime-local" name="nextRunAt" required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-500 mb-1">End date <span class="text-gray-400">(optional)</span></label><input type="date" name="endsAt" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm" /></div>
            <div><button class="btn-primary text-sm px-5 py-2 rounded-lg">Create Schedule</button></div>
        </form>
    }
    <div class="bg-white border border-gray-200 rounded-xl overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-gray-50 text-left text-xs text-gray-500"><tr><th class="px-4 py-3">Task</th><th class="px-4 py-3">Template</th><th class="px-4 py-3">Owner</th><th class="px-4 py-3">Schedule</th><th class="px-4 py-3">State</th><th class="px-4 py-3"></th></tr></thead><tbody class="divide-y divide-gray-100">@foreach (var definition in Model) { <tr><td class="px-4 py-3 font-medium text-gray-800">@definition.Goal</td><td class="px-4 py-3 text-gray-600">@(templateNames.GetValueOrDefault(definition.TaskTemplateId, "Unavailable template"))</td><td class="px-4 py-3 text-gray-600">@(definition.OwnerUserId.HasValue ? memberNames.GetValueOrDefault(definition.OwnerUserId.Value, "Former member") : "Unassigned")</td><td class="px-4 py-3 text-gray-600">@definition.Frequency · @definition.NextRunAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td><td class="px-4 py-3"><span class="text-xs font-semibold @(definition.IsActive ? "text-green-700" : "text-gray-500")">@(definition.IsActive ? "Active" : "Paused")</span></td><td class="px-4 py-3">@if (canManage) { <form method="post" action="/Recurrence/Toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@definition.Id" /><input type="hidden" name="isActive" value="@(!definition.IsActive)" /><button class="text-xs font-semibold text-blue-700">@(definition.IsActive ? "Pause" : "Resume")</button></form> }</td></tr> }</tbody></table></div>
    @if (Model.Count == 0) { <p class="text-sm text-gray-500">No recurring work definitions for this team.</p> }
</div>
