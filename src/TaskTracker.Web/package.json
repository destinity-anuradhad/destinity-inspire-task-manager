{
  "name": "tasktracker-web",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./wwwroot/css/app.src.css -o ./wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./wwwroot/css/app.src.css -o ./wwwroot/css/app.css --watch",
    "img:optimize": "sharp -f webp -q 82 -i ./wwwroot/assets/img/destinity-inspire-full.png -o ./wwwroot/assets/img/destinity-inspire-full.webp"
  },
  "devDependencies": {
    "sharp-cli": "^4.2.0",
    "tailwindcss": "^3.4.19"
  }
}
